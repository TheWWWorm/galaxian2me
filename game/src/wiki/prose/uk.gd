		[0, "", "[[station/79]] — станція в системі [[system/15]] і резиденція її командира, капітана [[character/3]].", false],
		[10, "", "Торговець ([[character/2]]) відправляє сюди героя ([[character/0]]) на зустріч із капітаном [[character/3]], людиною, яка може допомогти йому дістатися теранського простору ([[step/9]]).", false],
		[11, "", "Капітан [[character/3]] розповідає про [[faction/3|Конфедерацію Mido]] і в обмін на допомогу просить перевірити станцію [[station/76]].", false],
		[13, "", "Після доповіді про станцію [[station/76]] капітан [[character/3]] обіцяє звести його з теранським конвоєм, що має прибути на станцію.", false],
		[15, "", "Коли конвой прибуває ([[step/14]]), його екіпаж приймає героя ([[character/0]]) за пірата, знерухомлює його корабель і забирає на борт.", false],
	],
	"station/8": [
		[0, "", "[[station/8]] — теранська станція в прихованій системі [[system/1]]. На її космодромі нівеліанський агент [[agent/1]] продає креслення.", false],
	],
	"station/84": [
		[0, "", "[[station/84]] — теранська станція в системі [[system/16]]. На її космодромі агент [[agent/8]] із раси Vossk продає креслення броні Vossk.", false],
	],
	"station/88": [
		[0, "", "[[station/88]] — невелика нівеліанська станція в системі [[system/17]]. На її космодромі агент [[agent/15]] із раси Vossk продає координати системи [[system/21]].", false],
	],
	"station/90": [
		[0, "", "Біля станції [[station/90]] стоять стрибкові ворота системи [[system/18]]. На її космодромі агент [[agent/9]] продає креслення вантажного компресора.", false],
	],
	"station/91": [
		[28, "", "Біля станції [[station/91]] повідомляють про активність Void ([[step/28]]). Тут [[character/0]] з боєм пробивається до часового тунелю, щоб доставити зонд до корабля-матки Void.", false],
		[31, "", "Повернувшись із сектора Void, [[character/0]] отримує тут виклик від персонажа [[character/1]] із запрошенням на станцію [[station/98]].", false],
	],
	"station/98": [
		[15, "", "[[station/98]] — теранська станція в системі [[system/19]]. Крейсер, що заарештував героя ([[character/0]]), доправляє його сюди, і тут він бачить, що керує всім його давній друг [[character/1]].", false],
		[16, "", "Під час їхньої розмови станцію атакують винищувачі Void, і [[character/0]] допомагає їх відбити.", false],
		[18, "", "[[character/1]] розповідає йому про Void і вербує для Deep Science.", false],
		[32, "", "[[character/1]] встановлює на корабель героя ([[character/0]]) систему раннього попередження й розповідає йому про персонажа [[character/20]] ([[step/31]]).", false],
		[44, "", "Після перемоги [[character/0]] і [[character/1]] святкують на станції, і до них приєднується [[character/6]].", false],
		[45, "", "Наступного ранку науковиці ([[character/6]]) вже немає: вона лишила записку й останню виплату від Deep Science.", false],
	],
	"step/0": [
		[0, "", "[[character/0]] переслідує банду [[faction/8|піратів]] у поясі астероїдів, щоб отримати нагороду за їхні голови. Тобі треба знайти й знищити всі піратські кораблі.", false],
		[1, "", "Розправившись із піратами, Keith бере курс на Eden Prime, де адмірал Smith хоче зустрітися з ним щодо особливого доручення. Щойно запускається гіперпривід, прощальний постріл пошкоджує корабель. Привід відмовляє, система життєзабезпечення ледве працює, і автопілот несе непритомного пілота до найближчої станції — [[station/78]].", false],
	],
	"step/1": [
		[1, "", "Автопілот вивів пошкоджений корабель Keith на орбіту станції [[station/78]]; пілот лежить на борту без тями.", false],
		[2, "", "Keith приходить до тями на невеликій гірничій станції, якою керує [[character/2]], [[faction/2|нівеліанський]] торговець рудою. Gunant розібрав корабель і вважає його своєю законною здобиччю. Він сміється з думки дістатися Eden Prime, що лежить на іншому кінці галактики, і дивується, що Keith ніколи не чув про Void — ворожих істот, які тепер з'являються навіть у системі [[system/15]].", false],
		[2, "", "У Keith немає ні грошей, ні корабля, тож йому доводиться працювати на Gunant, видобуваючи руду на беззбройному кораблі.", false],
	],
	"step/10": [
		[10, "", "Keith летить на станцію [[station/79]], щоб зустрітися з капітаном [[character/3]].", false],
		[11, "", "Norris пояснює, що система [[system/15]] лежить у нещодавно відкритому секторі. Теранські й нівеліанські вигнанці заселили її під час Нівеліанської громадянської війни й заснували незалежну конфедерацію. Терани її визнають, а нівеліанці досі претендують на систему, тож на її околицях точаться бої.", false],
		[11, "", "Norris пропонує звести Keith із теранським Космічним флотом в обмін на послугу: зв'язок зі станцією [[station/76]] втрачено, і досвідчений пілот має з'ясувати причину.", false],
	],
	"step/11": [
		[11, "", "Keith летить до станції [[station/76]], щоб з'ясувати, чому вона мовчить. Станція виглядає неушкодженою, без слідів бою, тож він стикується.", false],
		[12, "", "Усередині Keith натрапляє на сумнозвісного торговця наркотиками [[character/4]], якого знав дуже давно. Mkkt привіз партію нейроводоростей, і весь екіпаж настільки одурманений, що не може працювати зі зв'язком. Keith забирається звідти щойно може.", false],
	],
	"step/12": [
		[12, "", "Keith повертається на станцію [[station/79]] з доповіддю.", false],
		[13, "", "Norris обурений і обіцяє розібратися з торговцем. До Kernstal прямує теранський військовий конвой, і це дасть Keith нагоду зв'язатися з флотом. Поки конвой не прибув, Norris радить Keith узятися за оплачувану роботу на космодромі (див. [[guide/lounge]]).", false],
	],
	"step/13": [
		[13, "", "Чекаючи на конвой, Keith має виконати два вільні завдання з космодрому (див. [[guide/jobs]]).", false],
		[14, "", "Norris повідомляє, що теранський конвой увійшов у систему й прямує до станції [[station/79]]. Keith вирушає йому назустріч.", false],
	],
	"step/14": [
		[14, "", "Біля станції [[station/79]] Keith знаходить теранський конвой і кількох піратів. Він кидається відганяти піратів.", false],
		[15, "", "Через колишній піратський корабель Keith приймають за одного з нападників. Конвой знерухомлює його корабель зброєю EMP і заарештовує пілота. Його доправляють на борт теранського крейсера, що прямує до станції [[station/98]] у теранському просторі.", false],
	],
	"step/15": [
		[15, "", "Keith прибуває на станцію [[station/98]] як в'язень конвою.", false],
		[16, "", "Відповідальний офіцер — [[character/1]], давній друг Keith, тепер очільник Міжзоряного агентства безпеки. Він вибачається за помилку. Їхню зустріч перериває поява винищувачів Void на орбіті, і на станції лунає тривога.", false],
	],
	"step/16": [
		[16, "", "Brent просить Keith допомогти відбити кораблі [[faction/9|Void]], що атакують станцію [[station/98]] (див. [[world/voids]]).", false],
		[17, "", "Void передають повідомлення про мирні наміри, але все одно атакують. Keith відбиває напад, і Brent обіцяє за келихом вина розповісти все, що знає.", false],
	],
	"step/17": [
		[17, "", "Keith стикується зі станцією [[station/98]], щоб почути, що Brent знає про Void.", false],
		[18, "", "Void з'являються впродовж останніх кількох тижнів. Вони прибувають крізь якісь часові тунелі, атакують усе, що трапляється, і, схоже, шукають руду; набігів зазнають навіть системи [[faction/1|Vossk]]. Brent очолює кризову групу, і її науковці збираються на таємній дослідницькій станції, якою керує Deep Science. Він просить Keith літати для них.", false],
		[18, "", "Системи станції немає на стандартних зоряних картах, тож по координати Keith має зустрітися з лейтенантом Thomas Boyle ([[character/5]]) на станції [[station/56]] у системі [[system/11]]. Brent також зізнається, що корабель Keith не новий: його лише перефарбували, щоб уникнути нових непорозумінь.", false],
	],
	"step/18": [
		[18, "", "Keith летить на станцію [[station/56]] на зустріч із Boyle.", false],
		[19, "", "Boyle так і не прибув. Brent повідомляє, що пірати викрали його біля станції [[station/55]] і вимагають викуп у п'ять мільйонів кредитів. Brent готовий заплатити, але Keith певен, що викрадачі вб'ють Boyle, щойно отримають гроші, і натомість вирушає до Kappa.", false],
	],
	"step/19": [
		[19, "", "Keith летить на станцію [[station/55]] шукати викрадачів.", false],
		[20, "", "Сканери Kappa виявляють корабель викрадачів. Brent залишив в ангарі станції бомби EMP, щоб Keith міг знерухомити корабель, поки викрадачі думатимуть, що він везе викуп.", false],
	],
	"step/2": [
		[2, "", "Gunant дає Keith старий, багато разів латаний корабель [[ship/0]] — колишнє піратське судно з гірничим лазером і без зброї. Keith має видобути щонайменше десять тонн руди з астероїдів біля станції [[station/78]] (див. [[guide/mining]]).", false],
		[3, "", "Коли руда на борту, Gunant велить йому пристикуватися, щоб перевірити вантаж. Без зброї Keith не має іншого вибору, як підіграти.", false],
	],
	"step/20": [
		[20, "", "Keith має пристикуватися до станції [[station/55]] і встановити на корабель бомби EMP.", false],
		[21, "", "Щойно бомби встановлено, Keith негайно вирушає.", false],
	],
	"step/21": [
		[21, "", "Навігаційна точка позначає корабель викрадачів, який може бути не сам. Keith має знерухомити його бомбою EMP, а не знищити, і впоратися з можливим супроводом.", false],
		[22, "", "Викрадачі думають, що прибув викуп, аж поки бомба не вимикає їхні системи. Brent відправляє загін забрати Boyle.", false],
	],
	"step/22": [
		[22, "", "Keith стикується зі станцією [[station/55]], щоб зустрітися з урятованим науковцем.", false],
		[23, "", "Boyle дякує йому. Його власний корабель утрачено, тож Keith пропонує підвезти його, і Boyle передає в навігаційний комп'ютер Keith координати системи [[system/6]], де розташована дослідницька станція.", false],
	],
	"step/23": [
		[23, "", "Keith доправляє Boyle на станцію [[station/10]] у системі [[system/6]], де на них чекає д-р Paolini.", false],
		[24, "", "Keith знайомиться з д-ром Carla Paolini ([[character/6]]), яка очолює проєкт Deep Science. Вона хоче вивчити технології Void, почавши з уламків їхніх кораблів. Deep Science платить Keith 20 000 кредитів на оснащення корабля, і йому конче потрібен тяговий промінь.", false],
		[24, "", "Carla наполягає, що полетить із ним до станції [[station/48]] у системі [[system/9]], де нещодавно бачили Void. Keith заперечує, але врешті поступається.", false],
	],
	"step/24": [
		[24, "", "Біля станції [[station/48]] Carla хоче розгледіти Void якомога ближче. Void оголошують, що прийшли з майбутнього і що вони — усе, що лишилося від цивілізацій галактики. Keith має битися з ними й збирати рештки їхніх кораблів тяговим променем.", false],
		[25, "", "Коли на борту вдосталь уламків, Carla просить повертатися, але раптом щось захоплює корабель.", false],
	],
	"step/25": [
		[25, "", "Keith і Carla приходять до тями далеко від станції [[station/48]], у частині космосу, якої жоден із них не знає.", false],
		[26, "", "Поблизу висить велетенський корабель-матка Void, що випускає винищувачі. Keith робить висновок, що вони пройшли крізь часовий тунель у рідний сектор Void. Той тунель зник, але такі проходи, схоже, руйнуються й з'являються деінде, тож щоб повернутися додому, треба дістатися іншого.", false],
	],
	"step/26": [
		[26, "", "Часовий тунель повертає їх до станції [[station/48]], але слідом прилетіли винищувачі Void. Keith має знищити їх, щоб вони не вистежили корабель аж до станції [[station/10]].", false],
		[27, "", "Позбувшись переслідувачів, обоє повертаються до Thynome, конче потребуючи відпочинку.", false],
	],
	"step/27": [
		[27, "", "Keith стикується зі станцією [[station/10]].", false],
		[28, "", "Через два дні Carla просить його повернутися туди. Її команда створила зонд, який після пострілу в корабель-матку аналізує його й надсилає результати на корабель Keith. Сама вона залишається вивчати уламки й відправляє його в систему [[system/18]], де щойно помітили Void, шукати інший часовий тунель.", false],
		[28, "", "Keith погоджується з однією умовою: якщо він повернеться живим, Carla піде з ним на побачення. Вона погоджується.", false],
	],
	"step/28": [
		[28, "", "Біля станції [[station/91]] з'являються винищувачі Void, і Keith має дістатися часового тунелю, перш ніж той зруйнується. Void попереджають, що, знищивши їх, він знищить власне майбутнє.", false],
		[29, "", "Keith досягає часового тунелю й проходить крізь нього в простір Void.", false],
	],
	"step/29": [
		[29, "", "Біля корабля-матки Keith має захопити його в приціл, що запускає зонд, а потім протриматися, поки зонд завершить аналіз.", false],
		[30, "", "Під час очікування Void знову виходять в ефір: вони мусять знайти спосіб поговорити, перш ніж люди знищать їх, а з ними й власне майбутнє. Keith тримається, доки передачу даних не завершено, і відлітає.", false],
	],
	"step/3": [
		[3, "", "Keith стикується зі станцією [[station/78]], щоб здати першу партію руди.", false],
		[4, "", "Gunant загалом задоволений, але знову відправляє Keith на видобуток — цього разу заповнити весь вантажний відсік. Він жартує, що колись Keith, може, й залишить корабель собі, якщо поводитиметься добре.", false],
	],
	"step/30": [
		[30, "", "Повернувшись крізь часовий тунель, Keith чекає біля станції [[station/91]].", false],
		[31, "", "Телефонує Brent і просить заглянути на станцію [[station/98]] у системі [[system/19]], перш ніж повертатися до Thynome, обіцяючи сюрприз. Звідти можна буде надіслати дані зонда Carla.", false],
	],
	"step/31": [
		[31, "", "Keith стикується зі станцією [[station/98]], щоб побачитися з Brent.", false],
		[32, "", "Команда Brent розробила для зоряної карти систему раннього попередження. Вона показує, де Void ось-ось відкриють часовий тунель, і навігаційний комп'ютер Keith доопрацьовують, щоб він міг її приймати. Brent хоче, щоб Keith літав у ці місця й підтримував місцеві сили, і платить йому 30 000 кредитів.", false],
		[32, "", "Brent додає, що з Keith хоче зустрітися [[character/20]], [[faction/7|представник раси Grey]], який працює на Deep Science.", false],
	],
	"step/32": [
		[32, "", "Keith повертається на станцію [[station/10]] на зустріч із персонажем [[character/20]].", false],
		[33, "", "Khador вивчив уламки Void. Він вважає, що таємниця їхніх часових тунелів криється в структурі певних кристалів, які трапляються лише в секторі Void. Він розробляє двигун, що миттєво переноситиме корабель у будь-яку точку космосу, і просить Keith привезти щонайменше 50 таких кристалів.", false],
		[33, "", "Keith має ще раз увійти в часовий тунель, цього разу знайшовши його за допомогою системи раннього попередження від Brent.", false],
	],
	"step/33": [
		[33, "", "Keith має зібрати 50 одиниць товару [[item/164]] у секторі Void і доставити їх на станцію [[station/10]].", false],
		[34, "", "Khador у захваті й дає Keith копію свого креслення, за яким виготовляють [[item/85]], щоб Keith міг побудувати такий двигун і для себе (див. [[guide/blueprints]]). Такий двигун може дістатися навіть рідного сектора Void.", false],
		[34, "", "З'являється Carla, надто заклопотана для побачення. Вона каже Keith, що разом із Brent розробила план, і відправляє його до Brent на станцію [[station/30]] у системі [[system/2]].", false],
	],
	"step/34": [
		[34, "", "Keith летить на станцію [[station/30]], щоб вислухати план Brent.", false],
		[35, "", "Дані зонда показують, що джерелом часових тунелів є корабель-матка. Досі жодна зброя не завдала йому шкоди, тож план полягає в тому, щоб направити в самісіньке його серце міцний вантажний корабель, навантажений нівеліанською ядерною вибухівкою.", false],
		[35, "", "Для цього найкраще підходить вантажний корабель Vossk типу K'Sarr. Brent домовився отримати його в рамках таємного обміну полоненими від командира [[character/7]], який керує станцією [[station/29]] у системі [[system/5]]. Errkt наполягає на особистій зустрічі з пілотом.", false],
	],
	"step/35": [
		[35, "", "Keith летить на територію [[faction/1|Vossk]], щоб зустрітися з командиром [[character/7]] на станції [[station/29]].", false],
		[36, "", "Errkt, який вивчив послужний список Keith, переконаний, що як слід керувати кораблем Vossk може лише Vossk. Оскільки місія не має права на провал, він сам поведе вантажний корабель. Та спершу Keith має довести свою майстерність пілота-винищувача біля планети [[station/27]].", false],
	],
	"step/36": [
		[36, "", "Errkt пропонує змагання біля піратської схованки поблизу планети [[station/27]]: перемагає той, хто зіб'є більше піратів.", false],
		[37, "", "Keith перемагає. Errkt визнає його вправним пілотом і надає йому честь супроводжувати вантажний корабель, який сам приведе до узгодженого місця зустрічі. Keith зв'язується з Brent, щоб доповісти.", false],
	],
	"step/37": [
		[37, "", "Keith зв'язується з Brent зі станції [[station/27]], щоб доповісти про перемовини з Errkt.", false],
		[38, "", "Імперія Vossk підтвердила свою підтримку, і Brent погоджується, щоб пілотом був Errkt. Але виникла нова проблема: кораблі [[faction/3|Конфедерації Mido]], що воює з нівеліанцями, захопили конвой із нівеліанською вибухівкою. Його помітили в системі [[system/4]] біля станції [[station/22]], і Keith погоджується його перехопити.", false],
	],
	"step/38": [
		[38, "", "Біля станції [[station/22]] Keith знаходить викрадений конвой під охороною винищувачів Mido. Він має знищити охорону, не пошкодивши кораблів конвою.", false],
		[39, "", "Коли конвой знову під контролем, Brent передає його місцевим силам безпеки для перельоту до станції [[station/30]] і просить Keith теж туди повернутися.", false],
	],
	"step/39": [
		[39, "", "Keith стикується зі станцією [[station/30]] для останнього брифінгу.", false],
		[40, "", "Вибухівку завантажено на вантажний корабель Vossk, і пілотом лишається Errkt. Щойно Void з'являться знову, Keith і Errkt полетять туди. Errkt прямуватиме до першого часового тунелю, а Keith прикриватиме його й рушить слідом. Brent попросить найближчу станцію про підкріплення.", false],
		[40, "", "Errkt має катапультуватися в рятувальній капсулі незадовго до зіткнення. Keith мусить повернутися крізь часовий тунель до знищення корабля-матки, інакше шляху додому не буде.", false],
	],
	"step/4": [
		[4, "", "Keith повертається до астероїдів і видобуває руду, доки трюм не заповниться.", false],
		[5, "", "Під час видобутку наближається піратський корабель. Беззбройному Keith велять тікати до станції, ухиляючись від вогню.", false],
	],
	"step/40": [
		[40, "", "За допомогою системи раннього попередження Keith летить на орбіту, яку атакують Void. Errkt прибуває з вантажним кораблем і прямує до першого часового тунелю, а лейтенант [[character/8]] приєднується зі своїм загоном. Keith має захищати вантажний корабель, доки той не пройде крізь тунель.", false],
		[41, "", "Броня вантажного корабля сильно пошкоджена, але Errkt досягає часового тунелю, і Keith прямує за ним.", false],
	],
	"step/41": [
		[41, "", "Загін Baffour не встиг пройти крізь часовий тунель, тож Keith і Errkt лишилися самі. Вантажний корабель іде на зіткнення з кораблем-маткою, і Keith має розчистити йому шлях від винищувачів Void.", false],
		[42, "", "Коли вантажний корабель наближається до цілі, Errkt повідомляє, що його рятувальну капсулу підбито. Він вирішує залишитися на кораблі й наказує Keith відлітати, поки ще є час. Keith прощається й повертає назад.", false],
	],
	"step/42": [
		[42, "", "Keith має відлетіти на безпечну відстань, поки вантажний корабель Errkt іде до цілі.", false],
		[43, "", "Brent повідомляє, що часові тунелі по всьому сектору зруйнувалися: план спрацював. Keith розповідає, що Errkt не вижив, і Brent обіцяє вшанувати його у своєму звіті для Імперії Vossk. Вони домовляються випити разом на станції [[station/98]].", false],
	],
	"step/43": [
		[43, "", "Keith приєднується до Brent на станції [[station/98]], щоб відсвяткувати перемогу.", false],
		[44, "", "Після кількох келихів з'являється Carla у вечірній сукні, щоб віддати Keith обіцяне побачення. Brent тактовно залишає їх наодинці.", false],
	],
	"step/44": [
		[44, "", "Keith прокидається на станції [[station/98]] з похміллям після ночі з Carla.", false],
		[45, "", "Carla зникла. У записці вона пояснює, що перейшла до іншого таємного проєкту в місці, якого не розкриє, і що Deep Science виплачує Keith останні 40 000 кредитів. Keith підозрює, що його весь час використовували, і повертається до бару.", false],
	],
	"step/45": [
		[45, "", "Сюжет завершено. Корабель-матку Void знищено, часові тунелі закрилися, і [[character/0]] може летіти куди заманеться. Ти можеш і далі літати, торгувати, видобувати руду й братися за завдання по всій галактиці; стислий переказ усього сюжету — на сторінці [[world/history]].", false],
	],
	"step/5": [
		[5, "", "Keith має відірватися від пірата й благополучно пристикуватися до станції [[station/78]].", false],
		[6, "", "Gunant визнає, що піратські набіги на його станцію стають дедалі гіршими. Keith пропонує розібратися з ними, якщо отримає зброю. Gunant вирішує спробувати вдарити по піратській схованці поблизу станції й відчиняє свій невеликий ангар, щоб Keith міг встановити зброю та броню.", false],
	],
	"step/6": [
		[6, "", "В ангарі станції Keith має оснастити [[ship/0]] зброєю та бронепластиною (див. [[guide/fitting]]).", false],
		[7, "", "Gunant схвалює вибір. Про всяк випадок він налаштував зброю Keith так, щоб вона не могла пробити його власні щити. Обидва домовляються зустрітися зовні.", false],
	],
	"step/7": [
		[7, "", "Gunant передає маршрут до схованки у вигляді навігаційних точок. Keith має пролетіти ним і знищити піратські кораблі, а Gunant летить поруч (див. [[guide/combat]]).", false],
		[8, "", "У схованці набагато більше піратів, ніж очікувалося. Gunant хоче відступити, але Keith продовжує бій і перемагає. На запитання, де він навчився так битися, Keith відповідає, що служив у Космічному флоті під командуванням адмірала Smith. Gunant це дивує, бо Keith виглядає надто молодим.", false],
	],
	"step/8": [
		[8, "", "Бій виграно, і Keith із Gunant повертаються на станцію [[station/78]].", false],
		[9, "", "Gunant дякує Keith за порятунок і згадує могилу адмірала Smith на станції [[station/5]]. Keith приголомшений: адмірал помер від старості близько 3612 року. Тоді Gunant каже, що зараз 3624 рік, і що, на його думку, цей рік запам'ятається через Void.", false],
	],
	"step/9": [
		[9, "", "Вражений новиною, Keith знову стикується зі станцією [[station/78]], щоб остаточно розібратися з Gunant.", false],
		[10, "", "Keith розуміє, що відтоді, як у нього влучили в поясі астероїдів, минуло близько 35 років. Gunant підозрює збій гіперприводу, адже такий тип приводу вже багато років пов'язують із подібними випадками.", false],
		[10, "", "На знак подяки за перемогу над піратами Gunant дарує Keith корабель [[ship/0]] із потужнішим двигуном для польотів між планетами системи. Гірничий лазер, прототип власної конструкції, він залишає собі. Keith нарешті називає своє ім'я й вирушає на зустріч із капітаном [[character/3]], людським командиром на станції [[station/79]], який може допомогти йому дістатися [[faction/0|теранського]] простору. Відтепер [[chart]] дозволяє подорожувати в межах системи.", false],
	],
	"system/0": [
		[0, "", "[[system/0]] — нівеліанська система на лівому краю карти. Вона прихована на зоряній карті, доки ти не купиш її координати в агента [[agent/12]] на станції [[station/18]]. Її ворота біля станції [[station/0]] ведуть до систем [[system/2]] і [[system/8]].", false],
		[0, "", "Станції цієї системи — одні з найдосконаліших у нівеліанському просторі: [[station/2]] і [[station/4]] мають найвищий тех. рівень. Агент [[agent/0]] продає креслення на станції [[station/3]].", false],
	],
	"system/1": [
		[0, "", "[[system/1]] — теранська система в нижньому лівому куті карти. Вона прихована, доки ти не купиш її координати в агента [[agent/13]] на станції [[station/26]]. Її ворота біля станції [[station/5]] ведуть до систем [[system/8]] і [[system/18]].", false],
		[0, "", "Її станції добре розвинені, а [[station/7]] має найвищий тех. рівень. Агент [[agent/1]] продає креслення на станції [[station/8]].", false],
		[9, "", "За словами торговця [[character/2]], адмірал Smith, колишній командир героя ([[character/0]]), похований на станції [[station/5]].", false],
	],
	"system/10": [
		[0, "", "[[system/10]] — система Vossk у правій частині карти з рівнем «Dangerous» (небезпечна). Вона прихована, доки ти не купиш її координати в агента [[agent/14]], і взагалі не має зв'язків через ворота: дістатися її може лише корабель зі стрибковим двигуном. Усі п'ять її станцій мають найвищі тех. рівні.", false],
		[0, "", "Агент [[agent/5]] продає креслення на станції [[station/54]].", false],
	],
	"system/11": [
		[0, "", "[[system/11]] — теранська система вгорі в центрі карти з рівнем «Average» (середня). Тут лише три станції. Її ворота біля станції [[station/55]] ведуть до систем [[system/7]], [[system/9]], [[system/14]] і [[system/16]].", false],
		[18, "", "Героя ([[character/0]]) відправляють на станцію [[station/56]] на зустріч з офіцером Deep Science.", false],
		[19, "", "Цього офіцера, [[character/5]], викрали пірати біля станції [[station/55]].", false],
		[22, "", "[[character/0]] звільняє його за допомогою бомб EMP ([[step/21]]).", false],
	],
	"system/12": [
		[0, "", "[[system/12]] — невелика система Vossk лише з двома станціями в правій частині карти з рівнем «Average» (середня). Її ворота біля станції [[station/60]] ведуть до систем [[system/3]], [[system/5]], [[system/13]] і [[system/14]], тож вона з'єднує простір Vossk зі східними теранськими системами.", false],
		[0, "", "Агент-мультипод [[agent/6]] продає креслення на станції [[station/61]].", false],
	],
	"system/13": [
		[0, "", "[[system/13]] — теранська система на правому краю карти з рівнем «Risky» (ризикована). Її ворота біля станції [[station/65]] ведуть до систем [[system/12]] і [[system/16]].", false],
		[0, "", "Агент-кіборг [[agent/14]] продає координати на станції [[station/65]].", false],
	],
	"system/14": [
		[0, "", "[[system/14]] — теранська система поблизу центру карти й одна з двох систем галактики з рівнем «Safe» (безпечна). Її ворота біля станції [[station/70]] ведуть до систем [[system/3]], [[system/11]], [[system/12]] і [[system/19]]. Її станції здебільшого мають низький тех. рівень.", false],
		[0, "", "Агент [[agent/7]] продає креслення на станції [[station/72]].", false],
	],
	"system/15": [
		[0, "", "[[system/15]] — мідоріанська система вгорі карти з рівнем «Dangerous» (небезпечна). Вона не має зв'язків через ворота, тож увійти в неї чи покинути її можна лише зі стрибковим двигуном. Усі п'ять її станцій невеликі й мають низький тех. рівень. До певного етапу сюжету ([[step/16]]) торговці кораблями тут зачинені, а кораблі прилітають і відлітають рідко.", false],
		[0, "", "Сюжет починається тут, біля станції [[station/78]].", false],
		[11, "", "Система — територія [[faction/3|Конфедерації Mido]], яку заснували теранські й нівеліанські вигнанці під час Нівеліанської громадянської війни. Нівеліанці досі претендують на неї, і на її околицях точаться бої.", false],
		[15, "", "[[character/0]] покидає систему в'язнем на борту теранського крейсера ([[step/14]]). Щоб згодом повернутися, потрібен стрибковий двигун.", false],
		[0, "", "Торговець [[character/2]] продає креслення на космодромі станції [[station/78]].", false],
	],
	"system/16": [
		[0, "", "[[system/16]] — теранська система в правій частині карти з рівнем «Risky» (ризикована). Її ворота біля станції [[station/80]] ведуть до систем [[system/11]] і [[system/13]].", false],
		[0, "", "Агент [[agent/8]] із раси Vossk продає креслення на станції [[station/84]].", false],
	],
	"system/17": [
		[0, "", "[[system/17]] — нівеліанська система вгорі ліворуч на карті з рівнем «Risky» (ризикована), найближча до системи [[system/15]]. Її ворота біля станції [[station/85]] ведуть до систем [[system/2]], [[system/9]] і [[system/4]]; це єдиний маршрут через ворота до системи [[system/4]].", false],
		[0, "", "Агент [[agent/15]] із раси Vossk продає координати на станції [[station/88]].", false],
	],
	"system/18": [
		[0, "", "[[system/18]] — теранська система внизу карти з рівнем «Risky» (ризикована). Її ворота біля станції [[station/90]] ведуть до систем [[system/1]] і [[system/8]].", false],
		[0, "", "Агент [[agent/9]] продає креслення на станції [[station/90]].", false],
		[28, "", "Після повідомлення про активність Void біля станції [[station/91]] сюди прилітає [[character/0]], щоб прослизнути в часовий тунель ([[step/28]]).", false],
	],
	"system/19": [
		[0, "", "[[system/19]] — теранська система в центрі карти з рівнем «Safe» (безпечна). Її ворота біля станції [[station/95]] ведуть до систем [[system/3]], [[system/8]], [[system/9]] і [[system/14]].", false],
		[15, "", "Саме на станцію [[station/98]] теранський крейсер доправляє героя ([[character/0]]) після арешту, і саме тут він знову зустрічає давнього друга [[character/1]].", false],
		[16, "", "Навіть ця безпечна система не вберігається: ескадрилья Void атакує станцію [[station/98]] ([[step/16]]). Тут розташований штаб, де працює [[character/1]].", false],
	],
	"system/2": [
		[0, "", "[[system/2]] — нівеліанська система в лівій частині карти й перехрестя нівеліанського простору. Її ворота біля станції [[station/30]] ведуть до систем [[system/0]], [[system/8]], [[system/9]] і [[system/17]]. Тут чотири станції середнього тех. рівня.", false],
		[34, "", "Персонаж [[character/6]] відправляє героя ([[character/0]]) на станцію [[station/30]], де на нього чекає [[character/1]] із новим планом ([[step/33]]). Там же відбуваються й останні приготування до боротьби з Void.", false],
	],
	"system/20": [
		[0, "", "[[system/20]] — система Vossk унизу праворуч на карті з рівнем «Dangerous» (небезпечна). Її ворота біля станції [[station/62]] ведуть до систем [[system/5]] і [[system/21]], тож це єдиний маршрут через ворота до системи [[system/21]].", false],
		[0, "", "Теранець, агент [[agent/10]], продає креслення на невеликій станції [[station/59]].", false],
	],
	"system/21": [
		[0, "", "[[system/21]] — система Vossk у дальньому нижньому правому куті карти з рівнем «Dangerous» (небезпечна). Вона прихована, доки ти не купиш її координати в агента [[agent/15]]. Її ворота біля станції [[station/12]] ведуть лише до системи [[system/20]]. Усі її станції примітивні, з тех. рівнем 3 або нижче.", false],
	],
	"system/3": [
		[0, "", "[[system/3]] — найближча до центру карти система Vossk і головний вхід до їхнього простору. Її ворота біля станції [[station/15]] ведуть до систем [[system/5]], [[system/12]], [[system/8]], [[system/14]] і [[system/19]]. Рівень безпеки — «Average» (середня).", false],
		[0, "", "Агент [[agent/12]] на станції [[station/18]] продає координати прихованої системи [[system/0]].", false],
	],
	"system/4": [
		[0, "", "[[system/4]] — мідоріанська система у верхньому лівому куті карти з рівнем «Dangerous» (небезпечна). Це глухий кут: її ворота біля станції [[station/20]] ведуть лише до системи [[system/17]]. Її станції бувають від примітивної [[station/21]] до добре оснащеної [[station/22]].", false],
		[0, "", "Агент [[agent/2]] продає креслення на космодромі станції [[station/20]].", false],
		[38, "", "Викрадений конвой із нівеліанською вибухівкою вистежують у цій системі біля станції [[station/22]] ([[step/38]]).", false],
	],
	"system/5": [
		[0, "", "[[system/5]] — система Vossk унизу праворуч на карті з рівнем «Risky» (ризикована). Її ворота біля станції [[station/25]] ведуть до систем [[system/3]], [[system/12]] і [[system/20]]. Агент [[agent/13]] продає координати на станції [[station/26]].", false],
		[35, "", "Тут, на станції [[station/29]], базується командир Vossk [[character/7]], з яким [[character/0]] зустрічається пізніше ([[step/35]]).", false],
		[36, "", "Їхнє змагання відбувається біля планети [[station/27]].", false],
	],
	"system/6": [
		[0, "", "[[system/6]] — теранська система вгорі праворуч на карті з рівнем «Dangerous» (небезпечна). Її немає на стандартних зоряних картах, і її координати розкриває лише сюжет. Тут лише одна станція, [[station/10]], ворота якої ведуть тільки до системи [[system/7]].", false],
		[23, "", "Система приховує таємну дослідницьку станцію Deep Science. Науковець [[character/5]] передає героєві ([[character/0]]) її координати ([[step/22]]), і саме тут планують значну частину боротьби з Void.", false],
	],
	"system/7": [
		[0, "", "[[system/7]] — теранська система вгорі праворуч на карті з рівнем «Risky» (ризикована). Її ворота біля станції [[station/35]] ведуть до системи [[system/11]] і до прихованої [[system/6]], тож це єдиний маршрут через ворота до прихованої системи. [[station/37]] — її найдосконаліша станція.", false],
	],
	"system/8": [
		[0, "", "[[system/8]] — теранська система в нижній лівій чверті карти й найкраще сполучена система галактики. Її ворота біля станції [[station/40]] ведуть до шести систем: [[system/0]], [[system/1]], [[system/2]], [[system/3]], [[system/18]] і [[system/19]]. Рівень безпеки — «Average» (середня).", false],
		[0, "", "Агент [[agent/4]] продає креслення на станції [[station/43]].", false],
	],
	"system/9": [
		[0, "", "[[system/9]] — нівеліанська система вгорі в центрі карти з рівнем «Average» (середня). Її ворота біля станції [[station/45]] ведуть до систем [[system/2]], [[system/11]], [[system/17]] і [[system/19]].", false],
		[24, "", "Біля станції [[station/48]] повідомляють про активність Void, і [[character/0]] та [[character/6]] вирушають туди, щоб зібрати уламки ([[step/24]]).", false],
	],
	"world/galaxy": [
		[0, "Огляд", "Дія гри відбувається в одній галактиці з 22 зоряних систем. Кожна система належить одній фракції, має рівень безпеки й налічує від однієї до п'яти космічних станцій. Кожна станція обертається навколо планети, і на кожній є власний магазин, ангар і космодром. Системи розкидані по пласкій карті, а подорожі між ними пролягають мережею стрибкових воріт.", false],
		[0, "", "Нанесені на карту системи належать чотирьом народам. [[faction/0|Терани]] володіють десятьма, [[faction/1]] — шістьма, [[faction/2|нівеліанці]] — чотирма, а [[faction/3|мідоріанці]] — двома. Представники менших рас, як-от [[faction/4|мультиподи]], [[faction/5|кіборги]], [[faction/6|боболіанці]] та [[faction/7]], живуть серед них, не маючи власної території. [[faction/8|Пірати]] нишпорять у кожній системі, а від самого початку ходять чутки про ворожу силу, що зветься [[faction/9|Void]].", false],
		[0, "Розташування", "Нівеліанські й мідоріанські системи лежать у верхній лівій частині карти: [[system/15]], [[system/4]], [[system/17]] і [[system/2]]. Теранський простір тягнеться через центр, праву частину й низ карти, а його серце — системи [[system/19]] і [[system/14]]. Системи Vossk утворюють окремий блок унизу праворуч: він починається системою [[system/3]] і закінчується в дальньому кутку системою [[system/21]].", false],
		[0, "", "Маршрути воріт тяжіють до центру. Система [[system/8]] має шість зв'язків через ворота — більше, ніж будь-яка інша, а системи [[system/19]], [[system/14]], [[system/3]] і [[system/11]] сполучаються з чотирма-п'ятьма системами кожна. Системи на краях, як-от [[system/4]], [[system/6]] і [[system/21]], — глухі кути з єдиним зв'язком.", false],
		[0, "Подорожі", "У межах системи звичайний двигун корабля переносить його з орбіти однієї станції на орбіту іншої. Щоб покинути систему, корабель пролітає крізь стрибкові ворота, які стоять біля однієї зі станцій системи й ведуть лише до пов'язаних із нею систем. Довші подорожі — це ланцюжки стрибків через ворота. Стрибковий двигун — єдиний спосіб обійти мережу воріт і дістатися будь-якої відомої системи напряму; див. [[guide/navigation]].", false],
		[33, "", "Єдиний стрибковий двигун у грі — [[item/85]], який під час сюжету конструює [[character/20]]. Його виготовляють за кресленням, і серед іншого для нього потрібен товар [[item/164]].", false],
		[0, "Безпека", "Кожна система має рівень безпеки: «Safe» (безпечна), «Average» (середня), «Risky» (ризикована) або «Dangerous» (небезпечна). Від рівня залежить, як часто біля станції на тебе чатують нападники, коли ти прибуваєш. У небезпечній системі вони з'являються майже щоразу, у безпечній — рідко. Зазвичай це пірати, але часом і кораблі раси-суперниці місцевої фракції. Натомість безпечніші системи тримають біля своїх станцій більше місцевих патрульних кораблів.", false],
		[0, "Фракції та репутація", "Твоя репутація ведеться за двома шкалами: одна між теранами й Vossk, друга між нівеліанцями й мідоріанцями. Прихильність однієї сторони пари коштує прихильності іншої. Якщо твоя репутація у фракції впаде надто низько, її кораблі атакуватимуть тебе одразу, а її станції не прийматимуть. Пірати й Void ворожі завжди. Дипломат на космодромі може за плату виправити твою репутацію.", false],
		[0, "Приховані системи", "Спочатку на зоряній карті видно не всі системи. Системи [[system/0]], [[system/1]], [[system/10]] і [[system/21]] лишаються прихованими, доки ти не купиш їхні координати в агента на космодромі; див. [[guide/lounge]]. Ще однієї системи, [[system/6]], немає на стандартних зоряних картах, і розкриває її лише сюжет.", false],
		[23, "", "Координати системи [[system/6]] ти отримуєш від персонажа [[character/5]] ([[step/22]]). У системі лише одна станція, [[station/10]], — таємна дослідницька база організації Deep Science.", false],
		[0, "", "Дві системи взагалі не мають зв'язків через ворота: [[system/15]] і [[system/10]]. Дістатися їх або покинути їх можна лише зі стрибковим двигуном.", false],
		[0, "Ізольований початок", "Сюжет починається в системі [[system/15]] — віддаленій системі вгорі карти без зв'язку через ворота з рештою галактики. Торгівля тут бідна, станції мають низький тех. рівень, а торговці кораблями першу частину сюжету не працюють. Спочатку вибратися з системи можна лише тим шляхом, який дає сюжет.", false],
		[11, "", "Система [[system/15]] — батьківщина [[faction/3|Конфедерації Mido]], спільноти теранських і нівеліанських біженців і вигнанців, які заселили цей нещодавно нанесений на карту сектор під час Нівеліанської громадянської війни. Конфедерація проголосила незалежність. Терани з цим погоджуються, а нівеліанці досі претендують на систему, тож на її околицях не вщухають бої.", false],
		[15, "", "[[character/0]] покидає систему [[system/15]] на борту теранського крейсера після того, як конвой біля станції [[station/79]] знерухомлює й заарештовує його ([[step/14]]). Він прибуває на станцію [[station/98]] у системі [[system/19]], глибоко в теранському просторі.", false],
		[9, "Провал у часі", "Прокинувшись у системі [[system/15]], [[character/0]] вважає, що минуло зовсім небагато часу. Насправді пошкоджений гіперпривід закинув його через усю галактику й приблизно на 35 років у майбутнє. Знайома йому галактика змінилася: старі друзі постаріли або померли, а тим часом заселено нові сектори, зокрема й той, де він опинився.", false],
		[10, "", "Несправні гіперприводи цього типу вже й раніше спричиняли подібні стрибки в часі та просторі.", false],
		[18, "За межами карти", "Void проникають у нанесені на карту системи крізь якісь часові тунелі. Вони однаково нападають на теранський, нівеліанський простір і простір Vossk і, схоже, шукають руду. Див. [[world/voids]].", false],
		[25, "", "Часовий тунель веде за межі нанесеної на карту галактики, у власний сектор Void, якому немає місця на зоряній карті. Тунелі на якийсь час відкриваються біля станції, потім руйнуються й з'являються деінде.", false],
		[34, "", "Корабель, на якому встановлено [[item/85]], може також стрибнути просто в сектор Void.", false],
		[32, "", "Із певного моменту сюжету ([[step/31]]) система раннього попередження показує на зоряній карті, де відкриється наступний часовий тунель.", false],
		[42, "", "Коли корабель-матку Void знищено ([[step/41]]), часові тунелі по всьому сектору руйнуються, і набіги припиняються.", false],
	],
	"world/history": [
		[0, "", "Галактику населяють кілька народів, серед них [[faction/0|терани]], [[faction/2|нівеліанці]] та [[faction/1|Vossk]]. Простір між їхніми станціями кишить [[faction/8|піратами]]. Ця сторінка коротко переказує сюжет; кожна частина з'являється, щойно твоє збереження до неї дійде.", false],
		[0, "Дія перша: на мілині", "Теранський мисливець за головами [[character/0]] знищує піратську банду в поясі астероїдів ([[step/0]]).", false],
		[1, "", "Останній постріл пошкоджує його гіперпривід, коли він стрибає на зустріч зі своїм колишнім командиром, адміралом Smith. Корабель із непритомним пілотом дрейфує до станції [[station/78]].", false],
		[2, "", "Нівеліанський торговець рудою [[character/2]] підбирає уламки, залишає корабель собі й змушує Keith видобувати для нього руду.", false],
		[8, "", "Keith допомагає Gunant знищити піратську схованку неподалік ([[step/7]]).", false],
		[9, "", "Згодом Keith дізнається, що надворі 3624 рік і що адмірал Smith давно помер.", false],
		[10, "", "Збій гіперприводу закинув Keith на 35 років у майбутнє і у віддалений куточок галактики. Gunant дарує йому корабель [[ship/0]] і відправляє до капітана [[character/3]] на станцію [[station/79]].", false],
		[11, "", "Система [[system/15]] належить [[faction/3|Конфедерації Mido]], яку заснували теранські та нівеліанські вигнанці під час Нівеліанської громадянської війни.", false],
		[12, "", "Keith з'ясовує, що мовчазну станцію [[station/76]] довів до дурману торговець наркотиками [[character/4]] ([[step/11]]).", false],
		[15, "", "Коли через систему проходить теранський конвой, його екіпаж приймає Keith за пірата, знерухомлює його корабель і доправляє на станцію [[station/98]] ([[step/14]]).", false],
		[16, "Дія друга: загроза Void", "Там він зустрічає свого старого друга [[character/1]], тепер начальника служби безпеки, саме тоді, коли станцію атакують [[faction/9|Void]].", false],
		[18, "", "Void нападають на зоряні системи крізь часові тунелі в пошуках руди. Brent вербує Keith пілотом для Deep Science, таємної дослідницької організації, що їх вивчає ([[step/17]]).", false],
		[19, "", "Науковця [[character/5]], який мав провести Keith до дослідницької станції, викрадають пірати.", false],
		[23, "", "Keith знерухомлює корабель викрадачів бомбами EMP, рятує науковця й отримує координати системи [[system/6]] ([[step/21]], [[step/22]]).", false],
		[24, "Дія третя: Deep Science", "На станції [[station/10]] Keith знайомиться з керівницею проєкту [[character/6]] і починає працювати на Deep Science.", false],
		[25, "", "Keith і Carla збирають уламки Void біля станції [[station/48]], але їхній корабель поглинає часовий тунель ([[step/24]]).", false],
		[26, "", "Вони опиняються в рідному секторі Void, поруч із велетенським кораблем-маткою, і тікають крізь інший часовий тунель.", false],
		[30, "", "Keith повертається в сектор Void крізь часовий тунель біля станції [[station/91]] і запускає зонд у корабель-матку ([[step/29]]).", false],
		[32, "", "Brent дає Keith систему раннього попередження, яка показує, де Void ударять наступного разу.", false],
		[34, "", "Науковець із раси Grey [[character/20]] доручає Keith зібрати кристали Void для нового миттєвого двигуна й дає йому креслення ([[step/33]]).", false],
		[35, "Дія четверта: удар", "Зонд показує, що часові тунелі створює корабель-матка. Brent і Carla вирішують знищити його вантажним кораблем, повним нівеліанської вибухівки, який надає командир Vossk [[character/7]].", false],
		[37, "", "Errkt наполягає, що сам поведе вантажний корабель, а Keith виборює право його супроводжувати ([[step/36]]).", false],
		[39, "", "Keith відбиває конвой із вибухівкою після того, як його захопили кораблі Mido ([[step/38]]).", false],
		[42, "", "З підкріпленням під командуванням [[character/8]] Keith супроводжує Errkt крізь часовий тунель. Errkt тараном спрямовує вантажний корабель у корабель-матку й гине під час атаки ([[step/41]]).", false],
		[43, "", "Усі часові тунелі руйнуються, і набіги Void припиняються.", false],
		[45, "Епілог", "Keith святкує з Brent і нарешті проводить ніч із Carla. Наступного ранку вона відлітає до іншого таємного проєкту, а Keith може вільно мандрувати галактикою.", false],
	],
	"world/voids": [
		[0, "", "[[faction/9|Void]] — головна загроза сюжету. Ця сторінка збирає все, що про них відомо; нові відомості з'являються в міру того, як просувається твоє збереження.", false],
		[2, "Перші звістки", "Уперше Keith чує про Void від персонажа [[character/2]]: це ворожі істоти, що час від часу з'являються навіть у віддаленій системі [[system/15]].", false],
		[9, "", "Мешканці системи Mido вважають, що 3624 рік запам'ятається як рік Void.", false],
		[16, "", "Винищувачі Void атакують станцію [[station/98]] у теранському просторі ([[step/15]]).", false],
		[17, "", "Під час атаки Void передають повідомлення, що прийшли з миром, але не припиняють вогню.", false],
		[18, "Що відомо", "Void почали з'являтися кілька тижнів тому. Вони проникають у заселені системи крізь часові тунелі, атакують усе, що трапляється на шляху, і, схоже, шукають руду. Набігів зазнають навіть системи [[faction/1|Vossk]]. Ніхто не знає, звідки вони прибувають і чого хочуть.", false],
		[24, "", "Біля станції [[station/48]] вони заявляють, що прийшли з майбутнього і що вони — усе, що лишилося від цивілізацій галактики.", false],
		[26, "Рідний сектор", "Їхні часові тунелі ведуть до далекого рідного сектора, де велетенський корабель-матка випускає винищувачі. Тунелі відкриваються ненадовго, потім руйнуються й виникають деінде.", false],
