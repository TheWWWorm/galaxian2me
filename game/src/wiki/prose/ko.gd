	],
	"item/20": [
		[0, "", "[[item/20]]은(는) 0.2초마다 피해 13을 준다. 시간당 피해는 [[item/19]]보다 높지만 사거리가 1,000에 불과해 근거리에서 가장 효과적이다.", false],
	],
	"item/21": [
		[0, "", "[[item/21]]은(는) 0.2초마다 피해 14를 주며, 이는 전방 포 중 가장 높은 시간당 피해다. [[item/20]]처럼 사거리는 1,000에 불과하다. 상점에서 가장 보기 드문 블래스터이기도 하다.", false],
	],
	"item/22": [
		[0, "", "[[item/22]]은(는) 게임에서 가장 약한 포로, 사거리 1,000에서 0.4초마다 피해 2를 준다. 자동포는 작고 빠른 탄환을 쏘는데, 위력은 약하지만 일부 모델은 매우 빠르게 연사한다. 이 첫 모델은 임시방편일 뿐이다.", false],
		[6, "", "해적 은신처 습격 전에 [[character/2]]이(가) [[station/78]] 정거장의 격납고에서 무료로 내주는 세 가지 물품 중 하나로, 나머지는 [[item/0]]와(과) [[item/55]](이)다.", false],
	],
	"item/23": [
		[0, "", "[[item/23]]은(는) [[item/22]]의 피해를 발당 4로 두 배 늘리고, 사거리 1,000을 유지한 채 조금 더 빨리(0.3초마다) 발사한다. 저렴한 초반 무기다.", false],
	],
	"item/24": [
		[0, "", "[[item/24]]은(는) 사거리 1,200에서 0.3초마다 피해 6을 준다. 탄탄한 중급 자동포로, 사거리가 더 긴 [[item/25]]와(과) 시간당 피해가 같다.", false],
	],
	"item/25": [
		[0, "", "[[item/25]]은(는) 0.4초마다 피해 8을 주며 사거리는 1,400으로 자동포 중 가장 길다. 시간당 피해는 [[item/24]]와(과) 같다. 완제품으로는 판매되지 않는다. 설계도는 [[station/20]] 정거장의 [[agent/2]]에게서 얻으며, 광석 없이 일반 상품만으로 만든다.", false],
	],
	"item/26": [
		[0, "", "[[item/26]]은(는) 사거리 1,000에서 0.2초마다 피해 5를 준다. 빠른 연사 덕분에 레일건보다 시간당 피해가 높지만, 그 대가로 사거리가 짧다.", false],
	],
	"item/27": [
		[0, "", "[[item/27]]은(는) 자동포 중 가장 빠른 0.1초마다 발당 피해 6을 준다. 시간당 피해는 최고의 블래스터에 가깝지만, 사거리 900은 모든 포 중 가장 짧다. 완제품으로는 판매되지 않는다. 설계도는 [[station/10]] 정거장의 [[agent/3]]에게서 얻으며, 제작에는 여러 상품 중에서도 [[item/154]]이(가) 필요하다.", false],
	],
	"item/28": [
		[0, "", "[[item/28]]은(는) 첫 번째 열 무기다. 열 무기는 사거리 1,000에서 가볍고 빠른 탄을 쏘며, 이 모델은 0.3초마다 피해 3을 준다. 기술 레벨이 높은데도 시간당 피해는 대부분의 중급 블래스터와 자동포보다 약하다.", false],
	],
	"item/29": [
		[0, "", "[[item/29]]은(는) 사거리 1,000에서 0.2초마다 피해 4를 주며, 시간당 피해는 [[item/28]]의 두 배다.", false],
	],
	"item/3": [
		[0, "", "[[item/3]]은(는) 0.5초마다 피해 7을 주는 [[faction/1|Vossk]] 레이저다. 발당 위력은 [[item/2]]와(과) 같지만 연사가 조금 느려 시간당 피해는 약간 뒤처진다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
		[0, "", "오프닝 장면에서 [[character/0]]의 [[ship/10]]에 이 레이저가 2정 장착되어 있다.", false],
	],
	"item/30": [
		[0, "", "[[item/30]]은(는) 0.1초마다 피해 3을 주며, 열 무기 중 가장 빠르다. 시간당 피해는 [[item/29]]보다 높지만 [[item/21]] 같은 최상위 블래스터보다는 낮다.", false],
	],
	"item/31": [
		[0, "", "[[item/31]]은(는) 기본 [[faction/1|Vossk]] 로켓이자 가장 싼 보조 무기 탄약이다. 명중당 피해 60, 1.2초마다 발사, 사거리 1,200이다. 로켓은 직진하며 목표를 추적하지 않으므로 근거리에서 가장 효과적이다. 소행성에 맞은 로켓이나 어뢰는 소행성을 산산조각 낸다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/32": [
		[0, "", "[[item/32]]은(는) 흔한 비유도 로켓이다. 명중당 피해 70, 0.9초마다 발사, 사거리 1,200이다. [[item/31]]보다 강하고 빨리 발사하며, 널리 판매된다.", false],
	],
	"item/33": [
		[0, "", "[[item/33]]은(는) 피해 72를 주면서 에너지도 34 빼앗으므로, 목표에 피해를 주는 동시에 무력화를 도울 수 있다. 재장전이 느리고(2초) 사거리는 1,000이다. 완제품으로는 판매되지 않는다. 설계도는 [[station/43]] 정거장의 [[agent/4]]에게서 얻으며, 한 회차에 값싼 일반 상품 몇 가지만 있으면 된다.", false],
	],
	"item/34": [
		[0, "", "[[item/34]]은(는) 파괴보다 무력화를 위한 것이다. 명중당 에너지 45를 빼앗고 피해는 10만 주며, 1초마다 발사한다. [[item/35]]은(는) 더 많이 빼앗고 피해도 더 크다.", false],
	],
	"item/35": [
		[0, "", "[[item/35]]은(는) 명중당 에너지 60을 빼앗고 피해 30을 주며, 사거리 1,000에서 1초마다 발사한다. 선체도 깎으면서 [[item/34]]보다 빨리 함선을 무력화한다.", false],
	],
	"item/36": [
		[0, "", "[[item/36]]은(는) 기본 어뢰다. 어뢰는 처음 1.5초 동안 직진한 뒤 목표를 향해 유도된다. [[item/36]]은(는) 사거리 3,000에서 피해 70을 주지만, 느리고 3초마다 한 번만 발사한다. [[item/38]]은(는) 피해가 두 배다.", false],
	],
	"item/37": [
		[0, "", "[[item/37]]은(는) 가장 빠른 어뢰로, 피해 100을 주고 에너지 50을 빼앗으며 사거리는 4,000이다. 4초마다 발사한다. 완제품으로는 판매되지 않는다. 설계도는 [[station/54]] 정거장의 [[agent/5]]에게서 얻으며, 한 회차에 일반 상품 몇 가지만 있으면 된다.", false],
	],
	"item/38": [
		[0, "", "[[item/38]]은(는) 가장 강한 어뢰로, 명중당 피해 140, 사거리 4,000이다. 비행 속도가 느리며 4초마다 발사한다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/39": [
		[0, "", "[[item/39]]은(는) 함선 무력화용 유도 어뢰로, 에너지 100을 빼앗고 피해는 주지 않는다. 사거리가 5,000이라 멀리서 목표를 멈추는 저렴한 수단이다. [[item/40]]은(는) 같은 에너지 흡수에 피해 120을 더한다.", false],
	],
	"item/4": [
		[0, "", "[[item/4]]은(는) 더 강한 [[faction/1|Vossk]] 레이저로, 0.6초마다 피해 10을 준다. 시간당 피해는 [[item/2]]와(과) 거의 정확히 같으며, [[item/3]]보다 한 발이 무겁지만 덜 자주 쏜다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/40": [
		[0, "", "[[item/40]]은(는) 피해 120과 에너지 흡수 100을 하나의 유도 어뢰에 담았으며, 사거리는 5,000, 5초마다 발사한다. 가격은 [[item/39]]의 두 배가 넘는다.", false],
	],
	"item/41": [
		[0, "", "[[item/41]]은(는) 가장 작은 EMP 폭탄이다. 폭탄은 한 번 눌러 발사하고 다시 눌러 터뜨린다. 폭발은 반경 안의 모든 함선에서 에너지를 빼앗으며, 중심에 가까울수록 강하고, 발사한 함선은 영향을 받지 않는다. 소행성에도 영향이 없다. 이 모델은 반경 22,000 안에서 최대 에너지 80을 빼앗는다. [[item/42]]와(과) [[item/43]]은(는) 더 강하고 범위가 넓다.", false],
		[20, "", "[[faction/0|Terran]] 보안 당국은 [[character/0]]이(가) 납치범의 함선을 파괴하지 않고 무력화할 수 있도록 [[station/55]] 정거장에 이 폭탄 10개를 무료로 맡겨 둔다.", false],
	],
	"item/42": [
		[0, "", "[[item/42]]은(는) 반경 30,000 안에서 최대 에너지 150을 빼앗는다. [[item/41]]의 거의 두 배 위력에 폭발 범위도 훨씬 넓다.", false],
	],
	"item/43": [
		[0, "", "[[item/43]]은(는) 가장 강한 EMP 폭탄으로, 반경 37,000 안에서 최대 에너지 300을 빼앗는다. [[item/42]]보다 재충전이 약간 빠르지만 가격은 거의 두 배다.", false],
	],
	"item/44": [
		[0, "", "[[item/44]]은(는) 가장 작은 핵폭탄이다. EMP 폭탄처럼 발사한 뒤 다시 눌러 터뜨리지만, 폭발이 실제 피해를 준다. 반경 20,000 안에서 최대 200이며, 가장자리로 갈수록 줄어든다. 소행성도 부순다. 발사한 함선은 피해를 입지 않는다.", false],
	],
	"item/45": [
		[0, "", "[[item/45]]은(는) 반경 30,000 안에서 최대 피해 560을 주며, [[item/44]]의 거의 세 배 위력에 폭발 범위도 더 넓다.", false],
	],
	"item/46": [
		[0, "", "[[item/46]]은(는) 게임에서 가장 파괴적인 무기로, 반경 40,000 안에서 최대 피해 950을 준다. 완제품으로는 판매되지 않는다. 설계도는 [[station/61]] 정거장의 [[agent/6]]에게서 얻으며, 제작에는 여러 일반 상품 중에서도 방사성 물질과 폭발물이 필요하다.", false],
	],
	"item/47": [
		[0, "", "[[item/47]]은(는) 기본 포탑이다. 포탑은 일부 선체에만 있는 전용 슬롯에 장착되며, 한 바퀴를 모두 돌 수 있어 함선 옆이나 뒤의 목표도 맞힐 수 있다. 포탑을 조준하는 동안 함선은 알아서 계속 비행한다. 이 모델은 사거리 2,000에서 0.3초마다 피해 6을 주며, 느리게 회전한다(기동성 40).", false],
	],
	"item/48": [
		[0, "", "[[item/48]]은(는) 사거리 2,500에서 0.2초마다 피해 10을 주며, [[item/47]]보다 빨리 회전한다(기동성 60). 가격은 세 배가 넘는다.", false],
	],
	"item/49": [
		[0, "", "[[item/49]]은(는) 최고의 포탑으로, 사거리 3,000에서 0.1초마다 피해 12를 주며 회전이 가장 빠르다(기동성 100). 가격도 매우 비싸서 [[item/48]]의 약 두 배다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/5": [
		[0, "", "[[item/5]]은(는) Berger 레이저 계열의 첫 모델로, 이 계열은 연사 속도를 줄이는 대신 한 발이 무겁고 사거리가 약간 길다(2,200). 0.9초마다 피해 8을 주므로 시간당 피해는 더 싼 [[item/2]]보다 낮다. 장점은 더 긴 사거리다.", false],
	],
	"item/50": [
		[0, "", "[[item/50]]은(는) 기본 실드다. 실드는 장갑과 선체보다 먼저 들어오는 피해를 흡수하며, 충전 시간에 걸쳐 저절로 다시 찬다. Targe는 50만 버티지만, 20초 만에 완전히 다시 차서 어떤 실드보다도 빠르다.", false],
	],
	"item/51": [
		[0, "", "[[item/51]]은(는) 80을 버티지만 완전히 다시 차는 데 46초가 걸린다. 한 번의 전투에서는 [[item/50]]보다 많이 흡수하지만, 공격 사이의 회복은 훨씬 느리다.", false],
	],
	"item/52": [
		[0, "", "[[item/52]]은(는) 120을 버티고 58초 만에 다시 차는 [[faction/1|Vossk]] 실드다. [[item/51]]보다 훨씬 많이 흡수하지만, [[item/53]]이(가) 더 많이 버티고 더 빨리 찬다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/53": [
		[0, "", "[[item/53]]은(는) 150을 버티고 45초 만에 다시 차므로, 두 면 모두에서 [[item/52]]보다 낫다. 상점에서 파는 실드 중 최고다.", false],
	],
	"item/54": [
		[0, "", "[[item/54]]은(는) 가장 강한 실드로, 220을 버티며 60초 만에 다시 찬다. 완제품으로는 판매되지 않는다. 설계도는 [[station/72]] 정거장의 [[agent/7]]에게서 얻으며, 제작에는 전자 부품, 나노테크, 마이크로칩과 함께 [[item/163]]이(가) 대량으로 필요하다.", false],
	],
	"item/55": [
		[0, "", "[[item/55]]은(는) 기본 장갑판이다. 장갑판은 함선의 장갑에 자기 수치를 더한다. 실드 다음, 선체보다 먼저 피해를 받으며, 실드와 달리 재충전되지 않는다. E2는 40을 더하는데, 자체 장갑이 100인 [[ship/32]] 같은 가벼운 초보용 함선에는 큰 비중이다.", false],
		[6, "", "해적 은신처 습격 전에 [[character/2]]이(가) [[station/78]] 정거장의 격납고에서 무료로 내주는 세 가지 물품 중 하나로, 나머지는 [[item/0]]와(과) [[item/22]](이)다.", false],
	],
	"item/56": [
		[0, "", "[[item/56]]은(는) 적당한 가격에 장갑 80을 더해 주며, 이는 [[item/55]]의 두 배다.", false],
	],
	"item/57": [
		[0, "", "[[item/57]]은(는) 장갑 110을 더해 준다. [[faction/1|Vossk]] 성계 밖에서 파는 장갑판 중 최고다.", false],
	],
	"item/58": [
		[0, "", "[[item/58]]은(는) 장갑 160을 더해 주는 [[faction/1|Vossk]] 장갑판으로, [[item/57]]보다 훨씬 많다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/59": [
		[0, "", "[[item/59]]은(는) 최고의 장갑판으로, [[ship/9]]의 기본 장갑과 같은 250을 더해 주며, 이는 [[ship/8]]을(를) 제외한 다른 어떤 선체의 기본 장갑보다도 많다. 완제품으로는 판매되지 않는다. 설계도는 [[station/84]] 정거장의 [[agent/8]]에게서 얻으며, 제작에는 일반 상품과 함께 [[item/157]], [[item/168]], [[item/156]]이(가) 필요하다.", false],
	],
	"item/6": [
		[0, "", "[[item/6]]은(는) 사거리 2,200에서 0.8초마다 피해 9를 준다. [[item/5]]보다 조금 나은 정도이며, 가격은 성계마다 거의 차이가 없다.", false],
	],
	"item/60": [
		[0, "", "[[item/60]]은(는) 세 가지 EMP 방호 모듈 중 가장 약하며, EMP 방어 수치는 20이다. 세 모듈 모두 가격이 정해져 있지 않으며, 어떤 상점도 팔지 않는다.", false],
	],
	"item/61": [
		[0, "", "[[item/61]]은(는) 중간급 EMP 방호 모듈로, EMP 방어 수치는 [[item/60]]의 두 배인 40이다. 다른 두 모듈처럼 가격이 없고 상점에서 팔지 않는다.", false],
	],
	"item/62": [
		[0, "", "[[item/62]]은(는) 가장 강한 EMP 방호 모듈로, EMP 방어 수치는 60이다. [[item/60]], [[item/61]]처럼 가격이 없고 상점에서 팔지 않는다.", false],
	],
	"item/63": [
		[0, "", "[[item/63]]은(는) 기본 화물 압축기다. 압축기는 선체 자체 적재량의 일정 비율만큼 화물칸을 늘리며, 이 모델은 15 %를 더한다. 저렴하며 어떤 상인이나 광부에게든 쓸모 있다.", false],
	],
	"item/64": [
		[0, "", "[[item/64]]은(는) 화물칸을 25 % 늘린다. 낮은 가격에 [[item/63]]보다 확실히 낫다.", false],
	],
	"item/65": [
		[0, "", "[[item/65]]은(는) 화물칸을 40 % 늘린다. 대형 화물선에 달면 작은 함선 한 척의 적재량만큼 공간이 늘어난다.", false],
	],
	"item/66": [
		[0, "", "[[item/66]]은(는) 화물칸을 75 % 늘리며, 상점에서 파는 압축기 중 가장 많이 늘린다.", false],
	],
	"item/67": [
		[0, "", "[[item/67]]은(는) 선체 적재량의 100 %를 더해 화물칸을 두 배로 늘린다. [[ship/36]]에 달면 700 t를 싣는다. 완제품으로는 판매되지 않는다. 설계도는 [[station/90]] 정거장의 [[agent/9]]에게서 얻으며, 일반 상품만으로 만든다.", false],
	],
	"item/68": [
		[0, "", "[[item/68]]은(는) 기본 트랙터 빔이다. 트랙터 빔이 없으면 떠다니는 컨테이너를 수거할 수 없으며, 컨테이너로 날아 들어가도 아무 일도 일어나지 않는다. Retractor로는 컨테이너를 조준선 아래에 4초 동안 두면 끌어온다. [[item/69]]은(는) 시간이 덜 걸리고, [[item/70]]은(는) 자동으로 작동한다.", false],
		[24, "", "[[character/6]]은(는) [[faction/9|Void]]에 맞선 첫 원정 전에, Void 함선의 잔해를 수거할 수 있도록 트랙터 빔을 장착하라고 [[character/0]]에게 요청한다. 그때까지 상점에는 평소 품목 외에 Retractor가 들어올 확률이 높다.", false],
	],
	"item/69": [
		[0, "", "[[item/69]]은(는) [[item/68]]처럼 작동하지만, 목표를 조준선 아래에 3초만 두면 컨테이너를 끌어온다.", false],
	],
	"item/7": [
		[0, "", "[[item/7]]은(는) 사거리 2,200에서 0.8초마다 피해 10을 준다. 시간당 피해는 [[item/1]]와(과) 같으므로, 장점은 먼 거리에서 더 적지만 무거운 타격을 준다는 데 있다.", false],
	],
	"item/70": [
		[0, "", "[[item/70]]은(는) 자동 트랙터 빔이다. 조준해서 유지하지 않아도 전방 시야의 컨테이너를 모두 수거하므로, 전장을 약탈할 때 시간을 크게 아낄 수 있다. [[item/69]]보다 훨씬 비싸다.", false],
	],
	"item/71": [
		[0, "", "[[item/71]]은(는) 기본 부스터다. 부스터는 짧은 순간 속도를 더 높여 주고, 그 뒤 재충전 시간이 필요하다. 이 모델은 3초 동안 속도를 60 % 높이며 8초 만에 재충전된다.", false],
	],
	"item/72": [
		[0, "", "[[item/72]]의 사양은 4.4초 동안 속도 80 % 증가, 재충전 10초다. 비행 중 분사의 최고 속도는 [[item/71]]와(과) 같으며, 더해지는 것은 더 긴 분사 시간이다.", false],
	],
	"item/73": [
		[0, "", "[[item/73]]은(는) 더 싼 부스터들의 증가량을 두 배 이상 넘어선다. 5.6초 동안 속도 160 % 증가, 재충전 12초다.", false],
	],
	"item/74": [
		[0, "", "[[item/74]]은(는) 가장 강한 부스터로, 6초 동안 속도를 200 % 높인다. 재충전 시간은 16초로 가장 길다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/75": [
		[0, "", "[[item/75]]은(는) 게임에 하나뿐인 수리 로봇으로, 장비 슬롯에 장착한다. 비행하는 동안 0.6초마다 선체를 1, 1초마다 장갑판을 1 복구하므로, 도킹하지 않아도 전투 사이에 피해가 회복된다. 저렴하며 대부분의 상점에서 판다.", false],
	],
	"item/76": [
		[0, "", "[[item/76]]은(는) 기본 조향 노즐이다. 노즐은 함선의 기동성에 자기 수치를 더해 더 빨리 선회하게 한다. 이 모델은 20을 더하는데, 날렵한 전투기에는 작은 이득이지만 느린 화물선에서는 체감된다.", false],
	],
	"item/77": [
		[0, "", "[[item/77]]은(는) 낮은 가격에 기동성을 40 더해 주며, 이는 [[item/76]]의 두 배다.", false],
	],
	"item/78": [
		[0, "", "[[item/78]]은(는) 기동성을 70 더해 주는 [[faction/1|Vossk]] 노즐이다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/79": [
		[0, "", "[[item/79]]은(는) 기동성을 100 더해 주는 [[faction/1|Vossk]] 노즐로, 대형 화물선도 날렵한 전투기처럼 선회하게 할 수 있다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/8": [
		[0, "", "[[item/8]]은(는) 마지막이자 가장 강한 Berger 레이저로, 사거리 2,200에서 0.9초마다 발당 피해 12를 준다. 발당 위력은 일반 레이저 중 가장 높지만, 더 빠른 [[item/2]]이(가) 여전히 시간당 피해는 더 높다. 그 뒤를 잇는 M6 빔 레이저([[item/9]] 이후)는 발당 위력이 두 배 이상이다.", false],
	],
	"item/80": [
		[0, "", "[[item/80]]은(는) 최고의 조향 노즐로, 기동성을 130 더해 준다. 가장 느리게 선회하는 선체인 [[ship/36]]의 기동성을 45에서 175로 끌어올리며, 이는 노즐 없는 어떤 전투기보다도 높다. 상점에서 보기 드물다.", false],
	],
	"item/81": [
		[0, "", "[[item/81]]은(는) 기본 스캐너다. 스캐너는 함선, 정거장, 소행성 같은 목표를 락온하는 데 걸리는 시간을 정하며, Quickscan은 4초가 걸린다. [[item/82]]은(는) 더 빨리 락온하고 다른 함선의 화물도 보여 준다.", false],
		[2, "", "[[character/2]]의 채굴선인 [[ship/0]]에 하나가 장착되어 있다.", false],
	],
	"item/82": [
		[0, "", "[[item/82]]은(는) 3초 만에 락온하며 목표로 지정한 함선의 화물을 보여 주어, 전리품을 찾을 때 도움이 된다.", false],
	],
	"item/83": [
		[0, "", "[[item/83]]은(는) 1.8초 만에 락온하며(이에 필적하는 것은 [[item/84]]뿐이다), 목표의 화물도 보여 준다.", false],
	],
	"item/84": [
		[0, "", "[[item/84]]은(는) [[item/83]]만큼 빨리 락온하고 화물을 보여 주며, 코어를 얻을 수 있는 유일한 소행성인 A 등급 소행성도 표시한다([[guide/mining]] 참고). 광부에게 가장 좋은 스캐너다.", false],
	],
	"item/85": [
		[0, "", "[[item/85]]은(는) 게임에 하나뿐인 점프 드라이브다. 장착하면 점프 게이트를 거치지 않고 성도에서 곧장 다른 성계의 정거장으로 이동할 수 있다. 일부 임무 중에는 사용할 수 없다. 완제품으로는 판매되지 않으며, 설계도를 파는 에이전트도 없다. 제작에는 대량의 일반 상품과 함께 [[item/164]], [[item/158]], [[item/160]], [[item/163]]이(가) 필요하다.", false],
		[33, "", "발명자 [[character/20]]은(는) 우주 어디든 갈 수 있는 드라이브 연구를 위해 [[character/0]]에게 [[item/164]] 50개를 요청한다.", false],
		[34, "", "크리스털을 받은 대가로 [[character/20]]은(는) [[character/0]]에게 설계도 사본을 준다. 전달한 크리스털 50개는 드라이브 재료로 인정되므로, 나머지 재료만 공급하면 된다.", false],
	],
	"item/86": [
		[0, "", "[[item/86]]은(는) 기본 채굴 레이저다. 소행성에서 광석을 캐려면 채굴 레이저가 필요하다. 산출량은 드릴이 얼마나 안정적으로 방향을 유지하는지를 정하며, 모델마다 고유의 채굴 속도도 있다([[guide/mining]] 참고). 이 모델은 산출량이 30으로, 깊은 층에서 제 궤도를 유지하기 어렵다.", false],
	],
	"item/87": [
		[0, "", "[[item/87]]은(는) 산출량이 50이다. [[item/86]]보다 눈에 띄게 안정적이지만 채굴 속도는 약간 느리다.", false],
	],
	"item/88": [
		[0, "", "[[item/88]]은(는) 산출량 80의 [[faction/1|Vossk]] 채굴 레이저로, 상점에서 파는 드릴 중 가장 안정적이다. 단점은 광석을 캐는 속도가 가장 느리다는 것이다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/89": [
		[0, "", "[[item/89]]은(는) 산출량이 60으로 [[item/88]]보다 덜 안정적이지만, 상점에서 파는 다른 어떤 레이저보다 훨씬 빨리 광석을 캔다. 드릴을 스스로 잘 유지할 수 있는 광부에게 알맞다.", false],
	],
	"item/9": [
		[0, "", "[[item/9]]은(는) M6 빔 레이저의 첫 모델이다. 이 계열은 드물게 쏘지만 매우 강하게 맞힌다. 1.2초마다 피해 27을 주며, 사거리는 2,400으로 이전의 어떤 레이저보다 길다. 빗나가면 긴 재장전 시간을 허비하므로 정확한 조준이 중요하다. [[item/11]]을(를) 만드는 기본 부품이기도 하다.", false],
	],
	"item/90": [
		[0, "", "[[item/90]]은(는) 최고의 채굴 레이저로, 산출량 100에 모든 모델 중 가장 빠른 채굴 속도를 갖췄다. 완제품으로는 판매되지 않는다. 설계도는 [[station/78]] 정거장의 [[agent/11]]에게서 얻으며, 제작에는 대량의 나노테크, 기계 부품, 유압 장치와 함께 [[item/155]], 그리고 [[item/166]] 10개가 필요하다.", false],
		[2, "", "[[character/0]]의 첫 채굴선에 달린 레이저는 [[character/2]]이(가) 손수 만든 이 드릴의 시제품이다.", false],
		[10, "", "[[character/2]]은(는) [[character/0]]에게 [[ship/0]]을(를) 줄 때 단 하나뿐인 시제품은 자신이 가지며, 더 만들어 두었을지 모르니 나중에 들러 보라고 한다.", false],
	],
	"item/91": [
		[0, "", "[[item/91]]은(는) 승객 3명을 태운다. 객실은 [[job/11]] 의뢰에 필요하며, 여러 객실의 공간은 합산된다. [[item/92]]와(과) [[item/93]]은(는) 더 많이 태운다.", false],
	],
	"item/92": [
		[0, "", "[[item/92]]은(는) 승객 5명을 태워, [[item/91]]보다 2명 더 많다.", false],
	],
	"item/93": [
		[0, "", "[[item/93]]은(는) 승객 10명을 태워 [[item/92]]의 두 배이며, 더 큰 승객 의뢰를 맡을 수 있게 한다.", false],
	],
	"item/94": [
		[0, "", "[[item/94]]은(는) 기본 은폐 장치다. 은폐 장치가 작동하는 동안 다른 함선은 나를 볼 수 없다. 이 모델은 15초 동안 함선을 숨기고 재충전에 18초가 필요하다. 은폐 상태로 보낸 시간은 [[medal/19]] 메달에 집계된다.", false],
	],
	"item/95": [
		[0, "", "[[item/95]]은(는) 28초 동안 함선을 숨기고 32초 만에 재충전되는 [[faction/1|Vossk]] 은폐 장치로, [[item/94]]의 거의 두 배 동안 몸을 숨겨 준다. [[faction/1|Vossk]] 성계의 상점에서만 판다.", false],
	],
	"item/96": [
		[0, "", "[[item/96]]은(는) 최고의 은폐 장치로, 46초 동안 함선을 숨기고 재충전은 40초면 끝나 작동하지 않는 시간보다 작동하는 시간이 더 길다. 완제품으로는 판매되지 않는다. 설계도는 [[station/59]] 정거장의 [[agent/10]]에게서 얻는다.", false],
	],
	"job/0": [
		[0, "", "운송 의뢰는 봉인된 화물 컨테이너를 다른 정거장으로 나르는 일입니다. 수락하면 컨테이너가 화물칸에 실리므로 빈 공간이 충분해야 하며, 컨테이너는 팔 수 없습니다. 화물을 실은 채 목적지에 도킹하면 의뢰가 완료됩니다. 해적이 운송 파일럿을 노리고 매복하기도 합니다. 배송한 화물은 [[medal/5]]에 집계됩니다.", false],
	],
	"job/1": [
		[0, "", "방어 의뢰에서는 곧 공격받을 정거장의 전투기들을 도와 습격자를 물리치도록 고용됩니다. 공격자는 대개 해적이며, 아니면 라이벌 종족의 함선입니다. 정거장으로 날아가 모든 공격자를 격파하세요. 아군 전투기의 격추도 인정됩니다. 난이도가 높을수록 공격자가 많아집니다.", false],
	],
	"job/10": [
		[0, "", "차단 의뢰에서는 불법 화물을 실은 화물선 2~3척의 호송대가 정거장에서 멀리 떨어진 곳에 전투기의 호위를 받으며 있습니다. 웨이포인트를 따라가 화물선을 격파하세요. 호위기들은 도중과 호송대 주변에서 기다립니다.", false],
	],
	"job/11": [
		[0, "", "승객 의뢰는 한 무리의 사람들을 다른 정거장으로 태워 가는 일입니다. 수락할 때 모두를 태울 수 있는 객실이 있어야 하며, 승객이 타고 있는 동안에는 객실을 해제하거나 선체를 바꿀 수 없습니다. 목적지에 도킹하면 승객이 내립니다. 기본 보수는 낮지만 승객마다 보수가 더해집니다. 태워 준 승객은 [[medal/18]]에 집계됩니다.", false],
	],
	"job/12": [
		[0, "", "도전은 스페이스 라운지의 다른 파일럿이 제안하는 사격 대결입니다. 두 사람 모두 같은 정거장에서 출발해 경로를 따라 흩어진 해적 무리로 향하며, 더 많이 격추하는 쪽이 이깁니다. 라이벌은 파괴되지 않으며, 내 무기만큼 강하게 공격합니다. 더 많이 격추해야만 보수를 받습니다. 해적은 언제나 홀수이므로 무승부는 없습니다.", false],
	],
	"job/2": [
		[0, "", "보호 의뢰는 정거장 근처 소행성 지대에서 작업하는 채굴선을 지키는 일입니다. 습격자가 나타나 정거장과 채굴선으로 향합니다. 채굴선이 전멸하기 전에 습격자를 모두 격파하세요. 채굴선을 모두 잃으면 의뢰는 실패합니다.", false],
	],
	"job/3": [
		[0, "", "회수 의뢰에서는 정거장 근처 해적선 무리 중 한 척이 도난품을 싣고 있습니다. 컨테이너를 파괴하지 않고 되찾아야 합니다. EMP 무기로 운반선을 무력화하고 트랙터 빔으로 컨테이너를 끌어오세요. 화물을 보여 주는 스캐너가 있으면 맞는 함선을 찾기 쉽습니다. 운반선이 파괴되거나 화물칸에 자리가 없으면 컨테이너를 잃습니다. 컨테이너를 얻으면 의뢰를 맡은 정거장으로 돌아가 보수를 받으세요. 회수는 보수가 두 배입니다.", false],
	],
	"job/4": [
