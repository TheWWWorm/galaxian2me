	],
	"job/5": [
		[0, "", "구출 의뢰는 인질 구조입니다. 정거장 근처 함선 무리 중 한 척에 인질이 붙잡혀 있습니다. 회수 의뢰처럼 EMP로 납치범의 함선을 무력화하고 트랙터 빔으로 인질을 태우세요. 그 함선을 파괴하면 의뢰가 끝납니다. 그런 다음 의뢰를 수락한 정거장으로 인질을 데려가세요. 구출은 보수가 두 배입니다.", false],
	],
	"job/6": [
