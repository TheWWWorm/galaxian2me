		[0, "", "[[item/20]]は0.2秒ごとに13ダメージを与えます。時間あたりのダメージは[[item/19]]を上回りますが、射程は1,000しかないため、近距離で最も効果を発揮します。", false],
	],
	"item/21": [
		[0, "", "[[item/21]]は0.2秒ごとに14ダメージで、前方の砲の中で時間あたりのダメージが最も高い武器です。[[item/20]]と同様に射程は1,000しかありません。ショップで最も見かけないブラスターでもあります。", false],
	],
	"item/22": [
		[0, "", "[[item/22]]はゲーム中最も弱い砲で、0.4秒ごとに2ダメージ、射程1,000です。オートキャノンは小さな弾を素早く撃ち出し、1発は軽いものの、非常に速く撃てるモデルもあります。この最初のモデルは間に合わせにすぎません。", false],
		[6, "", "海賊の隠れ家を襲撃する前に、[[character/2]]が[[station/78]]のハンガーで無料で提供する3つの品物の一つで、ほかの2つは[[item/0]]と[[item/55]]です。", false],
	],
	"item/23": [
		[0, "", "[[item/23]]は[[item/22]]の2倍となる1発4ダメージで、発射もわずかに速く（0.3秒ごと）、射程は1,000のままです。序盤向けの安価な武器です。", false],
	],
	"item/24": [
		[0, "", "[[item/24]]は0.3秒ごとに6ダメージ、射程1,200です。堅実な中級のオートキャノンで、時間あたりのダメージは射程の長い[[item/25]]と同等です。", false],
	],
	"item/25": [
		[0, "", "[[item/25]]は0.4秒ごとに8ダメージ、射程1,400で、オートキャノンの中で最も射程が長い武器です。時間あたりのダメージは[[item/24]]と同じです。完成品として販売されることはありません。設計図は[[station/20]]の[[agent/2]]から入手でき、鉱石を使わず一般商品だけで製造できます。", false],
	],
	"item/26": [
		[0, "", "[[item/26]]は0.2秒ごとに5ダメージ、射程1,000です。連射が速いため、射程と引き換えに、レールガンより時間あたりのダメージが高くなっています。", false],
	],
	"item/27": [
		[0, "", "[[item/27]]は0.1秒ごとに発射し、これはオートキャノンで最も速い連射速度で、1発6ダメージです。時間あたりのダメージは最高クラスのブラスターに近いものの、射程900はどの砲よりも短くなっています。完成品として販売されることはありません。設計図は[[station/10]]の[[agent/3]]から入手でき、製造にはほかの商品とともに[[item/154]]が必要です。", false],
	],
	"item/28": [
		[0, "", "[[item/28]]は最初のサーマルガンです。サーマルガンは射程1,000で軽い弾を素早く撃ち、このモデルは0.3秒ごとに3ダメージです。テックレベルは高いものの、時間あたりのダメージは中級のブラスターやオートキャノンの多くより劣ります。", false],
	],
	"item/29": [
		[0, "", "[[item/29]]は0.2秒ごとに4ダメージ、射程1,000で、時間あたりのダメージは[[item/28]]の2倍です。", false],
	],
	"item/3": [
		[0, "", "[[item/3]]は[[faction/1|Vossk]]のレーザーで、0.5秒ごとに7ダメージを与えます。1発あたりは[[item/2]]と同じですが、発射がわずかに遅いため、時間あたりではわずかに劣ります。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
		[0, "", "オープニングシーンの[[character/0]]の[[ship/10]]は、これを2基装備しています。", false],
	],
	"item/30": [
		[0, "", "[[item/30]]は0.1秒ごとに3ダメージで、サーマルガンの中で最も速く撃てます。時間あたりのダメージは[[item/29]]を上回りますが、[[item/21]]などの最上位のブラスターには及びません。", false],
	],
	"item/31": [
		[0, "", "[[item/31]]は基本型の[[faction/1|Vossk]]ロケットで、最も安いサブ武器の弾薬です。命中1回で60ダメージ、1.2秒ごとに1発、射程1,200。ロケットは直進し、標的を追尾しないので、近距離で最も効果を発揮します。小惑星に命中したロケットや魚雷は、小惑星を粉砕します。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/32": [
		[0, "", "[[item/32]]は一般的な無誘導ロケットで、命中1回で70ダメージ、0.9秒ごとに1発、射程1,200です。[[item/31]]より威力が高く発射も速く、広く販売されています。", false],
	],
	"item/33": [
		[0, "", "[[item/33]]は72ダメージを与えると同時にエネルギーを34削るので、標的にダメージを与えつつ無力化の助けにもなります。再装填は遅く（2秒）、射程は1,000です。完成品として販売されることはありません。設計図は[[station/43]]の[[agent/4]]から入手でき、1回の生産に必要なのは安価な一般商品が少しだけです。", false],
	],
	"item/34": [
		[0, "", "[[item/34]]は撃破ではなく無力化のためのもので、命中1回でエネルギーを45削り、ダメージは10しか与えません。1秒ごとに1発発射します。[[item/35]]はより多く削り、ダメージも大きくなります。", false],
	],
	"item/35": [
		[0, "", "[[item/35]]は命中1回でエネルギーを60削り、30ダメージを与えます。1秒ごとに1発、射程1,000です。[[item/34]]より速く船を無力化しつつ、船体も削っていきます。", false],
	],
	"item/36": [
		[0, "", "[[item/36]]は基本型の魚雷です。魚雷は最初の1.5秒間は直進し、その後標的を追尾します。[[item/36]]は70ダメージ、射程3,000ですが、弾速が遅く、3秒ごとにしか発射できません。[[item/38]]はその2倍のダメージを与えます。", false],
	],
	"item/37": [
		[0, "", "[[item/37]]は最も速い魚雷で、100ダメージを与え、エネルギーを50削り、射程は4,000です。4秒ごとに1発発射します。完成品として販売されることはありません。設計図は[[station/54]]の[[agent/5]]から入手でき、1回の生産に必要なのは一般商品が少しだけです。", false],
	],
	"item/38": [
		[0, "", "[[item/38]]は最も威力の高い魚雷で、命中1回で140ダメージ、射程4,000です。飛行速度は遅く、4秒ごとに1発発射します。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/39": [
		[0, "", "[[item/39]]は船を無力化するための誘導魚雷で、エネルギーを100削り、ダメージは与えません。射程5,000で、遠くから標的を止める安価な手段です。[[item/40]]は同じエネルギー削減量に120ダメージを加えます。", false],
	],
	"item/4": [
		[0, "", "[[item/4]]は強化型の[[faction/1|Vossk]]レーザーで、0.6秒ごとに10ダメージです。時間あたりのダメージは[[item/2]]とほぼ同じで、[[item/3]]より1発が重く、発射頻度は低めです。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/40": [
		[0, "", "[[item/40]]は1発の誘導魚雷で120ダメージと100ポイントのエネルギー削減を兼ね備え、射程5,000、5秒ごとに1発発射します。価格は[[item/39]]の2倍以上です。", false],
	],
	"item/41": [
		[0, "", "[[item/41]]は最小のEMP爆弾です。爆弾は1回押すと発射され、もう1回押すと起爆します。爆風は半径内のすべての船のエネルギーを削り、中心に近いほど強く作用しますが、発射した船自身は影響を受けません。小惑星にも影響はありません。このモデルは半径22,000内でエネルギーを最大80削ります。[[item/42]]と[[item/43]]はより強力で範囲も広くなります。", false],
		[20, "", "[[faction/0|Terran]]の保安部門は、[[character/0]]が誘拐犯の船を撃破せずに無力化できるよう、この爆弾10個を[[station/55]]に無料で用意します。", false],
	],
	"item/42": [
		[0, "", "[[item/42]]は半径30,000内でエネルギーを最大150削ります。[[item/41]]のほぼ2倍の強さで、爆風の範囲もはるかに広くなっています。", false],
	],
	"item/43": [
		[0, "", "[[item/43]]は最強のEMP爆弾で、半径37,000内でエネルギーを最大300削ります。[[item/42]]よりわずかに再充電が速いものの、価格はほぼ2倍です。", false],
	],
	"item/44": [
		[0, "", "[[item/44]]は最小の核爆弾です。EMP爆弾と同様に発射してからもう1回押して起爆しますが、爆風は実際のダメージを与えます。半径20,000内で最大200ダメージで、端に行くほど弱くなります。小惑星も破壊します。発射した船は被害を受けません。", false],
	],
	"item/45": [
		[0, "", "[[item/45]]は半径30,000内で最大560ダメージを与えます。[[item/44]]のほぼ3倍の威力で、爆風も広くなっています。", false],
	],
	"item/46": [
		[0, "", "[[item/46]]はゲーム中最も破壊力のある武器で、半径40,000内で最大950ダメージを与えます。完成品として販売されることはありません。設計図は[[station/61]]の[[agent/6]]から入手でき、製造にはほかの一般商品とともに放射性物質と爆薬が必要です。", false],
	],
	"item/47": [
		[0, "", "[[item/47]]は基本型の砲塔です。砲塔は一部の船体にしかない専用のスロットに取り付け、一周旋回できるので、船の横や後ろの標的も撃てます。照準している間、船は自動で飛び続けます。このモデルは0.3秒ごとに6ダメージ、射程2,000で、旋回は遅め（機動性40）です。", false],
	],
	"item/48": [
		[0, "", "[[item/48]]は0.2秒ごとに10ダメージ、射程2,500で、[[item/47]]より速く旋回します（機動性60）。価格は3倍以上です。", false],
	],
	"item/49": [
		[0, "", "[[item/49]]は最高の砲塔で、0.1秒ごとに12ダメージ、射程3,000、旋回も最も速い（機動性100）モデルです。非常に高価でもあり、価格は[[item/48]]の約2倍です。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/5": [
		[0, "", "[[item/5]]はBergerレーザーシリーズの最初のモデルで、連射速度を犠牲にして1発の威力とわずかに長い射程（2,200）を得ています。0.9秒ごとに8ダメージで、時間あたりのダメージはより安い[[item/2]]を下回ります。利点は射程の長さです。", false],
	],
	"item/50": [
		[0, "", "[[item/50]]は基本型のシールドです。シールドは装甲や船体より先に受けたダメージを吸収し、充電時間をかけて自動的に回復します。Targeの容量は50ポイントしかありませんが、20秒で完全に回復し、これはほかのどのシールドよりも速い値です。", false],
	],
	"item/51": [
		[0, "", "[[item/51]]の容量は80ポイントですが、完全に回復するまで46秒かかります。1回の戦闘では[[item/50]]より多く吸収できますが、攻撃の合間の回復ははるかに遅くなります。", false],
	],
	"item/52": [
		[0, "", "[[item/52]]は[[faction/1|Vossk]]のシールドで、容量120ポイント、回復時間58秒です。[[item/51]]よりはるかに多く吸収できますが、[[item/53]]のほうが容量が多く回復も速くなっています。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/53": [
		[0, "", "[[item/53]]は容量150ポイント、回復時間45秒で、どちらの点でも[[item/52]]を上回ります。ショップで販売されている最高のシールドです。", false],
	],
	"item/54": [
		[0, "", "[[item/54]]は最強のシールドで、容量220ポイント、回復時間60秒です。完成品として販売されることはありません。設計図は[[station/72]]の[[agent/7]]から入手でき、製造には大量の[[item/163]]と、電子機器、ナノテク、マイクロチップが必要です。", false],
	],
	"item/55": [
		[0, "", "[[item/55]]は基本型の装甲板です。装甲板はそのポイントを船の装甲に加えます。シールドの次、船体より先にダメージを受け、シールドと違って回復しません。E2は40ポイントを加えます。これは自前の装甲が100の[[ship/32]]のような軽い初期の船にとって大きな割合です。", false],
		[6, "", "海賊の隠れ家を襲撃する前に、[[character/2]]が[[station/78]]のハンガーで無料で提供する3つの品物の一つで、ほかの2つは[[item/0]]と[[item/22]]です。", false],
	],
	"item/56": [
		[0, "", "[[item/56]]は装甲を80ポイント加えます。[[item/55]]の2倍で、価格は手頃です。", false],
	],
	"item/57": [
		[0, "", "[[item/57]]は装甲を110ポイント加えます。[[faction/1|Vossk]]星系以外で販売されている最高の装甲板です。", false],
	],
	"item/58": [
		[0, "", "[[item/58]]は[[faction/1|Vossk]]の装甲板で、装甲を160ポイント加え、[[item/57]]を大きく上回ります。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/59": [
		[0, "", "[[item/59]]は最高の装甲板で、250ポイントを加えます。これは[[ship/9]]の基本装甲と同じで、[[ship/8]]を除くどの船体の装甲よりも多い値です。完成品として販売されることはありません。設計図は[[station/84]]の[[agent/8]]から入手でき、製造には一般商品とともに[[item/157]]、[[item/168]]、[[item/156]]が必要です。", false],
	],
	"item/6": [
		[0, "", "[[item/6]]は0.8秒ごとに9ダメージ、射程2,200です。[[item/5]]からのささやかな強化で、価格は星系によってほとんど変わりません。", false],
	],
	"item/60": [
		[0, "", "[[item/60]]は3種類あるEMP防護モジュールのうち最も弱いもので、EMP防御は20です。3種類とも価格が設定されておらず、どのショップにも置かれていません。", false],
	],
	"item/61": [
		[0, "", "[[item/61]]は中位のEMP防護モジュールで、EMP防御は[[item/60]]の2倍の40です。同系統の品と同様に価格が設定されておらず、ショップには置かれていません。", false],
	],
	"item/62": [
		[0, "", "[[item/62]]は最強のEMP防護モジュールで、EMP防御は60です。[[item/60]]や[[item/61]]と同様に価格が設定されておらず、ショップには置かれていません。", false],
	],
	"item/63": [
		[0, "", "[[item/63]]は基本型の積荷圧縮装置です。圧縮装置は船体自体の積載量の一定割合だけ積荷室を広げ、このモデルは15 %を加えます。安価で、商人にも採掘者にも価値があります。", false],
	],
	"item/64": [
		[0, "", "[[item/64]]は積荷室を25 %広げます。安い価格で[[item/63]]から明確に強化されています。", false],
	],
	"item/65": [
		[0, "", "[[item/65]]は積荷室を40 %広げます。大型貨物船では、小型船1隻分の積載量に匹敵する空間が加わります。", false],
	],
	"item/66": [
		[0, "", "[[item/66]]は積荷室を75 %広げ、ショップで販売されている圧縮装置の中で最大です。", false],
	],
	"item/67": [
		[0, "", "[[item/67]]は船体の積載量の100 %を加えて積荷室を2倍にします。[[ship/36]]なら700 tを積めるようになります。完成品として販売されることはありません。設計図は[[station/90]]の[[agent/9]]から入手でき、一般商品だけで製造できます。", false],
	],
	"item/68": [
		[0, "", "[[item/68]]は基本型のトラクタービームです。トラクタービームがなければ、漂うコンテナは回収できません。コンテナに飛び込んでも何も起こりません。Retractorでは、コンテナを照準に4秒間捉え続けると引き寄せられます。[[item/69]]は必要な時間が短く、[[item/70]]は自動で動作します。", false],
		[24, "", "[[character/6]]は、[[faction/9|ヴォイド]]に対する最初の遠征の前に、艦船の残骸を回収できるようトラクタービームを装備するよう[[character/0]]に求めます。それまでの間、ショップでは通常の品揃えに加えてRetractorが入荷する可能性が高くなっています。", false],
	],
	"item/69": [
		[0, "", "[[item/69]]は[[item/68]]と同じように動作しますが、コンテナを引き寄せるまでに照準に捉える時間は3秒で済みます。", false],
	],
	"item/7": [
		[0, "", "[[item/7]]は0.8秒ごとに10ダメージ、射程2,200です。時間あたりのダメージは[[item/1]]と同等なので、価値は遠距離から少数の重い一撃を与えられる点にあります。", false],
	],
	"item/70": [
		[0, "", "[[item/70]]は自動式のトラクタービームで、照準を合わせて保持しなくても、前方の視界にあるコンテナをすべて回収します。戦場で戦利品を集めるときに大幅な時間の節約になります。[[item/69]]よりはるかに高価です。", false],
	],
	"item/71": [
		[0, "", "[[item/71]]は基本型のブースターです。ブースターは短時間の加速を与え、その後は再充電の時間が必要です。このモデルは3秒間速度を60 %上げ、8秒で再充電されます。", false],
	],
	"item/72": [
		[0, "", "[[item/72]]の性能値は、4.4秒間80 %の加速、再充電10秒です。飛行中の加速の最高速度は[[item/71]]と同じで、違いは加速が長く続くことです。", false],
	],
	"item/73": [
		[0, "", "[[item/73]]は安価なブースターの2倍以上の効果があり、5.6秒間160 %の加速、再充電12秒です。", false],
	],
	"item/74": [
		[0, "", "[[item/74]]は最強のブースターで、6秒間200 %の加速です。再充電は最も長く16秒かかります。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/75": [
		[0, "", "[[item/75]]はゲーム中唯一の修理ボットで、装備スロットに取り付けます。飛行中、0.6秒ごとに船体を1ポイント、1秒ごとに装甲板を1ポイント回復するので、ドッキングしなくても戦闘の合間に損傷が回復していきます。安価で、ほとんどのショップに置かれています。", false],
	],
	"item/76": [
		[0, "", "[[item/76]]は基本型のステアリングノズルです。ノズルはその数値を船の機動性に加え、船がより速く旋回できるようにします。このモデルは20を加えます。機敏な戦闘機にはわずかな向上ですが、鈍い貨物船でははっきりと違いがわかります。", false],
	],
	"item/77": [
		[0, "", "[[item/77]]は機動性を40加えます。[[item/76]]の2倍で、価格は安価です。", false],
	],
	"item/78": [
		[0, "", "[[item/78]]は[[faction/1|Vossk]]のノズルで、機動性を70加えます。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/79": [
		[0, "", "[[item/79]]は[[faction/1|Vossk]]のノズルで、機動性を100加えます。大型貨物船でも機敏な戦闘機のように旋回できるほどです。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/8": [
		[0, "", "[[item/8]]は最後にして最強のBergerレーザーで、0.9秒ごとに1発12ダメージ、射程2,200です。従来型のレーザーとしては1発の威力が最も高いものの、連射の速い[[item/2]]のほうが時間あたりのダメージは上です。これに続くM6ビームレーザー（[[item/9]]以降）は、1発の威力が2倍以上あります。", false],
	],
	"item/80": [
		[0, "", "[[item/80]]は最高のステアリングノズルで、機動性を130加えます。最も旋回の遅い船体である[[ship/36]]でも45から175に上がり、ノズルなしのどの戦闘機よりも高くなります。ショップではめったに見かけません。", false],
	],
	"item/81": [
		[0, "", "[[item/81]]は基本型のスキャナーです。スキャナーは、船、ステーション、小惑星などの対象をロックするのにかかる時間を決めます。Quickscanは4秒かかります。[[item/82]]はより速くロックでき、ほかの船の積荷も表示します。", false],
		[2, "", "[[character/2]]の採掘船[[ship/0]]には、これが最初から装備されています。", false],
	],
	"item/82": [
		[0, "", "[[item/82]]は3秒でロックし、ターゲットにした船の積荷を表示するので、戦利品を探すときに役立ちます。", false],
	],
	"item/83": [
		[0, "", "[[item/83]]は1.8秒でロックし、このロック時間に並ぶのは[[item/84]]だけです。ターゲットの積荷も表示します。", false],
	],
	"item/84": [
		[0, "", "[[item/84]]は[[item/83]]と同じ速さでロックして積荷を表示し、さらにコアを産出できる唯一の小惑星であるクラスAの小惑星に印を付けます（[[guide/mining]]を参照）。採掘者に最適なスキャナーです。", false],
	],
	"item/85": [
		[0, "", "[[item/85]]はゲーム中唯一のジャンプドライブです。これを装備すると、ジャンプゲートを通らずに、星図から別の星系のステーションへ直接移動できます。一部のミッション中は使えません。完成品として販売されることはなく、設計図を売るエージェントもいません。製造には大量の一般商品とともに、[[item/164]]、[[item/158]]、[[item/160]]、[[item/163]]が必要です。", false],
		[33, "", "その発明者[[character/20]]は、宇宙のどこへでも行けるドライブの研究のため、[[item/164]]を50個持ってきてほしいと[[character/0]]に頼みます。", false],
		[34, "", "結晶の見返りとして、[[character/20]]は[[character/0]]に設計図の写しを渡します。届けた50個の結晶はドライブの材料として計上されるので、残りの材料だけを用意すれば済みます。", false],
	],
	"item/86": [
		[0, "", "[[item/86]]は基本型の採掘レーザーです。採掘レーザーは小惑星から鉱石を掘り出すのに必要です。採掘量（yield）はドリルがどれだけ安定して進路を保つかを決め、モデルごとに固有の掘削速度もあります（[[guide/mining]]を参照）。このモデルの採掘量は30で、深い層では進路を保つのが困難です。", false],
	],
	"item/87": [
		[0, "", "[[item/87]]の採掘量は50です。[[item/86]]より目に見えて安定していますが、掘削はわずかに遅くなります。", false],
	],
	"item/88": [
		[0, "", "[[item/88]]は[[faction/1|Vossk]]の採掘レーザーで、採掘量は80と、ショップで販売されているドリルの中で最も安定しています。欠点は鉱石の抽出が最も遅いことです。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/89": [
		[0, "", "[[item/89]]の採掘量は60で、[[item/88]]ほど安定していませんが、ショップで販売されているほかのどのレーザーよりもはるかに速く鉱石を抽出します。自力でドリルの進路を保てる採掘者に向いています。", false],
	],
	"item/9": [
		[0, "", "[[item/9]]はM6ビームレーザーの最初のモデルです。M6は発射頻度が低い代わりに非常に強力で、1.2秒ごとに27ダメージ、射程2,400はそれまでのどのレーザーよりも長くなっています。外すと長い再装填が無駄になるため、正確な照準が重要です。[[item/11]]を製造する際の基本部品でもあります。", false],
	],
	"item/90": [
		[0, "", "[[item/90]]は最高の採掘レーザーで、採掘量100、掘削速度もすべてのモデルの中で最速です。完成品として販売されることはありません。設計図は[[station/78]]の[[agent/11]]から入手でき、製造には大量のナノテク、機械部品、油圧装置に加え、[[item/155]]と[[item/166]]10個が必要です。", false],
		[2, "", "[[character/0]]の最初の採掘船に付いていたレーザーは、[[character/2]]が手作りしたこのドリルの試作品です。", false],
		[10, "", "[[character/2]]は[[character/0]]に[[ship/0]]を譲るとき、唯一の試作品を手元に残し、もっと作っているかもしれないから後でまた来るよう勧めます。", false],
	],
	"item/91": [
		[0, "", "[[item/91]]は乗客3人を収容します。キャビンは[[job/11]]の依頼に必要で、複数のキャビンの定員は合算されます。[[item/92]]と[[item/93]]はより多く収容できます。", false],
	],
	"item/92": [
		[0, "", "[[item/92]]は乗客5人を収容し、[[item/91]]より2人多くなります。", false],
	],
	"item/93": [
		[0, "", "[[item/93]]は乗客10人を収容し、[[item/92]]の2倍です。これでより大規模な乗客輸送の依頼を受けられるようになります。", false],
	],
	"item/94": [
		[0, "", "[[item/94]]は基本型のクロークです。クロークが作動している間、ほかの船からはあなたが見えません。このモデルは15秒間船を隠し、その後18秒の再充電が必要です。クローク状態で過ごした時間は[[medal/19]]のメダルにカウントされます。", false],
	],
	"item/95": [
		[0, "", "[[item/95]]は[[faction/1|Vossk]]のクロークで、28秒間船を隠し、32秒で再充電されます。[[item/94]]のほぼ2倍の時間隠れていられます。[[faction/1|Vossk]]星系のショップにしか置かれていません。", false],
	],
	"item/96": [
		[0, "", "[[item/96]]は最高のクロークで、46秒間船を隠し、再充電はわずか40秒なので、作動している時間のほうが長くなります。完成品として販売されることはありません。設計図は[[station/59]]の[[agent/10]]から入手できます。", false],
	],
	"job/0": [
		[0, "", "配達の依頼では、封印された貨物コンテナを別のステーションまで運びます。コンテナは引き受けたときに積荷室に積まれるので、十分な空きが必要です。コンテナは売却できません。貨物を積んだまま目的地にドッキングすれば完了です。配達人を海賊が待ち伏せしていることもあります。届けた貨物は[[medal/5]]にカウントされます。", false],
	],
	"job/1": [
		[0, "", "防衛の依頼では、ステーションが攻撃を受けようとしており、あなたはステーション自身の戦闘機とともに襲撃者を追い払うために雇われます。攻撃者はたいてい海賊で、そうでなければ敵対種族の船です。ステーションへ飛び、すべての攻撃者を撃破してください。味方の戦闘機による撃墜もカウントされます。難しい依頼ほど攻撃者が多くなります。", false],
	],
	"job/10": [
		[0, "", "迎撃の依頼では、違法な積荷を運ぶ2～3隻の貨物船の船団が、戦闘機に守られてステーションから遠く離れた場所にいます。ウェイポイントをたどり、貨物船を撃破してください。護衛は道中と船団の周囲で待ち構えています。", false],
	],
	"job/11": [
		[0, "", "乗客輸送の依頼では、人々の一団を別のステーションまで運びます。引き受けるときには全員が乗れるだけのキャビンが必要です。乗客が乗っている間はキャビンを取り外せず、船体も変更できません。目的地にドッキングすれば送り届けたことになります。基本報酬は低めですが、乗客1人ごとに加算されます。送り届けた乗客は[[medal/18]]にカウントされます。", false],
	],
	"job/12": [
		[0, "", "チャレンジは、スペースラウンジでほかのパイロットが持ちかけてくる射撃勝負です。2人とも同じステーションから出発し、ルート沿いに散らばった海賊の一団へ向かい、より多く撃墜した方の勝ちです。ライバルは撃破できず、あなた自身の砲と同じ威力で攻撃します。報酬が支払われるのは撃墜数で上回った場合だけです。海賊の数は常に奇数なので、引き分けはありません。", false],
	],
	"job/2": [
		[0, "", "警護の依頼では、ステーション近くの小惑星帯で作業する採掘船を守ります。襲撃者が現れ、ステーションと採掘船へ向かってきます。採掘船が全滅させられる前に、すべての襲撃者を撃破してください。採掘船がすべて失われると依頼は失敗です。", false],
	],
	"job/3": [
		[0, "", "回収の依頼では、盗まれた品物がステーション近くの海賊船団のうち1隻で運ばれています。コンテナを壊さずに取り戻さなければなりません。運搬船をEMP兵器で無力化し、トラクタービームでコンテナを引き寄せます。積荷を表示するスキャナーがあれば、目当ての船を見つけやすくなります。運搬船が撃破されたり、積荷室に空きがなかったりすると、コンテナは失われます。手に入れたら、依頼を受けたステーションに戻って報酬を受け取ります。回収の報酬は2倍です。", false],
	],
	"job/4": [
		[0, "", "海賊狩りとは、ステーション近くの海賊の隠れ家を一掃することです。海賊は小惑星帯か、2～3か所のウェイポイントからなるルート上で待ち構えており、あなたの姿を見て初めて動き出します。ウェイポイントをたどり、すべての海賊を撃破してください。難易度が高いほど海賊が多くなります。", false],
	],
	"job/5": [
		[0, "", "救出の依頼は人命救助です。ステーション近くの船団のうち1隻に人質が捕らわれています。回収の依頼と同様に、誘拐犯の船をEMPで無力化し、トラクタービームで人質を収容します。その船を撃破すると依頼は終了します。その後、依頼を受けたステーションまで人質を連れ帰ってください。救出の報酬は2倍です。", false],
	],
	"job/6": [
		[0, "", "指名手配の依頼では、ステーションの近くで目撃された危険な犯罪者が指名されます。標的は遠く離れた地点で待っており、あなたが視界に入って初めて反応します。普通の海賊よりはるかに手強く、依頼の難易度とあなたのパイロットレベルに応じてさらに手強くなります。撃破すれば賞金を受け取れます。", false],
	],
	"job/7": [
		[0, "", "ジャンク除去の依頼では、ステーション近くの宇宙ゴミの群れを約2分以内に片付けます。時間切れになる前にすべての破片を破壊しなければなりません。難易度が高いと海賊も何隻か加わります。報酬は大半の依頼より少なめですが、すぐに終わり、破壊したジャンクは[[medal/10]]にカウントされます。", false],
	],
	"job/8": [
		[0, "", "購入依頼は、ある特定の品物を一定量求めるスペースラウンジの買い手から提示されます。ショップ、商人、採掘などで品物を手に入れ、積荷室に入れた状態で買い手のステーションに再びドッキングします。品物が引き渡され、通常の依頼報酬の半額に品物の平均価格の3倍を加えた額が支払われるので、買い手はたいていどのショップよりもはるかに高く買ってくれます。買い手は[[step/16]]以降に現れます。", false],
	],
	"job/9": [
		[0, "", "護衛の依頼では、ステーション近くで5隻の貨物船からなる輸送船団を守ります。貨物船が進むにつれ、ルート沿いで待ち構えていた攻撃者が迫ってきます。すべての攻撃者を撃破してください。貨物船がすべて失われると依頼は失敗です。護衛の報酬は大半の依頼より5分の1多くなります。", false],
	],
	"medal/0": [
		[0, "", "[[character/0]]は過去の軍功により、ゲーム開始時からこのメダルを所持しています。獲得のためにすることは何もありません。", false],
	],
	"medal/1": [
		[0, "", "船体がほとんど残っていない状態でステーションに到着すると授与されます。判定は接近時、ドッキングによる修理の前に行われ、装甲板ではなく船体そのものの強度が使われます。残りの割合が低いほど、上の段階になります。", false],
	],
	"medal/10": [
		[0, "", "[[job/7]]の依頼に出てくるような宇宙ゴミを破壊すると授与されます。撃った破片はすべてカウントされます。", false],
	],
	"medal/11": [
		[0, "", "ドッキングした異なるステーションの数に応じて授与されます。", false],
	],
	"medal/12": [
		[0, "", "訪れた異なる星系の数に応じて授与されます。隠された星系も、到達すればカウントされます。", false],
	],
	"medal/13": [
		[0, "", "所有している設計図の数に応じて授与されます。設計図はスペースラウンジのエージェントから購入します。[[guide/blueprints]]を参照してください。", false],
	],
	"medal/14": [
		[0, "", "1回以上完成させた異なる設計図の数に応じて授与されます。同じアイテムをもう一度製造しても増えません。", false],
	],
	"medal/15": [
		[0, "", "プレイ時間（時間単位）に応じて授与されます。カウントされるのは飛行中の時間です。", false],
	],
	"medal/16": [
		[0, "", "達成したフリーランスの依頼の数に応じて授与されます。失敗した依頼や放棄した依頼はカウントされません。", false],
	],
	"medal/17": [
		[0, "", "ジャンプゲートを通過した回数に応じて授与されます。ジャンプドライブによるジャンプはカウントされません。", false],
	],
	"medal/18": [
		[0, "", "[[job/11]]の依頼で送り届けた乗客の数に応じて授与されます。キャビンの容量が大きいほど、大きなグループを運べます。", false],
	],
	"medal/19": [
		[0, "", "クローク状態で過ごした合計時間（分）に応じて授与されます。クローキング装置を装備し、充電されるたびに使いましょう。", false],
	],
	"medal/2": [
		[0, "", "異なる種類の鉱石を採掘すると授与されます。各種類は、どれだけ採掘しても1回としてカウントされます。小惑星帯には原産地が近い鉱石があるので、銀河のいくつもの地域で採掘する必要があります。", false],
	],
	"medal/20": [
		[0, "", "発射したEMP爆弾と核兵器の数に応じて授与されます。", false],
	],
	"medal/21": [
		[0, "", "残骸や無力化した船からトラクタービームで回収した[[item/131]]のトン数に応じて授与されます。", false],
	],
	"medal/22": [
		[0, "", "武器を一切装備せずに、または装備品を一切装備せずに飛行すると授与される1段階のみのメダルで、次のドッキング時に判定されます。物語の序盤では獲得できません。[[step/8]]までは船は常に武装しているものとみなされます。", false],
	],
	"medal/23": [
		[0, "", "同時に装備しているメイン武器の数に応じて授与され、ドッキング時に判定されます。上の段階には、メイン武器スロットの多い船体が必要です。[[medal/22]]と同様に、カウントされるのは[[step/8]]以降です。", false],
	],
	"medal/24": [
		[0, "", "残骸や無力化した船からトラクタービームで回収した積荷のトン数に応じて授与されます。", false],
	],
	"medal/25": [
		[0, "", "一度に所持したクレジットの最高額に応じて授与されます。後でお金を使っても減りません。", false],
	],
	"medal/26": [
		[0, "", "提示を持っているスペースラウンジの客と話すと授与されます。各客は、初めて話しかけたときに1回カウントされます。", false],
	],
	"medal/27": [
		[0, "", "スペースラウンジで雇ったウィングマンの数に応じて授与され、各グループのパイロット全員がカウントされます。", false],
	],
	"medal/28": [
		[0, "", "2つの評判の尺度のいずれかをどちらかの方向に60より先へ傾け、四大種族のいずれかを敵に回すと授与される1段階のみのメダルです。[[guide/combat]]を参照してください。", false],
	],
	"medal/29": [
		[0, "", "武器で破壊した小惑星の数に応じて授与されます。採掘で砕けた小惑星はカウントされません。", false],
	],
	"medal/3": [
		[0, "", "異なる種類のコアを採掘すると授与されます。コアはクラスAの小惑星の7層すべてを掘り抜いたときにしか手に入らないため、移動に加えて忍耐と良い採掘レーザーが必要です。", false],
	],
	"medal/30": [
		[0, "", "物語をクリアすると授与される1段階のみのメダルです。", false],
	],
	"medal/31": [
		[0, "", "一度に確保した積荷室の空き容量の最大値に応じて授与されます。積荷圧縮装置を付けた大型の船体で積荷室を空にすれば、上の段階を獲得できます。", false],
	],
	"medal/32": [
		[0, "", "スペースラウンジで「No, thanks」で断った提示の数に応じて授与されます。", false],
	],
	"medal/33": [
		[0, "", "スペースラウンジの客に「How was that again?」で提示の繰り返しを頼んだ回数に応じて授与されます。", false],
	],
	"medal/34": [
		[0, "", "ほかのステーションでの依頼を、難しいかどうか依頼人に尋ねずに引き受けると授与されます。", false],
	],
	"medal/35": [
		[0, "", "ほかのステーションでの依頼を、目的地をマップで見せてもらわずに引き受けると授与されます。", false],
	],
	"medal/36": [
		[0, "", "ほかのすべてのメダルを、段階を問わず所持すると自動的に授与されます。すべてを所持するとほかの特典もあります。[[guide/medals]]を参照してください。", false],
	],
	"medal/4": [
		[0, "", "撃破した船の数に応じて授与され、ゲーム全体を通じてカウントされます。海賊、敵、依頼の標的のすべてがカウントされます。", false],
	],
	"medal/5": [
		[0, "", "[[job/0]]の依頼で届けた貨物のトン数に応じて授与されます。大量の配達ほど多くカウントされるので、大きな積荷室が役立ちます。", false],
	],
	"medal/6": [
		[0, "", "ゲーム全体を通じて採掘した鉱石の合計トン数に応じて授与されます。", false],
	],
	"medal/7": [
		[0, "", "ゲーム全体を通じて採掘したコアの数に応じて授与されます。クラスAの小惑星を最後まで掘り抜くたびに1つ得られます。", false],
	],
	"medal/8": [
		[0, "", "ステーションのショップで購入した酒のトン数に応じて授与されます。どの星系の地酒もカウントされます。", false],
	],
	"medal/9": [
		[0, "", "異なる種類の酒を所有すると授与されます。種類は、スペースラウンジの商人から購入するか、トラクタービームで残骸から回収したときにカウントされます。", false],
	],
	"ship/0": [
		[0, "", "[[ship/0]]は船の一覧で最も弱い船体です。装甲95、積荷室25 t、メイン武器スロット1、サブ武器スロット1、装備スロット3。機動性140は初期の船としては立派ですが、販売されている最も安い船体[[ship/32]]は同じスロット構成で、装甲、積荷容量、機動性のすべてで上回ります。[[ship/0]]がディーラーで販売されることはなく、物語を通じてのみ手に入ります。", false],
		[2, "", "[[character/2]]はこの継ぎはぎだらけの元[[faction/8|海賊]]船を所有しており、[[station/78]]で[[character/0]]を乗せます。船は海賊の塗装のままで、採掘レーザーと[[item/81]]を装備していますが、砲はありません。このレーザーは彼自作の試作品で、後に[[item/90]]として販売される設計です。", false],
		[10, "", "海賊の隠れ家を襲撃したあと、[[character/2]]は星系内の惑星間を移動できる強力なドライブを付けてこの船を[[character/0]]に正式に譲りますが、試作レーザーは手元に残します。彼は[[faction/0|Terran]]の宙域に着いたあとも、この船に乗り続けます。", false],
		[18, "", "[[station/98]]で[[character/1]]は、巡回船が海賊船と誤認しないよう、船体を[[faction/0|Terran]]の塗装に塗り直させます。", false],
	],
	"ship/1": [
		[0, "", "[[ship/1]]はサブ武器スロットを4つ持つ最も安い船体で、さらに砲塔スロット、メイン砲2門、装備スロット7を備えます。装甲（192）と積荷室（65 t）も十分です。機動性106は遅いため、魚雷と砲塔で戦うのが最も効果的です。少し高い[[ship/9]]は装甲と機動性ではるかに勝りますが、砲塔はなく、サブ武器スロットも2つだけです。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/10": [
		[0, "", "[[ship/10]]はオープニングシーンでの[[character/0]]自身の船で、[[item/3]]レーザーを2基装備しています。堅い装甲（200）と100 tの積荷室に、サブ武器スロット4と機動性150を兼ね備え、定価が最も近い船体[[ship/11]]よりはるかに機敏です。弱点は装備スロットが5つしかないことです。通常のディーラーでは決して販売されません。", false],
		[2, "", "ハイパードライブの故障によって[[character/0]]は[[station/78]]へ運ばれ、[[character/2]]がその残骸を回収して部品取りのために解体します。この船が彼の手に戻ることはありません。", false],
	],
	"ship/11": [
		[0, "", "[[ship/11]]は装備の充実した大型貨物船です。積荷室180 t、装甲210、砲塔スロット、メイン武器スロット2、サブ武器スロット2、装備スロット8。機動性75は低めです。より安い[[ship/7]]と比べると、積荷容量60 tと引き換えに、サブ武器スロットと装備スロットが1つずつ多くなっています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/12": [
		[0, "", "[[ship/12]]はサブ武器を中心に設計された戦闘機です。サブ武器スロット3、メイン砲2門、装備スロット6、装甲175、機動性132。積荷室30 tは非常に小さく、交易や採掘にはあまり向きません。[[ship/30]]はより高価なのに、装甲が少なくサブ武器スロットも1つ少なくなります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/16": [
		[0, "", "[[ship/16]]はミサイル重視の戦闘機で、サブ武器スロット4、メイン砲2門、装備スロット10、装甲180、機動性120を持ちます。積荷室45 tは小さめです。より高価な[[ship/21]]は、メイン砲が2門と装備スロットが1つ増えます。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/17": [
		[0, "", "[[ship/17]]は、メイン砲4門、サブ武器スロット2、装備スロット10を持ちます。この価格の船としては装甲（145）、積荷室（65 t）、機動性（95）が弱いため、装備、特にシールドと装甲板に頼ることになります。より安い[[ship/19]]は、装備スロットが1つ少ない代わりに装甲と積荷容量が多くなっています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/18": [
		[0, "", "[[ship/18]]は装備スロットを8つ持つ小型で機敏な船（機動性145）で、これより安い船体にこれほど多くのスロットを持つものはありません。装甲115と積荷室28 tは貧弱で、メイン武器スロットとサブ武器スロットも2つずつしかありません。装甲よりシールドやクロークなどの装備に頼るパイロットに向いています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/19": [
		[0, "", "[[ship/19]]は重ガンシップで、メイン武器スロット4、サブ武器スロット2、装備スロット9、装甲225、積荷室105 tを持ちます。機動性90は遅めです。前方の砲を4門持ち、かつ積荷室が100 tを超える唯一の船です。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/2": [
		[0, "", "[[ship/2]]は安価な船体の中で機敏な万能型です。装甲155、積荷室52 t、メイン武器スロット1、サブ武器スロット2、装備スロット4、機動性150。積荷容量以外はすべて[[ship/35]]と同等で、積荷は12 t多く積めます。2門目の砲が欲しいパイロットは、代わりに[[ship/5]]か[[ship/6]]を検討します。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/20": [
		[0, "", "[[ship/20]]は、小型で機敏な船体（機動性155）に装備スロットを6つ詰め込んだ軽戦闘機です。メイン砲を2門持ちますが、サブ武器スロットは1つだけで、装甲125、積荷室25 tは[[ship/0]]と並んで一覧で最小です。シールドやブースターなどの装備を早めに揃えたい、貨物を運ぶつもりのないパイロットに向いています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/21": [
		[0, "", "[[ship/21]]はメイン武器スロットとサブ武器スロットをそれぞれ4つ持つ最も安い船体です。さらに装備スロット11、装甲195、積荷室70 tを備えます。機動性100は平均的です。[[ship/29]]の一段下に位置する本格的な戦闘艦です。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/22": [
		[0, "", "[[ship/22]]は100万クレジットを超える船の中で最大の積荷室（130 t）を持ち、メイン武器スロット3、サブ武器スロット3、装備スロット9、機動性118を備えます。装甲160は価格の割に低めです。同じ船で交易も戦闘もこなすパイロットに向いています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/23": [
		[0, "", "[[ship/23]]は砲塔スロットを持つ最も安い船体で、装甲205は100,000クレジット未満の船の中で最も高い値です。さらにメイン武器スロット2、サブ武器スロット2、装備スロット5、積荷室55 t、機動性128を備え、頑丈な中級の万能型です。主な制約は装備スロットの少なさです。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/24": [
		[0, "", "[[ship/24]]は武装商船です。メイン砲3門、サブ武器スロット2、砲塔、装備スロット8、積荷室95 t。装甲170は平均的ですが、機動性125はこれだけ積める船としては良好です。交易、採掘、戦闘のどれにも同じようにこなせます。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/25": [
		[0, "", "[[ship/25]]はミサイル搭載艦で、サブ武器スロット4、装備スロット8、機動性130を持ちますが、メイン砲は1門だけです。装甲124と積荷室52 tは価格の割に弱く、魚雷とシールドが頼りです。[[ship/1]]は3分の1の価格で同じ数のサブ武器スロットと砲塔を備えますが、装備スロットは少なくなります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/26": [
		[0, "", "[[ship/26]]は装備スロットを7つ持つ最も安い船体です。それ以外は平均的な万能型で、装甲152、積荷室64 t、メイン武器スロット2、サブ武器スロット2、機動性108です。より重い船を買えるようになる前に、装備を一通り揃えたいパイロットに向いています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/27": [
		[0, "", "[[ship/27]]はメイン武器スロットを3つ持つ最も安い船体です。それに装甲176、サブ武器スロット2、装備スロット6、積荷室50 tを組み合わせています。機動性113は遅めなので、敵を旋回で出し抜くより、撃ち合いで勝負する船です。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/28": [
		[0, "", "[[ship/28]]は販売されている中で最も充実した万能型です。メイン武器スロット3、サブ武器スロット4、砲塔、装備スロット12、積荷室110 t。購入できる船で、砲塔とこれほど多くの装備スロットを併せ持つものはほかにありません。装甲195は良好ですが、機動性92は遅めです。[[ship/29]]は戦闘力で勝りますが、積載量ははるかに少なくなります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/29": [
		[0, "", "[[ship/29]]は通常のディーラーが販売する最も高価な船で、その中で最高の戦闘機です。メイン武器スロット4、サブ武器スロット4、装備スロット12、装甲240、機動性118。積荷室75 tは控えめで、砲塔はありません。戦闘でこれを上回るのは[[ship/8]]だけです。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/3": [
		[0, "", "[[ship/3]]はバランスの取れた序盤の万能型です。メイン武器スロット2、サブ武器スロット2、装備スロット5、装甲135、積荷室55 t。機動性112は小型船としては遅めです。価格は[[ship/6]]とほぼ同じで、あちらははるかに速く旋回できますが、装甲と積荷容量が少なく、サブ武器スロットも1つ少なくなります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/30": [
		[0, "", "[[ship/30]]は平凡な戦闘機です。装甲165、積荷室45 t、メイン武器スロット2、サブ武器スロット2、装備スロット6、機動性128。価格の割に特に強みはなく、より安い[[ship/12]]は装甲が多くサブ武器スロットも1つ多く、[[ship/23]]には砲塔があります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/31": [
		[0, "", "[[ship/31]]は、積荷室110 t、砲塔スロット、メイン砲2門、装備スロット6を持つ軽貨物船です。装甲（156）、1つだけのサブ武器スロット、機動性102は控えめです。競合はより安い[[ship/33]]で、積荷容量がわずかに少なく砲も1門少ないものの、装甲が多く機動性も優れています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/32": [
		[0, "", "[[ship/32]]はディーラーが販売する最も安い船体で、最初に買う船として定番です。小型で防御は薄い（装甲100、積荷室30 t、メイン武器スロット1、サブ武器スロット1、装備スロット3）ものの、機動性160で、これより速く旋回できるのは[[ship/4]]だけです。[[ship/0]]と比べると、装甲と積荷容量がわずかに多く、操縦性も優れています。[[ship/35]]は約8,000クレジット高く、装甲がはるかに厚く、2つ目のサブ武器スロットと4つ目の装備スロットが付きます。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/33": [
		[0, "", "[[ship/33]]は積荷容量が100 tを超える（108 t）最も安い船体で、砲塔スロット、装甲176、装備スロット6も備えます。メイン砲が1門だけで機動性も112なので、戦闘機というより自衛のできる商船です。近い競合は[[ship/31]]で、2門目の砲とわずかに大きい積荷室を持ちますが、より弱く鈍重です。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/34": [
		[0, "", "[[ship/34]]は、メイン武器スロット4、サブ武器スロット1、装備スロット6、積荷室60 t、機動性130のガンシップです。より安い[[ship/4]]と比べると、装甲（170に対して135）と機動性を犠牲にして、積荷容量と装備スロット1つを増やしています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/35": [
		[0, "", "[[ship/35]]は価格表の最下位にある軽戦闘機です。価格の割に装甲が厚く（155）、メイン武器スロット1、サブ武器スロット2、装備スロット4、機動性150と機敏ですが、積荷室は40 tしかありません。[[ship/2]]は数千クレジット高いだけで積荷容量が12 t多い、ほぼ同じ船です。一方、[[ship/5]]は機動性と引き換えに装甲と積荷容量が多く、2門目の砲を備えています。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/36": [
		[0, "", "[[ship/36]]はゲーム最大の貨物船で、積荷室は350 tです。メイン武器スロットはまったくなく、防御は4つのサブ武器スロットと砲塔に頼るしかありません。装備スロット7と装甲200は良好ですが、機動性45は一覧で最低です。[[ship/7]]は積載量では劣るものの、前方の砲を2門持ち、旋回性能も上です。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/4": [
		[0, "", "[[ship/4]]はメイン武器スロットを4つ持つ最も安い船体で、機動性162はゲーム中で最も機敏です。装甲170も価格の割に良好です。その代わり積荷室は38 t、サブ武器スロットは1つ、装備スロットは5つで、純粋なドッグファイト用の船です。[[ship/34]]も砲を4門持ち、積荷容量と装備スロットは多いものの、装甲と機動性で劣ります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/5": [
		[0, "", "[[ship/5]]はメイン武器スロットを2つ持つ最も安い船体で、装甲170は価格の割に高めです。積荷室60 tのため、序盤の交易や採掘にも役立ちます。欠点は、サブ武器スロットが1つ、装備スロットが4つしかなく、機動性も115と鈍いことです。装甲より機動性を重視するパイロットは、同程度の価格の[[ship/2]]か[[ship/35]]を選びます。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/6": [
		[0, "", "[[ship/6]]は軽量で高速な戦闘機で、メイン武器スロット2、サブ武器スロット1、装備スロット5、機動性148です。装甲105は非常に薄く、これより少ないのは[[ship/0]]と[[ship/32]]だけなので、頑丈さより速さに頼ることになります。ほぼ同じ価格の[[ship/3]]は、機動性と引き換えに装甲と積荷容量が多く、2つ目のサブ武器スロットがあります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/7": [
		[0, "", "[[ship/7]]は、積荷室240 t、装甲220、砲塔スロット、メイン砲2門、サブ武器スロット1、装備スロット7を持つ大型貨物船です。機動性65で旋回は遅めです。[[ship/36]]と比べると、積荷容量110 tを犠牲にして前方の砲と優れた機動性を得ています。より高価な[[ship/11]]は装備スロットと2つ目のサブ武器スロットが加わります。", false],
		[0, "", "[[faction/1|Vossk]]星系以外のどのディーラーでも入荷する可能性があります。", false],
	],
	"ship/8": [
		[0, "", "[[ship/8]]は復元された[[faction/9|ヴォイド]]の戦闘機で、ゲーム中最強の船です。装甲450はほかのどの船体のほぼ2倍で、メイン武器スロット4、サブ武器スロット4、装備スロット15を持ち、機動性155もトップクラスです。唯一の弱点は積荷室が30 tしかないことです。定価は800万クレジットを超え、[[ship/29]]のほぼ2倍です。", false],
		[0, "", "通常のディーラーでは販売されません。プレイヤーがすべてのメダルをゴールドで所持すると、[[station/10]]でのみ試作型として提供されます（[[guide/medals]]を参照）。", false],
	],
	"ship/9": [
		[0, "", "[[ship/9]]は[[faction/1|Vossk]]のディーラーが販売する唯一の船で、彼らはほかに何も売りません。装甲250は[[ship/8]]を除くどの船体よりも高く、それに加えて機動性152と機敏で、メイン武器スロット2、サブ武器スロット2、装備スロット7、積荷室65 tを備えます。この価格帯で手に入る最も頑丈な戦闘機ですが、[[ship/1]]のような砲塔や追加のスロットはありません。", false],
		[36, "", "[[character/7]]によれば、[[faction/1|Vossk]]の船は通常その種族しか操縦しません。この船は例外で、ほかの種族に販売できるよう改造された設計です。", false],
	],
	"station/0": [
		[0, "", "[[station/0]]には[[system/0]]のジャンプゲートがある。[[step/13]]の待機期間はこのステーションの項目に分類されているが、このステップはどこでもラウンジの依頼をこなせば完了し、ここでは何も起こらない。", false],
	],
	"station/10": [
		[0, "", "[[station/10]]は[[system/6]]の唯一のステーションで、ジャンプゲートがある。フリーランスの依頼でここに送られることはない。ラウンジではエージェント[[agent/3]]が設計図を売っており、すべてのメダルがゴールドになると、このステーションで試作型の[[ship/8]]が提供される。", false],
		[23, "", "このステーションは、[[character/6]]が率いるDeep Scienceの秘密研究基地である。[[character/0]]は[[step/23]]で[[character/5]]とともにここへ到着し、その後も何度か戻ってくる。ヴォイドへの遠征を計画するため、[[character/20]]に会うため、そして結晶を届けるためである。", false],
	],
	"station/18": [
		[0, "", "[[station/18]]は[[system/3]]にある中規模のVosskのステーションである。ラウンジではエージェント[[agent/12]]が[[system/0]]の座標を売っている。", false],
	],
	"station/20": [
		[0, "", "[[station/20]]には[[system/4]]のジャンプゲートがある。ラウンジではMidorianのエージェント[[agent/2]]が武器の設計図を売っている。", false],
	],
	"station/22": [
		[0, "", "[[station/22]]は[[system/4]]で最も高度なステーションである。", false],
		[38, "", "[[step/38]]では、Nivelianの爆薬を積んだ輸送船団が、Midorianの戦闘機に護衛されてこのステーション付近で発見される。[[character/0]]は船団を破壊せずに護衛機を追い払わなければならない。", false],
	],
	"station/26": [
		[0, "", "[[station/26]]は[[system/5]]にある最高テックレベルのVosskのステーションである。ラウンジではBobolianのエージェント[[agent/13]]が[[system/1]]の座標を売っている。", false],
	],
	"station/27": [
		[36, "", "[[step/36]]では、[[station/27]]の近くで[[character/7]]と[[character/0]]が海賊の隠れ家を襲撃する。より多くの海賊を撃破した方の勝ちである。", false],
		[37, "", "[[character/0]]が勝ち、Vosskの貨物船を護衛する権利を得る。彼はここから[[character/1]]に報告を入れる。", false],
	],
	"station/29": [
		[35, "", "[[station/29]]は、ヴォイド攻撃のためにK'Sarr貨物船を提供することに同意したVossk司令官[[character/7]]のステーションである。[[step/35]]で[[character/0]]はここで彼と会う。", false],
		[36, "", "[[character/7]]はVossk以外の者に貨物船を操縦させることを拒み、護衛パイロットとしての腕を証明するよう[[character/0]]に挑む。", false],
	],
	"station/3": [
		[0, "", "[[station/3]]は、隠された[[system/0]]星系にあるテックレベルの高いNivelianのステーションである。ラウンジにはエージェント[[agent/0]]がいて、武器の設計図を売っている。", false],
	],
	"station/30": [
		[34, "", "[[step/34]]では、[[character/1]]がヴォイドの母艦に対する計画を携えて[[station/30]]で待っている。", false],
		[35, "", "計画とは、Nivelianの核爆薬を満載した大型貨物船を母艦に突入させることである。", false],
		[39, "", "奪還された爆薬はここに到着し、Vosskの貨物船に積み込まれる。[[step/39]]で[[character/1]]が最終作戦を説明する。", false],
	],
	"station/43": [
		[0, "", "[[station/43]]は[[system/8]]にある小さなTerranのステーションである。ラウンジではエージェント[[agent/4]]が安価なロケットの設計図を売っている。", false],
	],
	"station/48": [
		[24, "", "[[station/48]]の近くでヴォイドの艦船が目撃されている。[[step/24]]で[[character/0]]は、ヴォイドを観察し、トラクタービームで残骸を回収するため、[[character/6]]をここへ連れてくる。", false],
		[25, "", "回収作業の終わりに、[[character/6]]を乗せた[[character/0]]の船がワームホールに飲み込まれる。", false],
		[27, "", "二人が別のワームホールを通って戻ってくると、ヴォイドの戦闘機が後を追ってきており、[[character/0]]は[[station/10]]へ戻る前にここでそれらを撃破しなければならない。", false],
	],
	"station/54": [
		[0, "", "[[station/54]]は、ジャンプドライブでしか到達できない星系[[system/10]]にある最高テックレベルのVosskのステーションである。ラウンジではVosskのエージェント[[agent/5]]がミサイルの設計図を売っている。", false],
	],
	"station/55": [
		[0, "", "[[station/55]]には[[system/11]]のジャンプゲートがある。", false],
		[19, "", "[[character/5]]を人質に身代金を要求する海賊が、このステーションの近くで見つかる。Deep Scienceは[[character/0]]のためにEMP爆弾をここのハンガーに用意する。", false],
		[22, "", "救出のあと、[[character/0]]はこのステーションで解放された士官と会い、[[system/6]]の座標を受け取る。", false],
	],
	"station/56": [
		[18, "", "[[station/56]]は、[[step/18]]で[[character/0]]がDeep Scienceの士官を迎えるはずだった合流地点である。", false],
		[19, "", "士官は現れない。代わりに[[character/1]]から、彼が海賊に誘拐されたという連絡が入る。", false],
	],
	"station/59": [
		[0, "", "[[station/59]]はVosskの星系[[system/20]]にある小さなステーションである。ラウンジにはTerranのエージェント[[agent/10]]がいて、クローキング装置の設計図を売っている。", false],
	],
	"station/61": [
		[0, "", "[[station/61]]は[[system/12]]に二つしかないステーションの一つである。ラウンジではMultipodのエージェント[[agent/6]]が核兵器の設計図を売っている。", false],
	],
	"station/65": [
		[0, "", "[[station/65]]には[[system/13]]のジャンプゲートがある。ラウンジではCyborgのエージェント[[agent/14]]が[[system/10]]の座標を売っている。", false],
	],
	"station/72": [
		[0, "", "[[station/72]]は、治安が安全な[[system/14]]星系にある小さなTerranのステーションである。ラウンジではエージェント[[agent/7]]がシールドの設計図を売っている。", false],
	],
	"station/76": [
		[11, "", "[[station/76]]は[[system/15]]にあるステーションで、呼びかけに応答しなくなっている。[[step/11]]で[[character/3]]はその理由を調べるため[[character/0]]を送り出す。", false],
		[12, "", "ステーションは無傷である。乗員はただ働ける状態にないだけで、その原因は[[character/0]]の古い知り合いである売人[[character/4]]が持ち込んだ大量のニューロ藻だった。", false],
	],
	"station/78": [
		[0, "", "[[station/78]]は、[[system/15]]にあるNivelianの鉱石商人[[character/2]]の小さな採掘ステーションである。物語はこのステーションの軌道上で始まる。", false],
		[1, "", "損傷した[[character/0]]の船はオートパイロットでここへ漂着し、[[character/2]]がパイロットごと船を引き取る。", false],
		[2, "", "[[character/2]]は残骸を解体し、[[character/0]]に[[ship/0]]で近くの小惑星から鉱石を採掘させる。", false],
		[8, "", "海賊の襲撃を逃れたあと、[[character/0]]は初めての武器を装備し、[[character/2]]がステーション近くの海賊の隠れ家を壊滅させるのを手伝う。", false],
		[10, "", "その後[[character/2]]は彼に船を譲り、[[station/79]]へと送り出す。", false],
		[0, "", "ゲームの後半では、[[character/2]]がこのステーションのラウンジで自作の採掘ドリルの設計図を売っている。", false],
	],
	"station/79": [
		[0, "", "[[station/79]]は[[system/15]]にあるステーションで、星系の司令官[[character/3]]の拠点である。", false],
		[10, "", "[[step/9]]で[[character/2]]は、Terran宙域へ戻る手助けをしてくれるかもしれない人間の[[character/3]]に会わせるため、[[character/0]]をここへ送る。", false],
		[11, "", "[[character/3]]は[[faction/3|Mido連邦]]について説明し、協力の見返りとして[[station/76]]の様子を確かめてほしいと頼む。", false],
		[13, "", "[[station/76]]からの報告を受けて、[[character/3]]はこのステーションに到着予定のTerranの輸送船団と彼を引き合わせると約束する。", false],
		[15, "", "[[step/14]]で到着した輸送船団は[[character/0]]を海賊と誤認し、彼の船を無力化して艦内に連行する。", false],
	],
	"station/8": [
		[0, "", "[[station/8]]は、隠された[[system/1]]星系にあるTerranのステーションである。ラウンジではNivelianのエージェント[[agent/1]]が設計図を売っている。", false],
	],
	"station/84": [
		[0, "", "[[station/84]]は[[system/16]]にあるTerranのステーションである。ラウンジではVosskのエージェント[[agent/8]]がVosskの装甲の設計図を売っている。", false],
	],
	"station/88": [
		[0, "", "[[station/88]]は[[system/17]]にある小さなNivelianのステーションである。ラウンジではVosskのエージェント[[agent/15]]が[[system/21]]の座標を売っている。", false],
	],
	"station/90": [
		[0, "", "[[station/90]]には[[system/18]]のジャンプゲートがある。ラウンジではエージェント[[agent/9]]が積荷圧縮装置の設計図を売っている。", false],
	],
	"station/91": [
		[28, "", "[[step/28]]では[[station/91]]の近くでヴォイドの活動が報告される。[[character/0]]はヴォイドの母艦まで探査機を運ぶため、ここで戦いながらワームホールへと突き進む。", false],
		[31, "", "ヴォイド宙域から戻った[[character/0]]は、ここで[[character/1]]から[[station/98]]へ招く連絡を受ける。", false],
	],
	"station/98": [
		[15, "", "[[station/98]]は[[system/19]]にあるTerranのステーションである。[[character/0]]を逮捕した巡洋艦は彼をここへ連れてきて、彼は旧友[[character/1]]が責任者であることを知る。", false],
		[16, "", "二人の会話中にヴォイドの戦闘機がステーションを襲撃し、[[character/0]]はそれを追い払うのに協力する。", false],
		[18, "", "[[character/1]]は彼にヴォイドについて説明し、Deep Scienceに引き入れる。", false],
		[32, "", "[[step/31]]で[[character/1]]は[[character/0]]の船に早期警戒システムを取り付け、[[character/20]]のことを伝える。", false],
		[44, "", "勝利のあと、[[character/0]]と[[character/1]]はこのステーションで祝杯をあげ、[[character/6]]もそこに加わる。", false],
		[45, "", "翌朝、[[character/6]]は書き置きとDeep Scienceからの最後の報酬を残して姿を消している。", false],
	],
	"step/0": [
		[0, "", "[[character/0]]は、懸けられた賞金を手に入れるため、小惑星帯で[[faction/8|海賊]]の一団を追っている。海賊船をすべて見つけ出して撃破しなければならない。", false],
		[1, "", "海賊を片付けたKeithは、特別な任務の件でSmith提督に呼ばれているEden Primeへと針路を取る。ハイパードライブが起動した瞬間、最後の一撃が船を損傷させる。ドライブは故障し、生命維持装置も深刻な被害を受け、オートパイロットが気を失ったパイロットを最寄りのステーション[[station/78]]へと運んでいく。", false],
	],
	"step/1": [
		[1, "", "オートパイロットは、損傷したKeithの船を[[station/78]]の周回軌道まで運んだ。パイロットは船内で意識を失ったままである。", false],
		[2, "", "Keithが目を覚ますと、そこは[[faction/2]]の鉱石商人[[character/2]]が営む小さな採掘ステーションだった。Gunantは船を分解し、サルベージ権を盾に自分のものだと主張する。彼は銀河の反対の端にあるEden Primeへ行くという話を笑い飛ばし、Keithがヴォイドのことを聞いたこともないのに驚く。ヴォイドとは、今や[[system/15]]星系にさえ現れる敵対的な存在である。", false],
		[2, "", "金も船もないKeithは、非武装の船で鉱石を採掘してGunantのために働くしかない。", false],
	],
	"step/10": [
		[10, "", "Keithは[[character/3]]に会うため[[station/79]]へ飛ぶ。", false],
		[11, "", "Norrisによれば、[[system/15]]は最近発見された宙域にある。Nivelian内戦の際にTerranとNivelianの亡命者たちがこの地に入植し、独立した連邦を建国した。Terranはこれを認めているが、Nivelianはいまだにこの星系の領有を主張しており、辺境では戦闘が続いている。", false],
		[11, "", "NorrisはTerran宇宙艦隊との連絡を仲介する見返りとして、頼みを持ちかける。ステーション[[station/76]]との連絡が途絶えており、その理由を経験豊富なパイロットに調べてほしいというのだ。", false],
	],
	"step/11": [
		[11, "", "Keithは沈黙の理由を調べるため[[station/76]]へ飛ぶ。ステーションは無傷で戦闘の痕跡もないため、彼はドッキングする。", false],
		[12, "", "中でKeithは、昔からの知り合いである悪名高い売人[[character/4]]に出くわす。Mkktはニューロ藻を大量に持ち込んでおり、乗員全員が酩酊して通信どころではない。Keithはできるだけ早くその場を立ち去る。", false],
	],
	"step/12": [
		[12, "", "Keithは報告のため[[station/79]]に戻る。", false],
		[13, "", "Norrisはあきれ果て、売人の始末をつけると約束する。Terranの軍の輸送船団がKernstalに向かっており、Keithが艦隊と接触する機会になるという。到着までの間、NorrisはスペースラウンジでKeithに報酬付きの仕事をするよう勧める（[[guide/lounge]]を参照）。", false],
	],
	"step/13": [
		[13, "", "輸送船団を待つ間、Keithはスペースラウンジでフリーランスの依頼を2件こなさなければならない（[[guide/jobs]]を参照）。", false],
		[14, "", "NorrisはTerranの輸送船団が星系に入り、[[station/79]]に向かっていると知らせる。Keithは船団を迎えに出発する。", false],
	],
	"step/14": [
		[14, "", "[[station/79]]の近くで、KeithはTerranの輸送船団と数隻の海賊を見つける。彼は海賊を追い払うため接近する。", false],
		[15, "", "元海賊船に乗っていたKeithは、襲撃者の一味と誤解される。輸送船団はEMP兵器で彼の船を無力化して彼を逮捕し、Terran宙域の[[station/98]]へ向かうTerranの巡洋艦に連行する。", false],
	],
	"step/15": [
		[15, "", "Keithは輸送船団の捕虜として[[station/98]]に到着する。", false],
		[16, "", "責任者の士官は、Keithの旧友であり、今は星間保安局の局長となった[[character/1]]だった。彼は誤認を詫びる。しかし再会もつかの間、ヴォイドの戦闘機が軌道上に現れ、ステーションに警報が鳴り響く。", false],
	],
	"step/16": [
		[16, "", "Brentは、[[station/98]]を攻撃している[[faction/9|ヴォイド]]の艦船を追い払うのを手伝ってほしいとKeithに頼む（[[world/voids]]を参照）。", false],
		[17, "", "ヴォイドは平和的な意図を主張するメッセージを発信しながらも、攻撃を続ける。Keithが彼らを撃退すると、Brentはワインでも飲みながら知っていることをすべて話すと約束する。", false],
	],
	"step/17": [
		[17, "", "Keithは、Brentがヴォイドについて知っていることを聞くため[[station/98]]にドッキングする。", false],
		[18, "", "ヴォイドはここ数週間のうちに現れるようになった。彼らはある種のワームホールを通ってやって来て、遭遇したものを片っ端から攻撃し、鉱石を狙っているように見える。[[faction/1]]の星系でさえ襲撃を受けている。Brentは危機対策チームの議長を務めており、その科学者たちはDeep Scienceが運営する秘密の研究ステーションに集まっている。彼はKeithに、彼らのために飛んでほしいと頼む。", false],
		[18, "", "そのステーションのある星系は標準の星図に載っていないため、Keithは座標を受け取るために[[system/11]]星系の[[station/56]]でThomas Boyle中尉（[[character/5]]）と会わなければならない。Brentはまた、Keithの船が新品ではなく、これ以上の誤認を防ぐために塗り直しただけだと打ち明ける。", false],
	],
	"step/18": [
		[18, "", "KeithはBoyleに会うため[[station/56]]へ飛ぶ。", false],
		[19, "", "Boyleは姿を現さなかった。Brentの報告によれば、彼は[[station/55]]の近くで海賊に誘拐され、500万クレジットの身代金が要求されている。Brentは支払うつもりだが、Keithは身代金を受け取った誘拐犯がBoyleを殺すだろうと考え、代わりにKappaへ向かう。", false],
	],
	"step/19": [
		[19, "", "Keithは誘拐犯を探すため[[station/55]]へ飛ぶ。", false],
		[20, "", "Kappaのスキャナーが誘拐犯の船の位置を突き止める。BrentはステーションのハンガーにEMP爆弾を用意させていた。誘拐犯がKeithを身代金の運び手だと思い込んでいる隙に、船を無力化できるようにするためだ。", false],
	],
	"step/2": [
		[2, "", "GunantはKeithに、何度も修理を重ねた古い船[[ship/0]]を与える。元は海賊船で、採掘レーザーを備えているが武器はない。Keithは[[station/78]]付近の小惑星から少なくとも10トンの鉱石を採掘しなければならない（[[guide/mining]]を参照）。", false],
		[3, "", "鉱石を積み込むと、Gunantは積荷を確認するのでドッキングしろと指示する。武器のないKeithには従うほかない。", false],
	],
	"step/20": [
		[20, "", "Keithは[[station/55]]にドッキングし、EMP爆弾を船に装備しなければならない。", false],
		[21, "", "爆弾を取り付けると、Keithはただちに出発する。", false],
	],
	"step/21": [
		[21, "", "ウェイポイントが誘拐犯の船を示しているが、船は単独ではないかもしれない。Keithは船を撃破するのではなくEMP爆弾で無力化し、護衛がいれば片付けなければならない。", false],
		[22, "", "爆弾がシステムを停止させるまで、誘拐犯たちは身代金が届いたと思い込んでいる。BrentはBoyleを救出するために部隊を送る。", false],
	],
	"step/22": [
		[22, "", "Keithは救出された科学者に会うため[[station/55]]にドッキングする。", false],
		[23, "", "Boyleは礼を言う。自分の船を失った彼をKeithは送っていくと申し出て、Boyleは研究ステーションのある[[system/6]]星系の座標をKeithの航法コンピューターに転送する。", false],
	],
	"step/23": [
		[23, "", "KeithはBoyleを、Paolini博士が待つ[[system/6]]星系の[[station/10]]へ送り届ける。", false],
		[24, "", "KeithはDeep Scienceのプロジェクトを率いるCarla Paolini博士（[[character/6]]）と出会う。彼女はヴォイドの技術を解明したいと考えており、まずはヴォイド艦の残骸から手をつけるつもりだ。Deep ScienceはKeithに船の装備費として20,000クレジットを支払う。トラクタービームは必須である。", false],
		[24, "", "Carlaは、最近ヴォイドが目撃された[[system/9]]星系の[[station/48]]へ同行すると言い張る。Keithは反対するが、結局折れる。", false],
	],
	"step/24": [
		[24, "", "[[station/48]]でCarlaは、できるだけ近くでヴォイドを見たいと望む。ヴォイドは、自分たちは未来から来た者であり、銀河の文明の唯一の生き残りだと告げる。Keithは彼らと戦い、トラクタービームで艦船の残骸を回収しなければならない。", false],
		[25, "", "十分な残骸を積み込むと、Carlaは帰還を求める。しかしその瞬間、何かが突然船を捕らえる。", false],
	],
	"step/25": [
		[25, "", "KeithとCarlaが意識を取り戻したのは、[[station/48]]から遠く離れた、二人とも知らない宙域だった。", false],
		[26, "", "近くには巨大なヴォイドの母艦があり、戦闘機を発進させている。Keithは、ワームホールを通ってヴォイドの本拠宙域に入り込んだのだと結論づける。そのワームホールは消えてしまったが、こうした出入口は崩壊しては別の場所に現れるらしい。帰還するには別のワームホールにたどり着かなければならない。", false],
	],
	"step/26": [
		[26, "", "ワームホールは二人を[[station/48]]に連れ戻すが、ヴォイドの戦闘機が後を追ってきていた。Keithは、船が[[station/10]]まで追跡されないよう、それらを撃破しなければならない。", false],
		[27, "", "追っ手を片付けた二人は、休息を切に求めながらThynomeへ戻る。", false],
	],
	"step/27": [
		[27, "", "Keithは[[station/10]]にドッキングする。", false],
		[28, "", "2日後、CarlaはKeithに再び向かってほしいと頼む。彼女のチームは、母艦に撃ち込むと母艦を解析し、その結果をKeithの船に送信する探査機を製作していた。彼女は残骸の研究のために残り、ヴォイドが報告されたばかりの[[system/18]]星系へ、別のワームホールを探すようKeithを送り出す。", false],
		[28, "", "Keithは一つ条件をつけて引き受ける。生きて帰ったら、Carlaは彼とデートすること。彼女はそれを受け入れる。", false],
	],
	"step/28": [
		[28, "", "[[station/91]]の近くにヴォイドの戦闘機が現れ、Keithはワームホールが崩壊する前にたどり着かなければならない。ヴォイドは、自分たちを滅ぼせば彼自身の未来も滅びると警告する。", false],
		[29, "", "Keithはワームホールにたどり着き、ヴォイド宙域へと通り抜ける。", false],
	],
	"step/29": [
		[29, "", "母艦の近くで、Keithは母艦をロックオンして探査機を発射し、探査機が解析を終えるまで持ちこたえなければならない。", false],
		[30, "", "待機中、ヴォイドは再び通信を送り、人類が自分たちを滅ぼし、それによって人類自身の未来をも滅ぼす前に、対話の手段を見つけなければならないと語る。Keithはデータ転送が完了するまで持ちこたえ、その場を離れる。", false],
	],
	"step/3": [
		[3, "", "Keithは最初の鉱石を引き渡すため、[[station/78]]にドッキングする。", false],
		[4, "", "Gunantはそこそこ満足するが、今度は積荷室を満杯にしてこいとKeithを再び送り出す。おとなしくしていれば、いつか船をもらえるかもしれないぞと冗談を言う。", false],
	],
	"step/30": [
		[30, "", "ワームホールを抜けて戻ったKeithは、[[station/91]]の近くで待機する。", false],
		[31, "", "Brentから連絡が入り、Thynomeに戻る前に[[system/19]]星系の[[station/98]]に立ち寄ってほしいと頼まれる。サプライズがあるという。探査機のデータはそこからCarlaに送信できる。", false],
	],
	"step/31": [
		[31, "", "KeithはBrentに会うため[[station/98]]にドッキングする。", false],
		[32, "", "Brentのチームは星図用の早期警戒システムを開発していた。これはヴォイドがワームホールを開こうとしている場所を示すもので、Keithの航法コンピューターはそれを受信できるよう改造される。BrentはKeithにそうした場所へ飛んで現地の部隊を支援してほしいと頼み、30,000クレジットを支払う。", false],
		[32, "", "Brentはさらに、Deep Scienceで働く[[character/20]]という名の[[faction/7|Grey]]がKeithに会いたがっていると付け加える。", false],
	],
	"step/32": [
		[32, "", "Keithは[[character/20]]に会うため[[station/10]]に戻る。", false],
		[33, "", "Khadorはヴォイドの残骸を研究してきた。彼は、ヴォイドのワームホールの秘密が、ヴォイド宙域でしか見つからないある結晶の構造にあると考えている。彼は船を宇宙のどの地点へも瞬時に移動させるドライブを開発しており、その結晶を少なくとも50個持ってきてほしいとKeithに頼む。", false],
		[33, "", "Keithはもう一度ワームホールに入らなければならない。今回はBrentの早期警戒システムを使ってワームホールを探す。", false],
	],
	"step/33": [
		[33, "", "Keithはヴォイド宙域で[[item/164]]を50個集め、[[station/10]]に届けなければならない。", false],
		[34, "", "Khadorは大喜びし、Keithが自分用に製造できるよう[[item/85]]の設計図の写しを与える（[[guide/blueprints]]を参照）。このドライブならヴォイドの本拠宙域にさえ到達できる。", false],
		[34, "", "Carlaが現れるが、忙しくてデートどころではない。彼女はBrentと計画を練り上げたと告げ、[[system/2]]星系の[[station/30]]にいるBrentのもとへKeithを送り出す。", false],
	],
	"step/34": [
		[34, "", "KeithはBrentの計画を聞くため[[station/30]]へ飛ぶ。", false],
		[35, "", "探査機のデータから、母艦がワームホールの発生源であることが判明する。これまでどの兵器も母艦に損傷を与えられていないため、Nivelianの核爆薬を積んだ頑丈な貨物船を母艦の中心部に突入させる計画が立てられる。", false],
		[35, "", "この任務にはVosskのK'Sarr貨物船が最も適している。Brentは秘密の捕虜交換の一環として、[[system/5]]星系の[[station/29]]の司令官[[character/7]]から1隻を手に入れる手はずを整えていた。Errktはパイロットと直接会うことを求めている。", false],
	],
	"step/35": [
		[35, "", "Keithは[[station/29]]で[[character/7]]と会うため、[[faction/1]]の領域へ飛ぶ。", false],
		[36, "", "Keithの経歴を調べていたErrktは、Vosskの船を正しく操縦できるのはVosskだけだと考えている。任務の失敗は許されないため、彼は自ら貨物船を操縦するという。ただしその前に、Keithは惑星[[station/27]]の近くで戦闘機パイロットとしての腕を証明しなければならない。", false],
	],
	"step/36": [
		[36, "", "Errktは[[station/27]]の近くにある海賊の隠れ家での勝負を提案する。より多くの海賊を撃墜した方の勝ちである。", false],
		[37, "", "Keithが勝つ。ErrktはKeithを有能なパイロットと認め、約束の合流地点まで運ぶ貨物船を護衛する栄誉を与える。Keithは報告のためBrentに連絡する。", false],
	],
	"step/37": [
		[37, "", "KeithはErrktとの話し合いを報告するため、[[station/27]]からBrentに連絡する。", false],
		[38, "", "Vossk帝国は支援を確約し、BrentはErrktをパイロットとして認める。だが新たな問題が生じていた。Nivelianと交戦中の[[faction/3|Mido連邦]]の艦船が、Nivelianの爆薬を運ぶ輸送船団を奪ったのだ。船団は[[system/4]]星系の[[station/22]]付近で目撃されており、Keithは迎撃を引き受ける。", false],
	],
	"step/38": [
		[38, "", "[[station/22]]の近くで、KeithはMidoの戦闘機に護衛された奪われた輸送船団を見つける。彼は船団の船を傷つけずに護衛機を撃破しなければならない。", false],
		[39, "", "輸送船団を取り戻すと、Brentは[[station/30]]までの移送を現地の保安部隊に任せ、Keithにもそこへ戻るよう頼む。", false],
	],
	"step/39": [
		[39, "", "Keithは最終ブリーフィングのため[[station/30]]にドッキングする。", false],
		[40, "", "爆薬はVosskの貨物船に積み込まれ、パイロットは引き続きErrktが務める。次にヴォイドが現れたら、KeithとErrktは現地へ飛ぶ。Errktは最初のワームホールを目指し、Keithは彼を援護しながら後に続く。Brentは最寄りのステーションに増援を要請する。", false],
		[40, "", "Errktは衝突の直前に脱出ポッドで脱出する予定である。Keithは母艦が破壊される前にワームホールを通って戻らなければならない。さもなければ帰る道はなくなる。", false],
	],
	"step/4": [
		[4, "", "Keithは小惑星帯に戻り、積荷室が満杯になるまで採掘する。", false],
		[5, "", "採掘中に海賊船が接近してくる。武器のないKeithは、砲火をかわしながらステーションへ逃げるよう指示される。", false],
	],
	"step/40": [
		[40, "", "早期警戒システムを頼りに、Keithはヴォイドの攻撃を受けている軌道へ飛ぶ。Errktが貨物船とともに到着して最初のワームホールへ向かい、[[character/8]]中尉が部隊を率いて合流する。Keithは貨物船がワームホールを抜けるまで守らなければならない。", false],
		[41, "", "貨物船の装甲は大きく損傷するが、Errktはワームホールにたどり着き、Keithも後に続いて通り抜ける。", false],
	],
	"step/41": [
		[41, "", "Baffourの部隊は間に合わずワームホールを抜けられなかったため、KeithとErrktは孤立する。貨物船は母艦との衝突コースに乗っており、Keithはその進路上のヴォイドの戦闘機を排除しなければならない。", false],
		[42, "", "貨物船が迫る中、Errktは脱出ポッドが被弾したと報告する。彼は貨物船に残ることを選び、まだ時間があるうちに離脱するようKeithに命じる。Keithは別れを告げて引き返す。", false],
	],
	"step/42": [
		[42, "", "Errktの貨物船が目標へ向かう間に、Keithは離脱しなければならない。", false],
		[43, "", "Brentから、宙域全体でワームホールが崩壊したとの報告が入る。計画は成功したのだ。KeithがErrktは助からなかったと伝えると、BrentはVossk帝国への報告書で彼の功績を称えると約束する。二人は[[station/98]]で一杯やろうと約束する。", false],
	],
	"step/43": [
		[43, "", "Keithは祝杯をあげるため、[[station/98]]でBrentと合流する。", false],
		[44, "", "何杯か飲んだところで、イブニングドレス姿のCarlaが、Keithとの約束のデートを果たしにやって来る。Brentは気を利かせて二人きりにする。", false],
	],
	"step/44": [
		[44, "", "Carlaと一夜を過ごしたKeithは、二日酔いで[[station/98]]で目を覚ます。", false],
		[45, "", "Carlaはいなくなっていた。残された書き置きには、明かせない場所での別の秘密プロジェクトに移ったこと、そしてDeep ScienceがKeithに最後の報酬として40,000クレジットを支払うことが記されていた。Keithは最初から利用されていたのではないかと疑いつつ、バーへと戻っていく。", false],
	],
	"step/45": [
		[45, "", "物語はこれで完結である。ヴォイドの母艦は破壊され、ワームホールは閉じ、[[character/0]]はどこへでも好きなところへ行ける。この先も銀河中で飛行、交易、採掘、依頼を続けられる。物語全体の概要は[[world/history]]を参照。", false],
	],
	"step/5": [
		[5, "", "Keithは海賊を振り切り、無事に[[station/78]]へドッキングしなければならない。", false],
		[6, "", "Gunantは、ステーションへの海賊の襲撃がひどくなっていることを認める。Keithは武器さえあれば片付けてやると申し出る。Gunantはステーション近くの海賊の隠れ家を攻撃してみることに決め、Keithが武器と装甲を装備できるよう小さなハンガーを開放する。", false],
	],
	"step/6": [
		[6, "", "Keithはステーションのハンガーで、[[ship/0]]に武器と装甲板を装備しなければならない（[[guide/fitting]]を参照）。", false],
		[7, "", "Gunantはその選択に満足する。念のため、Keithの武器が自分のシールドを貫通できないよう設定してあるという。二人は外で落ち合うことにする。", false],
	],
	"step/7": [
		[7, "", "Gunantは隠れ家までの航路をウェイポイントとして転送する。Keithはそれをたどり、Gunantとともに現地の海賊船を撃破しなければならない（[[guide/combat]]を参照）。", false],
		[8, "", "隠れ家には予想をはるかに上回る数の海賊がいた。Gunantは撤退しようとするが、Keithは戦い続けて勝利する。どこでそんな戦い方を覚えたのかと聞かれ、KeithはSmith提督のもとで宇宙艦隊に所属していたと答える。Keithがあまりにも若く見えるため、Gunantは妙な話だと思う。", false],
	],
	"step/8": [
		[8, "", "戦いに勝ったKeithとGunantは[[station/78]]に戻る。", false],
		[9, "", "Gunantは命を救ってくれた礼を述べ、[[station/5]]にあるSmith提督の墓のことを口にする。Keithは愕然とする。提督は3612年ごろに老衰で亡くなっていたのだ。さらにGunantは、今年が3624年であり、ヴォイドの年として記憶されるだろうと語る。", false],
	],
	"step/9": [
		[9, "", "知らせに動揺したKeithは、Gunantと話をつけるため再び[[station/78]]にドッキングする。", false],
		[10, "", "Keithは、小惑星帯で攻撃を受けてから約35年が経過していることに気づく。Gunantはハイパードライブの故障を疑う。その型のドライブは長年、同様の事故との関連が指摘されてきたからだ。", false],
		[10, "", "海賊に勝利した礼として、Gunantは星系内の惑星間を移動できる強力なドライブを取り付けた[[ship/0]]をKeithに譲る。ただし、自作の試作品である採掘レーザーは手元に残す。Keithはようやく名を名乗り、[[faction/0]]の宙域に戻る手助けをしてくれる人間の指揮官、[[station/79]]の[[character/3]]大佐に会いに出発する。これ以降、[[chart]]で星系内を移動できるようになる。", false],
	],
	"system/0": [
		[0, "", "[[system/0]]は星図の左端にあるNivelianの星系である。[[station/18]]の[[agent/12]]から座標を買うまで、星図上では隠されている。[[station/0]]にあるゲートで[[system/2]]と[[system/8]]につながっている。", false],
		[0, "", "Suteoのステーションは、Nivelian宙域でも屈指の高度さを誇り、[[station/2]]と[[station/4]]は最高のテックレベルにある。[[station/3]]ではエージェント[[agent/0]]が設計図を売っている。", false],
	],
	"system/1": [
		[0, "", "[[system/1]]は星図の左下隅にあるTerranの星系である。[[station/26]]の[[agent/13]]から座標を買うまで隠されている。[[station/5]]にあるゲートで[[system/8]]と[[system/18]]につながっている。", false],
		[0, "", "ステーションはよく発展しており、[[station/7]]は最高のテックレベルにある。[[station/8]]ではエージェント[[agent/1]]が設計図を売っている。", false],
		[9, "", "[[character/2]]によれば、[[character/0]]のかつての上官Smith提督は[[station/5]]に埋葬されている。", false],
	],
	"system/10": [
		[0, "", "[[system/10]]は星図の右側にあるVosskの星系で、治安は非常に危険と評価されている。[[agent/14]]から座標を買うまで隠されており、ゲート接続はまったくないため、ジャンプドライブを持つ船しか到達できない。5つのステーションはすべて最高クラスのテックレベルである。", false],
		[0, "", "[[station/54]]ではエージェント[[agent/5]]が設計図を売っている。", false],
	],
	"system/11": [
		[0, "", "[[system/11]]は星図の中央上部にあるTerranの星系で、治安は普通と評価されている。ステーションは3つしかない。[[station/55]]にあるゲートで[[system/7]]、[[system/9]]、[[system/14]]、[[system/16]]につながっている。", false],
		[18, "", "[[character/0]]は、Deep Scienceの士官と会うために[[station/56]]へ送られる。", false],
		[19, "", "その士官[[character/5]]は、[[station/55]]の近くで海賊に誘拐されていた。", false],
		[22, "", "[[step/21]]で[[character/0]]はEMP爆弾を使って彼を救出する。", false],
	],
	"system/12": [
		[0, "", "[[system/12]]はステーションが2つしかない小さなVosskの星系で、星図の右側にあり、治安は普通と評価されている。[[station/60]]にあるゲートで[[system/3]]、[[system/5]]、[[system/13]]、[[system/14]]につながっており、Vossk宙域とTerranの東部を結んでいる。", false],
		[0, "", "[[station/61]]ではMultipodのエージェント[[agent/6]]が設計図を売っている。", false],
	],
	"system/13": [
		[0, "", "[[system/13]]は星図の右端にあるTerranの星系で、治安は危険と評価されている。[[station/65]]にあるゲートで[[system/12]]と[[system/16]]につながっている。", false],
		[0, "", "[[station/65]]ではCyborgのエージェント[[agent/14]]が座標を売っている。", false],
	],
	"system/14": [
		[0, "", "[[system/14]]は星図の中央付近にあるTerranの星系で、銀河に二つしかない治安が安全な星系の一つである。[[station/70]]にあるゲートで[[system/3]]、[[system/11]]、[[system/12]]、[[system/19]]につながっている。ステーションの多くはテックレベルが低い。", false],
		[0, "", "[[station/72]]ではエージェント[[agent/7]]が設計図を売っている。", false],
	],
	"system/15": [
		[0, "", "[[system/15]]は星図の最上部にあるMidorianの星系で、治安は非常に危険と評価されている。ゲート接続がないため、船がこの星系に出入りするにはジャンプドライブが必要である。5つのステーションはすべて小規模でテックレベルが低い。[[step/16]]まではシップディーラーが閉まっており、船の往来もほとんどない。", false],
		[0, "", "物語はここ、[[station/78]]で始まる。", false],
		[11, "", "この星系は、Nivelian内戦の際にTerranとNivelianの亡命者たちが建国した[[faction/3|Mido連邦]]の領土である。Nivelianはいまだに領有を主張しており、辺境では戦闘が続いている。", false],
		[15, "", "[[character/0]]は[[step/14]]のあと、Terranの巡洋艦に乗せられた捕虜としてこの星系を離れる。後で戻るにはジャンプドライブが必要である。", false],
		[0, "", "[[station/78]]のラウンジでは[[character/2]]が設計図を売っている。", false],
	],
	"system/16": [
		[0, "", "[[system/16]]は星図の右側にあるTerranの星系で、治安は危険と評価されている。[[station/80]]にあるゲートで[[system/11]]と[[system/13]]につながっている。", false],
		[0, "", "[[station/84]]ではVosskのエージェント[[agent/8]]が設計図を売っている。", false],
	],
	"system/17": [
		[0, "", "[[system/17]]は星図の左上にあるNivelianの星系で、治安は危険と評価されており、[[system/15]]に最も近い星系である。[[station/85]]にあるゲートで[[system/2]]、[[system/9]]、[[system/4]]につながっており、[[system/4]]へ通じる唯一のゲート航路である。", false],
		[0, "", "[[station/88]]ではVosskのエージェント[[agent/15]]が座標を売っている。", false],
	],
	"system/18": [
		[0, "", "[[system/18]]は星図の下部にあるTerranの星系で、治安は危険と評価されている。[[station/90]]にあるゲートで[[system/1]]と[[system/8]]につながっている。", false],
		[0, "", "[[station/90]]ではエージェント[[agent/9]]が設計図を売っている。", false],
		[28, "", "[[step/28]]では、[[station/91]]付近でヴォイドの活動が報告されたことを受け、[[character/0]]がワームホールに潜り込むためにここへやって来る。", false],
	],
	"system/19": [
		[0, "", "[[system/19]]は星図の中央にあるTerranの星系で、治安は安全と評価されている。[[station/95]]にあるゲートで[[system/3]]、[[system/8]]、[[system/9]]、[[system/14]]につながっている。", false],
		[15, "", "[[station/98]]は、逮捕された[[character/0]]がTerranの巡洋艦で連れてこられ、旧友[[character/1]]と再会する場所である。", false],
		[16, "", "この安全な星系でさえ無事ではない。[[step/16]]ではヴォイドの飛行隊が[[station/98]]を襲撃する。[[character/1]]はここに本部を構えている。", false],
	],
	"system/2": [
		[0, "", "[[system/2]]は星図の左側にあるNivelianの星系で、Nivelian宙域の交差点である。[[station/30]]にあるゲートで[[system/0]]、[[system/8]]、[[system/9]]、[[system/17]]につながっている。テックレベル中程度のステーションが4つある。", false],
		[34, "", "[[step/33]]で[[character/6]]は[[character/0]]を[[station/30]]へ送り出し、そこでは[[character/1]]が新たな計画を携えて待っている。ヴォイドに対する最後の準備もここで行われる。", false],
	],
	"system/20": [
		[0, "", "[[system/20]]は星図の右下にあるVosskの星系で、治安は非常に危険と評価されている。[[station/62]]にあるゲートで[[system/5]]と[[system/21]]につながっており、[[system/21]]へ通じる唯一のゲート航路である。", false],
		[0, "", "小さなステーション[[station/59]]では、Terranのエージェント[[agent/10]]が設計図を売っている。", false],
	],
	"system/21": [
		[0, "", "[[system/21]]は星図の右下の最も奥の隅にあるVosskの星系で、治安は非常に危険と評価されている。[[agent/15]]から座標を買うまで隠されている。[[station/12]]にあるゲートは[[system/20]]にしか通じていない。ステーションはすべて原始的で、テックレベルは3以下である。", false],
	],
	"system/3": [
		[0, "", "[[system/3]]は星図の中央に最も近いVosskの星系で、Vossk宙域への主要な入口である。[[station/15]]にあるゲートで[[system/5]]、[[system/12]]、[[system/8]]、[[system/14]]、[[system/19]]につながっている。治安は普通と評価されている。", false],
		[0, "", "[[station/18]]のエージェント[[agent/12]]が、隠された[[system/0]]星系の座標を売っている。", false],
	],
	"system/4": [
		[0, "", "[[system/4]]は星図の左上隅にあるMidorianの星系で、治安は非常に危険と評価されている。行き止まりの星系であり、[[station/20]]にあるゲートは[[system/17]]にしか通じていない。ステーションは原始的な[[station/21]]から設備の整った[[station/22]]までさまざまである。", false],
		[0, "", "[[station/20]]のラウンジでは、エージェント[[agent/2]]が設計図を売っている。", false],
		[38, "", "[[step/38]]では、Nivelianの爆薬を運ぶ奪われた輸送船団が、この星系の[[station/22]]付近で追跡される。", false],
	],
	"system/5": [
		[0, "", "[[system/5]]は星図の右下にあるVosskの星系で、治安は危険と評価されている。[[station/25]]にあるゲートで[[system/3]]、[[system/12]]、[[system/20]]につながっている。[[station/26]]ではエージェント[[agent/13]]が座標を売っている。", false],
		[35, "", "この星系はVossk司令官[[character/7]]の本拠地であり、[[step/35]]で[[character/0]]は[[station/29]]で彼と会う。", false],
		[36, "", "二人の勝負は[[station/27]]の近くで行われる。", false],
	],
	"system/6": [
		[0, "", "[[system/6]]は星図の右上にあるTerranの星系で、治安は非常に危険と評価されている。標準の星図には載っておらず、座標は物語の中でのみ明らかになる。ステーションは[[station/10]]の一つだけで、そのゲートは[[system/7]]にしか通じていない。", false],
		[23, "", "この星系にはDeep Scienceの秘密研究ステーションが隠されている。[[step/22]]で[[character/5]]が[[character/0]]にその座標を渡し、ヴォイドとの戦いの多くはここで計画される。", false],
	],
	"system/7": [
		[0, "", "[[system/7]]は星図の右上にあるTerranの星系で、治安は危険と評価されている。[[station/35]]にあるゲートで[[system/11]]と隠された[[system/6]]につながっており、隠された星系へ通じる唯一のゲート航路となっている。最も高度なステーションは[[station/37]]である。", false],
	],
	"system/8": [
		[0, "", "[[system/8]]は星図の左下四分の一にあるTerranの星系で、銀河で最も接続の多い星系である。[[station/40]]にあるゲートで、[[system/0]]、[[system/1]]、[[system/2]]、[[system/3]]、[[system/18]]、[[system/19]]の6つの星系につながっている。治安は普通と評価されている。", false],
		[0, "", "[[station/43]]ではエージェント[[agent/4]]が設計図を売っている。", false],
	],
	"system/9": [
		[0, "", "[[system/9]]は星図の中央上部にあるNivelianの星系で、治安は普通と評価されている。[[station/45]]にあるゲートで[[system/2]]、[[system/11]]、[[system/17]]、[[system/19]]につながっている。", false],
		[24, "", "[[station/48]]の近くでヴォイドの活動が報告され、[[step/24]]で[[character/0]]と[[character/6]]は残骸を回収するためにそこへ向かう。", false],
	],
	"world/galaxy": [
		[0, "概要", "ゲームの舞台は、22の星系からなる一つの銀河である。各星系はいずれか一つの勢力に属し、治安の評価を持ち、1～5基の宇宙ステーションを擁する。どのステーションも惑星を周回しており、それぞれにショップ、ハンガー、スペースラウンジがある。星系は平面の星図上に配置され、星系間の移動はジャンプゲートの網を通じて行われる。", false],
		[0, "", "星図に載っている星系は四つの種族が支配している。[[faction/0|Terran]]が10、[[faction/1]]が6、[[faction/2|Nivelian]]が4、[[faction/3|Midorian]]が2つの星系を持つ。[[faction/4|Multipod]]、[[faction/5|Cyborg]]、[[faction/6|Bobolian]]、[[faction/7]]といった少数種族は、自らの領土を持たずに彼らの間で暮らしている。[[faction/8|海賊]]はあらゆる星系をうろつき、また当初から[[faction/9|ヴォイド]]と呼ばれる敵対勢力の噂がある。", false],
		[0, "配置", "NivelianとMidorianの星系は星図の左上、[[system/15]]、[[system/4]]、[[system/17]]、[[system/2]]の周辺にある。Terranの宙域は星図の中央、右側、下部に広がり、[[system/19]]と[[system/14]]がその中心である。Vosskの星系は右下で独立した一角をなし、[[system/3]]に始まって最も奥の隅の[[system/21]]で終わる。", false],
		[0, "", "ゲートの航路は中央に集中している。[[system/8]]はどの星系よりも多い6本のゲート接続を持ち、[[system/19]]、[[system/14]]、[[system/3]]、[[system/11]]はそれぞれ4～5の星系とつながっている。[[system/4]]、[[system/6]]、[[system/21]]など端にある星系は、接続が1本しかない行き止まりである。", false],
		[0, "移動", "星系内では、船は通常のドライブでステーションの軌道から別のステーションの軌道へ移動する。星系を出るには、星系内のステーションの一つにあるジャンプゲートを通過する。ゲートが通じているのは接続先の星系だけである。長距離の移動はゲートジャンプの連続となる。ゲート網を経由せず、既知の星系へ直接行く唯一の手段がジャンプドライブである。[[guide/navigation]]を参照。", false],
		[33, "", "ゲームに登場するジャンプドライブは、物語の中で[[character/20]]が設計する[[item/85]]だけである。これは設計図から製造し、材料には[[item/164]]などが必要となる。", false],
		[0, "治安", "各星系の治安は、安全（Safe）、普通（Average）、危険（Risky）、非常に危険（Dangerous）のいずれかに評価されている。この評価によって、到着時にステーション付近で襲撃者が待ち伏せている頻度が決まる。非常に危険な星系ではほとんどの訪問で現れ、安全な星系ではまれである。襲撃者はたいてい海賊だが、その勢力と敵対する種族の船のこともある。一方、治安の良い星系ほど、ステーションの周囲を巡回する地元の警備船が多い。", false],
		[0, "勢力と評判", "あなたの評判は二つの尺度で管理される。一つはTerranとVosskの間、もう一つはNivelianとMidorianの間である。一方の側の好感度を上げると、もう一方の側の好感度が下がる。ある勢力からの評判が下がりすぎると、その勢力の船は見つけ次第攻撃してきて、ステーションも受け入れを拒否する。海賊とヴォイドは常に敵対的である。スペースラウンジの外交官に料金を払えば評判を回復できる。", false],
		[0, "隠された星系", "すべての星系が最初から星図に表示されるわけではない。[[system/0]]、[[system/1]]、[[system/10]]、[[system/21]]は、スペースラウンジのエージェントから座標を買うまで隠されている。[[guide/lounge]]を参照。もう一つの星系[[system/6]]は標準の星図に載っておらず、物語の中でのみ明らかになる。", false],
		[23, "", "[[system/6]]の座標は[[step/22]]で[[character/5]]から伝えられる。この星系にはステーションが一つしかなく、それが研究組織Deep Scienceの秘密研究基地[[station/10]]である。", false],
		[0, "", "[[system/15]]と[[system/10]]の二つの星系には、ゲート接続がまったくない。これらの星系に出入りするにはジャンプドライブが必要である。", false],
		[0, "孤立した出発点", "物語は、星図の最上部にある辺境の星系[[system/15]]で始まる。この星系は銀河の他の部分とゲートでつながっていない。交易は乏しく、ステーションのテックレベルは低く、シップディーラーは物語の序盤のあいだ閉まっている。序盤では、物語が用意する方法以外にこの星系を出る手段はない。", false],
		[11, "", "[[system/15]]は[[faction/3|Mido連邦]]の本拠地である。この連邦は、Nivelian内戦の際に新たに発見されたこの宙域に入植したTerranとNivelianの難民や無法者の集団で、独立を宣言した。Terranはこれを認めているが、Nivelianはいまだにこの星系の領有を主張しており、そのため辺境では戦闘が続いている。", false],
		[15, "", "[[character/0]]は、[[step/14]]で[[station/79]]の輸送船団に無力化されて逮捕され、Terranの巡洋艦に乗せられて[[system/15]]を離れる。彼が到着するのは、Terran宙域の奥深くにある[[system/19]]の[[station/98]]である。", false],
		[9, "時間の隔たり", "[[system/15]]で目覚めた[[character/0]]は、わずかな時間しか経っていないと思っている。実際には、損傷したハイパードライブが彼を銀河の反対側へ、そして約35年後の未来へと飛ばしていた。彼の知る銀河は変わってしまった。旧友たちは年老いたり亡くなったりし、その間に彼が今いる場所を含む新たな宙域が開拓されている。", false],
		[10, "", "彼の船と同じ型の欠陥ハイパードライブは、以前にも同様の時空を超えたジャンプを引き起こしてきた。", false],
		[18, "星図の外", "ヴォイドは、ある種のワームホールを通って星図上の星系に侵入してくる。彼らはTerran、Nivelian、Vosskの宙域を区別なく襲撃し、鉱石を狙っているように見える。[[world/voids]]を参照。", false],
		[25, "", "ワームホールは星図に載っている銀河の外、星図上に位置を持たないヴォイド自身の宙域へと通じている。ワームホールはしばらくの間ステーションの近くに開き、その後崩壊して別の場所に現れる。", false],
		[34, "", "[[item/85]]を装備すれば、ヴォイド宙域へ直接ジャンプすることもできる。", false],
		[32, "", "[[step/31]]以降は、早期警戒システムによって次のワームホールが開く場所が星図に表示される。", false],
		[42, "", "[[step/41]]でヴォイドの母艦が破壊されると、宙域全体のワームホールが崩壊し、襲撃は止む。", false],
	],
	"world/history": [
		[0, "", "銀河には複数の種族が暮らしており、その中には[[faction/0|Terran]]、[[faction/2|Nivelian]]、[[faction/1|Vossk]]がいる。各種族のステーションの間に広がる宇宙は[[faction/8|海賊]]に悩まされている。このページは物語の概要をまとめたもので、各部分はセーブがその地点に達すると表示される。", false],
		[0, "第1幕：漂着", "Terranの賞金稼ぎ[[character/0]]は、小惑星帯で海賊の一団を壊滅させる（[[step/0]]）。", false],
		[1, "", "かつての上官Smith提督に会うためにジャンプした瞬間、最後の一撃がハイパードライブを損傷させる。船は気を失ったパイロットを乗せたまま漂流し、[[station/78]]に流れ着く。", false],
		[2, "", "Nivelianの鉱石商人[[character/2]]が残骸を回収し、船を自分のものにして、Keithに自分のための採掘をさせる。", false],
		[8, "", "Keithは、Gunantが近くの海賊の隠れ家を壊滅させるのを手伝う（[[step/7]]）。", false],
		[9, "", "その後Keithは、今が3624年であり、Smith提督がとうの昔に亡くなっていることを知る。", false],
		[10, "", "ハイパードライブの故障によって、Keithは35年後の未来の、銀河の辺境へと運ばれていたのだ。Gunantは彼に船[[ship/0]]を譲り、[[station/79]]の[[character/3]]のもとへ送り出す。", false],
		[11, "", "[[system/15]]星系は[[faction/3|Mido連邦]]に属している。この連邦はNivelian内戦の際、TerranとNivelianの亡命者たちによって建国された。", false],
		[12, "", "Keithは、連絡の途絶えたステーション[[station/76]]が、売人[[character/4]]の持ち込んだ薬物で麻痺状態に陥っていることを突き止める（[[step/11]]）。", false],
		[15, "", "通りかかったTerranの輸送船団はKeithを海賊と誤認し、彼の船を無力化して[[station/98]]へ連行する（[[step/14]]）。", false],
		[16, "第2幕：ヴォイドの脅威", "そこで彼は、今や保安局長となった旧友[[character/1]]と再会する。ちょうどそのとき、[[faction/9|ヴォイド]]がステーションを襲撃する。", false],
		[18, "", "ヴォイドは鉱石を求め、ワームホールを通って各星系を襲撃している。Brentは、ヴォイドを研究する秘密研究組織Deep ScienceのパイロットとしてKeithを雇う（[[step/17]]）。", false],
		[19, "", "Keithを研究ステーションへ案内するはずだった科学者[[character/5]]が、海賊に誘拐される。", false],
		[23, "", "KeithはEMP爆弾で誘拐犯の船を無力化して彼を救出し、[[system/6]]星系の座標を受け取る（[[step/21]]、[[step/22]]）。", false],
		[24, "第3幕：Deep Science", "[[station/10]]でKeithはプロジェクトリーダーの[[character/6]]と出会い、Deep Scienceのために働き始める。", false],
		[25, "", "KeithとCarlaは[[station/48]]でヴォイドの残骸を回収するが、ワームホールに船ごと飲み込まれる（[[step/24]]）。", false],
		[26, "", "二人はヴォイドの本拠宙域で巨大な母艦のそばにいることに気づき、別のワームホールから脱出する。", false],
		[30, "", "Keithは[[station/91]]付近のワームホールからヴォイド宙域へ戻り、母艦に探査機を撃ち込む（[[step/29]]）。", false],
		[32, "", "Brentは、ヴォイドが次に襲撃する場所を示す早期警戒システムをKeithに提供する。", false],
		[34, "", "Greyの科学者[[character/20]]は、新型の瞬間ドライブのためにKeithにヴォイドの結晶を集めさせ、その設計図を彼に与える（[[step/33]]）。", false],
		[35, "第4幕：攻撃", "探査機のデータから、母艦がワームホールを生み出していることが判明する。BrentとCarlaは、Vossk司令官[[character/7]]が提供する貨物船にNivelianの爆薬を満載し、母艦を破壊する計画を立てる。", false],
		[37, "", "Errktは自ら貨物船を操縦すると言い張り、Keithは彼を護衛する権利を勝ち取る（[[step/36]]）。", false],
		[39, "", "爆薬を運ぶ輸送船団がMidoの艦船に奪われ、Keithがそれを奪還する（[[step/38]]）。", false],
		[42, "", "[[character/8]]率いる増援とともに、KeithはErrktをワームホールの向こうへ護衛する。Errktは貨物船ごと母艦に突入し、この攻撃で命を落とす（[[step/41]]）。", false],
		[43, "", "すべてのワームホールが崩壊し、ヴォイドの襲撃は終わる。", false],
		[45, "エピローグ", "KeithはBrentと勝利を祝い、ついにCarlaと一夜を共にする。彼女は翌朝、別の秘密プロジェクトのために去り、Keithは自由に銀河を巡る身となる。", false],
	],
	"world/voids": [
		[0, "", "[[faction/9|ヴォイド]]は物語の中心となる脅威である。このページには彼らについて判明したことをまとめており、セーブが進むにつれて内容が増える。", false],
		[2, "最初の情報", "Keithが初めてヴォイドのことを聞くのは[[character/2]]からである。辺境の[[system/15]]星系にさえ時折現れる、敵対的な存在だという。", false],
		[9, "", "Mido星系の人々は、3624年がヴォイドの年として記憶されるだろうと考えている。", false],
		[16, "", "ヴォイドの戦闘機がTerran宙域の[[station/98]]を襲撃する（[[step/15]]）。", false],
		[17, "", "攻撃の最中、ヴォイドは平和のために来たと主張するメッセージを発信するが、攻撃をやめることはない。", false],
		[18, "判明していること", "ヴォイドは数週間前から現れ始めた。彼らはワームホールを通って人の住む星系に侵入し、遭遇したものすべてを攻撃し、鉱石を狙っているように見える。[[faction/1]]の星系でさえ襲撃を受けている。彼らがどこから来たのか、何が目的なのかは誰にもわからない。", false],
		[24, "", "[[station/48]]で彼らは、自分たちは未来から来た者であり、銀河の文明の唯一の生き残りだと告げる。", false],
		[26, "本拠宙域", "彼らのワームホールは遠く離れた本拠宙域に通じており、そこでは巨大な母艦が戦闘機を発進させている。ワームホールは短時間だけ開いたあと崩壊し、別の場所に再び現れる。", false],
		[28, "", "ヴォイドは、自分たちを滅ぼせば人類の未来も滅びると警告する。", false],
		[30, "", "彼らは、人類が自分たちを滅ぼし、それによって人類自身の未来をも滅ぼす前に、意思疎通の手段を見つけなければならないと繰り返す。この主張が真実かどうかは最後まで明らかにならない。", false],
		[32, "", "[[character/1]]のチームが開発した早期警戒システムは、ヴォイドが次にワームホールを開く場所を予測する。", false],
		[33, "", "Greyの科学者[[character/20]]は、ヴォイド宙域でしか見つからない結晶[[item/164]]に、彼らのワームホールの秘密が隠されていると考えている。", false],
		[35, "襲撃の終わり", "母艦に撃ち込まれた探査機により、母艦こそがワームホールの発生源であることが判明する。既知のどの兵器も母艦に損傷を与えられていない。", false],
		[42, "", "[[character/7]]が操縦する、Nivelianの核爆薬を積んだVosskの貨物船が母艦を破壊する（[[step/41]]）。", false],
		[43, "", "その後、宙域全体でワームホールが崩壊し、ヴォイドの襲撃は少なくとも当面のあいだ止む。", false],
	],
}
