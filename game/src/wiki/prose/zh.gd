	"item/174": [
		[0, "", "这种矿核是 A 级 [[item/163]] 小行星罕见的核心。钻穿此类小行星的全部七层即可获得，A 级小行星被击碎时偶尔也会掉落一个。它的售价是矿石本身的好几倍，在 [[system/5]] 最便宜。", false],
	],
	"item/175": [
		[0, "", "[[item/175]] 是 A 级 [[item/164]] 小行星的矿核。由于水晶小行星被击碎后什么也不会留下，获得它的唯一方法就是钻穿全部七层。它的售价固定为 5,000 信用点，是其他任何矿核最高售价的五倍以上。", false],
		[25, "", "它只能在 [[faction/9|Void]] 的母星空间中找到。", false],
	],
	"item/18": [
		[0, "", "[[item/18]] 是最强的 EMP 爆能枪：每 0.5 秒一发，每次命中消耗 8 点能量，射程 2,000，瘫痪飞船的速度明显快于 [[item/17]]。与其他 EMP 爆能枪一样，它不会造成船体伤害。", false],
	],
	"item/19": [
		[0, "", "[[item/19]] 每 0.3 秒造成 15 点伤害，射程 1,400。它的持续伤害远高于任何激光。[[item/20]] 和 [[item/21]] 射速更快，但射程只有 1,000 单位。", false],
	],
	"item/2": [
		[0, "", "[[item/2]] 是顶级的 Nirai 激光：每 0.4 秒造成 7 点伤害。单发威力不如 Berger 系列激光，但由于射速约为它们的两倍，其持续伤害高于其中任何一款，包括 [[item/8]]。只有 M6 光束激光（[[item/9]] 及其后续型号）明显胜过它。", false],
	],
	"item/20": [
		[0, "", "[[item/20]] 每 0.2 秒一发，造成 13 点伤害。它的持续伤害高于 [[item/19]]，但射程只有 1,000 单位，因此最适合近距离作战。", false],
	],
	"item/21": [
		[0, "", "[[item/21]] 每 0.2 秒造成 14 点伤害，是所有前射枪炮中持续伤害最高的。与 [[item/20]] 一样，它的射程只有 1,000 单位。它也是商店中最稀有的爆能枪。", false],
	],
	"item/22": [
		[0, "", "[[item/22]] 是游戏中最弱的枪炮：每 0.4 秒造成 2 点伤害，射程 1,000。自动炮发射小而快的弹丸；伤害轻微，但有些型号射速极快。这第一款只是权宜之计。", false],
		[6, "", "在突袭海盗巢穴之前，[[character/2]] 在 [[station/78]] 的机库中免费提供三件物品，这是其中之一，另外两件是 [[item/0]] 和 [[item/55]]。", false],
	],
	"item/23": [
		[0, "", "[[item/23]] 的单发伤害是 [[item/22]] 的两倍，达到 4 点，射速也稍快（每 0.3 秒一发），射程仍为 1,000。它是一种廉价的早期武器。", false],
	],
	"item/24": [
		[0, "", "[[item/24]] 每 0.3 秒造成 6 点伤害，射程 1,200。它是一款扎实的中档自动炮，持续伤害与射程更远的 [[item/25]] 相当。", false],
	],
	"item/25": [
		[0, "", "[[item/25]] 每 0.4 秒造成 8 点伤害，射程 1,400 单位，是所有自动炮中射程最远的。它的持续伤害与 [[item/24]] 相同。它从不以成品出售。其蓝图来自 [[station/20]] 的 [[agent/2]]，只需大宗商品即可制造，无需矿石。", false],
	],
	"item/26": [
		[0, "", "[[item/26]] 每 0.2 秒一发，造成 5 点伤害，射程 1,000。凭借快速的射击，它的持续伤害高于轨道炮，代价是射程较短。", false],
	],
	"item/27": [
		[0, "", "[[item/27]] 每 0.1 秒一发，是所有自动炮中射速最快的，每发造成 6 点伤害。它的持续伤害接近最好的爆能枪，但 900 的射程是所有枪炮中最短的。它从不以成品出售。其蓝图来自 [[station/10]] 的 [[agent/3]]，制造时需要 [[item/154]] 等货物。", false],
	],
	"item/28": [
		[0, "", "[[item/28]] 是第一款热能炮。热能炮以 1,000 的射程快速发射轻型弹丸；这一款每 0.3 秒造成 3 点伤害。尽管科技等级很高，它的持续伤害却不如大多数中档爆能枪和自动炮。", false],
	],
	"item/29": [
		[0, "", "[[item/29]] 每 0.2 秒造成 4 点伤害，射程 1,000，持续伤害是 [[item/28]] 的两倍。", false],
	],
	"item/3": [
		[0, "", "[[item/3]] 是一种 [[faction/1|Vossk]] 激光，每 0.5 秒造成 7 点伤害。单发伤害与 [[item/2]] 相当，但射速稍慢，因此持续伤害略逊一筹。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
		[0, "", "开场时，[[character/0]] 的 [[ship/10]] 上装有两门这种激光。", false],
	],
	"item/30": [
		[0, "", "[[item/30]] 每 0.1 秒一发，造成 3 点伤害，是射速最快的热能炮。它的持续伤害高于 [[item/29]]，但低于 [[item/21]] 等顶级爆能枪。", false],
	],
	"item/31": [
		[0, "", "[[item/31]] 是基础的 [[faction/1|Vossk]] 火箭弹，也是最便宜的副武器弹药：每次命中 60 点伤害，每 1.2 秒发射一枚，射程 1,200。火箭弹直线飞行，不会追踪目标，因此最适合近距离使用。任何火箭弹或鱼雷击中小行星都会将其击碎。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/32": [
		[0, "", "[[item/32]] 是常见的无制导火箭弹：每次命中 70 点伤害，每 0.9 秒发射一枚，射程 1,200。它比 [[item/31]] 伤害更高、发射更快，出售范围也很广。", false],
	],
	"item/33": [
		[0, "", "[[item/33]] 造成 72 点伤害，同时消耗 34 点能量，因此既能造成伤害，又有助于瘫痪目标。它的装填较慢（2 秒），射程 1,000 单位。它从不以成品出售。其蓝图来自 [[station/43]] 的 [[agent/4]]，一批只需几种便宜的大宗商品。", false],
	],
	"item/34": [
		[0, "", "[[item/34]] 用于瘫痪而不是摧毁目标：每次命中消耗 45 点能量，只造成 10 点伤害，每秒发射一枚。[[item/35]] 消耗的能量更多，伤害也更高。", false],
	],
	"item/35": [
		[0, "", "[[item/35]] 每次命中消耗 60 点能量并造成 30 点伤害，每秒发射一枚，射程 1,000。它瘫痪飞船的速度快于 [[item/34]]，同时还能削弱其船体。", false],
	],
	"item/36": [
		[0, "", "[[item/36]] 是基础鱼雷。鱼雷在最初 1.5 秒内直线飞行，然后追踪目标。[[item/36]] 造成 70 点伤害，射程 3,000 单位，但速度慢，每 3 秒才能发射一枚。[[item/38]] 的伤害是它的两倍。", false],
	],
	"item/37": [
		[0, "", "[[item/37]] 是速度最快的鱼雷：造成 100 点伤害，消耗 50 点能量，射程 4,000 单位。每 4 秒发射一枚。它从不以成品出售。其蓝图来自 [[station/54]] 的 [[agent/5]]，一批只需几种大宗商品。", false],
	],
	"item/38": [
		[0, "", "[[item/38]] 是伤害最高的鱼雷，每次命中 140 点伤害，射程 4,000。它飞行速度慢，每 4 秒发射一枚。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/39": [
		[0, "", "[[item/39]] 是一种用于瘫痪飞船的追踪鱼雷：消耗 100 点能量，不造成伤害。射程 5,000，是从远处让目标停下的廉价手段。[[item/40]] 在同样的能量消耗之外还附加 120 点伤害。", false],
	],
	"item/4": [
		[0, "", "[[item/4]] 是更强的 [[faction/1|Vossk]] 激光：每 0.6 秒造成 10 点伤害。它的持续伤害几乎与 [[item/2]] 完全相同，与 [[item/3]] 相比则单发更重、射速更慢。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/40": [
		[0, "", "[[item/40]] 将 120 点伤害和 100 点能量消耗结合在一枚追踪鱼雷中，射程 5,000，每 5 秒发射一枚。它的价格是 [[item/39]] 的两倍多。", false],
	],
	"item/41": [
		[0, "", "[[item/41]] 是最小的 EMP 炸弹。按一次发射炸弹，再按一次引爆；爆炸会消耗半径范围内所有飞船的能量，越靠近中心越强，但不会波及发射它的飞船。小行星不受影响。这一型号在 22,000 的半径内最多消耗 80 点能量。[[item/42]] 和 [[item/43]] 更强，范围也更广。", false],
		[20, "", "[[faction/0|Terran]] 安全部门在 [[station/55]] 免费留下了十枚这种炸弹，让 [[character/0]] 能够瘫痪而不是摧毁绑匪的飞船。", false],
	],
	"item/42": [
		[0, "", "[[item/42]] 在 30,000 的半径内最多消耗 150 点能量，强度几乎是 [[item/41]] 的两倍，爆炸范围也大得多。", false],
	],
	"item/43": [
		[0, "", "[[item/43]] 是最强的 EMP 炸弹：在 37,000 的半径内最多消耗 300 点能量。它的充能比 [[item/42]] 稍快，但价格几乎是其两倍。", false],
	],
	"item/44": [
		[0, "", "[[item/44]] 是最小的核弹。与 EMP 炸弹一样，它先发射，再按一次引爆，但其爆炸会造成实际伤害：在 20,000 的半径内最多 200 点，越靠边缘越少。它还能击碎小行星。发射它的飞船不会受到伤害。", false],
	],
	"item/45": [
		[0, "", "[[item/45]] 在 30,000 的半径内最多造成 560 点伤害，威力几乎是 [[item/44]] 的三倍，爆炸范围也更大。", false],
	],
	"item/46": [
		[0, "", "[[item/46]] 是游戏中破坏力最强的武器：在 40,000 的半径内最多造成 950 点伤害。它从不以成品出售。其蓝图来自 [[station/61]] 的 [[agent/6]]，制造时需要放射性货物和炸药等大宗商品。", false],
	],
	"item/47": [
		[0, "", "[[item/47]] 是基础炮塔。炮塔安装在专门的槽位上，只有部分船体才有，它可以全方位旋转，因此能击中飞船侧面或后方的目标；你瞄准炮塔时，飞船会自行继续飞行。这一型号每 0.3 秒造成 6 点伤害，射程 2,000，转动较慢（操控性 40）。", false],
	],
	"item/48": [
		[0, "", "[[item/48]] 每 0.2 秒造成 10 点伤害，射程 2,500，转动速度比 [[item/47]] 快（操控性 60）。它的价格是后者的三倍多。", false],
	],
	"item/49": [
		[0, "", "[[item/49]] 是最好的炮塔：每 0.1 秒造成 12 点伤害，射程 3,000，回转速度最快（操控性 100）。它也非常昂贵，价格约为 [[item/48]] 的两倍。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/5": [
		[0, "", "[[item/5]] 是 Berger 激光系列的首款，以射速换取更重的单发伤害和稍远的射程（2,200）。它每 0.9 秒造成 8 点伤害，持续伤害低于更便宜的 [[item/2]]。它的优势在于射程更远。", false],
	],
	"item/50": [
		[0, "", "[[item/50]] 是基础护盾。护盾会在装甲和船体受损之前吸收来袭的伤害，并在其充能时间内自行恢复。Targe 只能承受 50 点，但 20 秒即可完全恢复，比其他任何护盾都快。", false],
	],
	"item/51": [
		[0, "", "[[item/51]] 可承受 80 点，但需要 46 秒才能完全恢复。在一场战斗中，它比 [[item/50]] 吸收得更多，但在两次攻击之间恢复得慢得多。", false],
	],
	"item/52": [
		[0, "", "[[item/52]] 是一种 [[faction/1|Vossk]] 护盾，可承受 120 点，58 秒恢复完毕。它比 [[item/51]] 吸收得多得多，但 [[item/53]] 承受得更多、恢复得更快。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/53": [
		[0, "", "[[item/53]] 可承受 150 点，45 秒恢复完毕，在两方面都胜过 [[item/52]]。它是商店出售的最好的护盾。", false],
	],
	"item/54": [
		[0, "", "[[item/54]] 是最强的护盾：220 点，60 秒恢复完毕。它从不以成品出售。其蓝图来自 [[station/72]] 的 [[agent/7]]，制造时需要大量 [[item/163]]，外加电子元件、纳米技术产品和微芯片。", false],
	],
	"item/55": [
		[0, "", "[[item/55]] 是基础装甲板。装甲板会把自身的点数加到飞船的装甲上；它在护盾之后、船体之前承受伤害，而且与护盾不同，它不会充能恢复。E2 增加 40 点，对于 [[ship/32]] 这样自身只有 100 点的轻型入门飞船来说，这是很大的比例。", false],
		[6, "", "在突袭海盗巢穴之前，[[character/2]] 在 [[station/78]] 的机库中免费提供三件物品，这是其中之一，另外两件是 [[item/0]] 和 [[item/22]]。", false],
	],
	"item/56": [
		[0, "", "[[item/56]] 增加 80 点装甲，是 [[item/55]] 的两倍，价格也不贵。", false],
	],
	"item/57": [
		[0, "", "[[item/57]] 增加 110 点装甲。它是 [[faction/1|Vossk]] 星系以外出售的最好的装甲板。", false],
	],
	"item/58": [
		[0, "", "[[item/58]] 是一种 [[faction/1|Vossk]] 装甲板，增加 160 点装甲，远多于 [[item/57]]。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/59": [
		[0, "", "[[item/59]] 是最好的装甲板：增加 250 点，与 [[ship/9]] 的基础装甲相当，并且高于除 [[ship/8]] 以外任何船体的基础装甲。它从不以成品出售。其蓝图来自 [[station/84]] 的 [[agent/8]]，制造时需要 [[item/157]]、[[item/168]] 和 [[item/156]]，外加大宗商品。", false],
	],
	"item/6": [
		[0, "", "[[item/6]] 每 0.8 秒造成 9 点伤害，射程 2,200。它比 [[item/5]] 略有提升，价格在各星系之间几乎没有差别。", false],
	],
	"item/60": [
		[0, "", "[[item/60]] 是三种 EMP 防护模块中最弱的一种，EMP 防御为 20。这三种模块都没有标价，也没有商店出售。", false],
	],
	"item/61": [
		[0, "", "[[item/61]] 是中档的 EMP 防护模块，EMP 防御为 40，是 [[item/60]] 的两倍。与同系列的其他模块一样，它没有标价，也没有商店出售。", false],
	],
	"item/62": [
		[0, "", "[[item/62]] 是最强的 EMP 防护模块，EMP 防御为 60。与 [[item/60]] 和 [[item/61]] 一样，它没有标价，也没有商店出售。", false],
	],
	"item/63": [
		[0, "", "[[item/63]] 是基础的货物压缩器。压缩器可以按船体自身容量的一定百分比扩大货舱；这一款增加 15%。它价格便宜，对任何商人或矿工来说都值得购买。", false],
	],
	"item/64": [
		[0, "", "[[item/64]] 可将货舱扩大 25%，以低廉的价格比 [[item/63]] 有了明显提升。", false],
	],
	"item/65": [
		[0, "", "[[item/65]] 可将货舱扩大 40%。在大型货船上，它增加的空间相当于一整艘小型飞船的载货量。", false],
	],
	"item/66": [
		[0, "", "[[item/66]] 可将货舱扩大 75%，是商店出售的压缩器中最多的。", false],
	],
	"item/67": [
		[0, "", "[[item/67]] 可使货舱翻倍，增加船体容量的 100%：装上它的 [[ship/36]] 可载货 700 吨。它从不以成品出售。其蓝图来自 [[station/90]] 的 [[agent/9]]，只需大宗商品即可制造。", false],
	],
	"item/68": [
		[0, "", "[[item/68]] 是基础牵引光束。没有牵引光束就无法收集任何漂浮的集装箱；直接飞过去也没有用。使用 Retractor 时，需要让集装箱在准星下保持 4 秒，随后它就会被拉进来。[[item/69]] 所需时间更短，[[item/70]] 则可以自动工作。", false],
		[24, "", "在第一次对 [[faction/9|Void]] 的远征之前，[[character/6]] 要求 [[character/0]] 装上牵引光束，以便收集他们飞船的残骸。在此之前，商店除了通常的货品之外，很有可能还会供应一台 Retractor。", false],
	],
	"item/69": [
		[0, "", "[[item/69]] 的工作方式与 [[item/68]] 相同，但只需让目标在准星下保持 3 秒即可拉进集装箱。", false],
	],
	"item/7": [
		[0, "", "[[item/7]] 每 0.8 秒造成 10 点伤害，射程 2,200。它的持续伤害与 [[item/1]] 相当，因此其价值在于远距离下次数更少但更重的打击。", false],
	],
	"item/70": [
		[0, "", "[[item/70]] 是自动牵引光束：它会收集前方视野中的任何集装箱，无需瞄准并保持，在搜刮战场时能节省大量时间。它比 [[item/69]] 贵得多。", false],
	],
	"item/71": [
		[0, "", "[[item/71]] 是基础加速器。加速器提供一阵短暂的额外速度，然后需要时间充能。这一款在 3 秒内增加 60% 的速度，充能需要 8 秒。", false],
	],
	"item/72": [
		[0, "", "[[item/72]] 的额定值为 4.4 秒内额外增加 80% 速度，充能 10 秒。飞行中，它的加速所达到的最高速度与 [[item/71]] 相同；它增加的是更长的加速时间。", false],
	],
	"item/73": [
		[0, "", "[[item/73]] 的增幅是较便宜加速器的两倍多：在 5.6 秒内额外增加 160% 速度，充能 12 秒。", false],
	],
	"item/74": [
		[0, "", "[[item/74]] 是最强的加速器：在 6 秒内额外增加 200% 速度。它所需的充能时间最长，为 16 秒。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/75": [
		[0, "", "[[item/75]] 是游戏中唯一的维修机器人，安装在装备槽位中。飞行时，它每 0.6 秒恢复一点船体，每秒恢复一点装甲板，因此两场战斗之间无需停靠，损伤也会逐渐恢复。它价格便宜，大多数商店都有出售。", false],
	],
	"item/76": [
		[0, "", "[[item/76]] 是基础转向喷口。喷口会把自身数值加到飞船的操控性上，让飞船转向更快。这一款增加 20 点，对灵活的战斗机来说提升不大，但在迟缓的货船上就很明显。", false],
	],
	"item/77": [
		[0, "", "[[item/77]] 增加 40 点操控性，是 [[item/76]] 的两倍，价格低廉。", false],
	],
	"item/78": [
		[0, "", "[[item/78]] 是一种 [[faction/1|Vossk]] 喷口，增加 70 点操控性。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/79": [
		[0, "", "[[item/79]] 是一种 [[faction/1|Vossk]] 喷口，增加 100 点操控性，足以让重型货船像灵活的战斗机一样转向。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/8": [
		[0, "", "[[item/8]] 是最后一款也是最强的 Berger 激光：每 0.9 秒一发，每发 12 点伤害，射程 2,200。它是单发伤害最高的常规激光，但射速更快的 [[item/2]] 持续伤害仍然更高。之后的 M6 光束激光（从 [[item/9]] 起）单发伤害是它的两倍以上。", false],
	],
	"item/80": [
		[0, "", "[[item/80]] 是最好的转向喷口，增加 130 点操控性。它能把转向最慢的船体 [[ship/36]] 从 45 提升到 175，比任何未装喷口的战斗机都高。它在商店中很少见。", false],
	],
	"item/81": [
		[0, "", "[[item/81]] 是基础扫描仪。扫描仪决定锁定飞船、空间站或小行星等目标所需的时间；Quickscan 需要 4 秒。[[item/82]] 锁定更快，还能显示其他飞船载着什么。", false],
		[2, "", "[[character/2]] 的采矿船 [[ship/0]] 出厂就装有一台。", false],
	],
	"item/82": [
		[0, "", "[[item/82]] 在 3 秒内完成锁定，并显示被锁定飞船所载的货物，在寻找战利品时很有帮助。", false],
	],
	"item/83": [
		[0, "", "[[item/83]] 在 1.8 秒内完成锁定，只有 [[item/84]] 能与之匹敌，同样能显示目标的货物。", false],
	],
	"item/84": [
		[0, "", "[[item/84]] 锁定速度与 [[item/83]] 一样快，也能显示货物，还会标出 A 级小行星，只有这种小行星才可能产出矿核（见 [[guide/mining]]）。它是矿工的首选扫描仪。", false],
	],
	"item/85": [
		[0, "", "[[item/85]] 是游戏中唯一的跃迁引擎。装上它后，你可以从星图直接前往另一个星系的空间站，无需穿过跃迁门。某些任务期间无法使用。它从不以成品出售，也没有代理人出售其蓝图。制造它需要 [[item/164]]、[[item/158]]、[[item/160]] 和 [[item/163]]，外加大量大宗商品。", false],
		[33, "", "它的发明者 [[character/20]] 请 [[character/0]] 为他带来 50 个 [[item/164]]，用于研制一种能够抵达太空中任何地方的引擎。", false],
		[34, "", "作为水晶的回报，[[character/20]] 把蓝图的副本交给了 [[character/0]]。交付的 50 个水晶会计入引擎的材料，因此只需提供其余的材料。", false],
	],
	"item/86": [
		[0, "", "[[item/86]] 是基础采矿激光。要从小行星上钻取矿石，就需要采矿激光。它的产量决定钻头保持航向的稳定程度，每种型号还有各自的钻探速度（见 [[guide/mining]]）。这一款的产量为 30，在深层岩层中很难保持方向。", false],
	],
	"item/87": [
		[0, "", "[[item/87]] 的产量为 50。它明显比 [[item/86]] 稳定，只是钻得稍慢一些。", false],
	],
	"item/88": [
		[0, "", "[[item/88]] 是一种 [[faction/1|Vossk]] 采矿激光，产量为 80，是商店出售的最稳定的钻头。它的缺点是采矿速度最慢。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/89": [
		[0, "", "[[item/89]] 的产量为 60，不如 [[item/88]] 稳定，但采矿速度远快于商店出售的其他任何激光。它适合能够自己控制好钻头方向的矿工。", false],
	],
	"item/9": [
		[0, "", "[[item/9]] 是 M6 光束激光的首款。这类激光射速很低但威力极大：每 1.2 秒造成 27 点伤害，射程 2,400，比任何早期激光都远。精确瞄准非常重要，因为一次失手就要浪费很长的装填时间。它也是制造 [[item/11]] 的基础部件。", false],
	],
	"item/90": [
		[0, "", "[[item/90]] 是最好的采矿激光：产量 100，钻探速度也是所有型号中最快的。它从不以成品出售。其蓝图来自 [[station/78]] 的 [[agent/11]]，制造时需要大量纳米技术产品、机械用品和液压设备，外加 [[item/155]] 和十个 [[item/166]]。", false],
		[2, "", "[[character/0]] 的第一艘采矿船上的激光，就是 [[character/2]] 亲手打造的这款钻头的原型。", false],
		[10, "", "[[character/2]] 把 [[ship/0]] 送给 [[character/0]] 时，留下了这台他唯一拥有的原型，并建议 Keith 以后再来看看，那时他也许已经造出了更多。", false],
	],
	"item/91": [
		[0, "", "[[item/91]] 可容纳 3 名乘客。[[job/11]] 委托需要客舱，多个客舱的空间可以叠加。[[item/92]] 和 [[item/93]] 能容纳更多人。", false],
	],
	"item/92": [
		[0, "", "[[item/92]] 可容纳 5 名乘客，比 [[item/91]] 多两名。", false],
	],
	"item/93": [
		[0, "", "[[item/93]] 可容纳 10 名乘客，是 [[item/92]] 的两倍，可以承接规模更大的载客委托。", false],
	],
	"item/94": [
		[0, "", "[[item/94]] 是基础隐形装置。隐形装置启动期间，其他飞船看不到你。这一款可让飞船隐形 15 秒，之后需要 18 秒充能。隐形状态的时间计入 [[medal/19]] 勋章。", false],
	],
	"item/95": [
		[0, "", "[[item/95]] 是一种 [[faction/1|Vossk]] 隐形装置，可让飞船隐形 28 秒，充能 32 秒，掩护时间几乎是 [[item/94]] 的两倍。只有 [[faction/1|Vossk]] 星系的商店出售。", false],
	],
	"item/96": [
		[0, "", "[[item/96]] 是最好的隐形装置：可让飞船隐形 46 秒，充能只需 40 秒，因此大部分时间都能保持启动。它从不以成品出售。其蓝图来自 [[station/59]] 的 [[agent/10]]。", false],
	],
	"job/0": [
		[0, "", "快递委托要求你把一批密封的货物集装箱运到另一座空间站。接受委托时，集装箱会装入你的货舱，因此你需要足够的空余空间；这些集装箱无法出售。载着货物停靠目的地即告完成。海盗有时会埋伏等待快递员。送达的货物计入 [[medal/5]]。", false],
	],
	"job/1": [
		[0, "", "在防御委托中，一座空间站即将遭到攻击，你受雇协助其自身的战机击退袭击者。袭击者通常是海盗，否则就是敌对种族的飞船。飞到空间站，摧毁每一个袭击者；友方战机的击杀也算在内。难度越高，袭击者越多。", false],
	],
	"job/10": [
		[0, "", "在拦截委托中，一支由两到三艘货船组成、载有非法货物的船队停在远离空间站的地方，由战机护卫。沿着航点飞行，摧毁这些货船。它们的护卫会在沿途和船队周围等待。", false],
	],
	"job/11": [
		[0, "", "载客委托要求你把一群人送到另一座空间站。接受委托时，你需要有足够容纳所有人的客舱；他们在船上期间，客舱无法拆除，船体也无法更换。停靠目的地即可送达乘客。基础报酬较低，但每位乘客都会增加报酬。送达的乘客计入 [[medal/18]]。", false],
	],
	"job/12": [
		[0, "", "挑战是太空酒吧中另一位飞行员发起的射击比赛。你们从同一座空间站出发，飞向分布在一条路线上的一群海盗，谁击落的海盗多，谁就获胜。对手无法被摧毁，其火力与你自己的枪炮相当。只有你的击杀数更多时才能获得报酬；海盗的数量总是奇数，因此不会出现平局。", false],
	],
	"job/2": [
		[0, "", "保护委托会派你去守护在空间站附近小行星区作业的采矿船。袭击者到来后会冲向空间站和矿工。在他们消灭矿工之前将其全部摧毁；如果所有采矿船都被摧毁，委托即告失败。", false],
	],
	"job/3": [
		[0, "", "在回收委托中，空间站附近的一群海盗飞船里，有一艘载着被盗的货物。你必须在不摧毁集装箱的情况下把它夺回来：用 EMP 武器瘫痪那艘运载船，再用牵引光束把集装箱拉进来。能显示货物的扫描仪可以帮你找到正确的飞船。如果运载船被摧毁，或你的货舱没有空间，集装箱就会丢失。拿到集装箱后，返回你接受委托的空间站领取报酬。回收委托的报酬加倍。", false],
	],
	"job/4": [
		[0, "", "猎杀海盗意味着清剿空间站附近的一处海盗巢穴。海盗在小行星区或由两到三个航点组成的路线上等待，只有在看到你时才会行动。沿着航点飞行，摧毁每一个海盗。难度越高，海盗越多。", false],
	],
	"job/5": [
		[0, "", "打捞委托是一次营救行动：空间站附近的一群飞船中，有一艘扣押着人质。与回收委托一样，用 EMP 瘫痪绑匪的飞船，再用牵引光束把人质接上船；摧毁那艘飞船会导致委托结束。随后把人质送回你接受委托的空间站。打捞委托的报酬加倍。", false],
	],
	"job/6": [
		[0, "", "通缉委托会指明一名在某空间站附近出没的危险罪犯。目标在远处的某个地点等待，只有在你进入其视野后才会做出反应。它比普通海盗强得多，并且会随着委托难度和你的飞行员等级而变得更强。摧毁它即可领取赏金。", false],
	],
	"job/7": [
		[0, "", "清理垃圾委托要求你在大约两分钟内清除空间站附近的一片太空垃圾。时间耗尽之前必须摧毁每一块碎片；难度较高时还会有几名海盗加入。它的报酬低于大多数委托，但完成得快，而且摧毁的垃圾会计入 [[medal/10]]。", false],
	],
	"job/8": [
		[0, "", "采购委托来自太空酒吧中的一位买家，他需要一定数量的某种物品。通过商店、商人或采矿获得货物，然后带着货舱中的货物再次停靠买家所在的空间站。货物交付后，你会得到通常委托报酬的一半，外加货物平均价值的三倍，因此买家给的价格通常远高于任何商店。买家从 [[step/16]] 起出现。", false],
	],
	"job/9": [
		[0, "", "护送委托要求你保护空间站附近一支由五艘货船组成的船队。货船继续前进时，埋伏在航线上的袭击者会逼近。摧毁所有袭击者。如果所有货船都被摧毁，委托即告失败。护送委托的报酬比大多数委托高五分之一。", false],
	],
	"medal/0": [
		[0, "", "[[character/0]] 凭借他过去的服役经历，从游戏一开始就拥有这枚勋章。无需做任何事即可获得。", false],
	],
	"medal/1": [
		[0, "", "在船体所剩无几的情况下抵达空间站时授予。检查在你接近空间站、停靠修复飞船之前进行，并且只看船体自身的强度，不计装甲板。剩余比例越低，等级越高。", false],
	],
	"medal/10": [
		[0, "", "摧毁太空垃圾（如 [[job/7]] 委托中出现的那些）时授予。你击中的每一块都算在内。", false],
	],
	"medal/11": [
		[0, "", "根据你停靠过的不同空间站的数量授予。", false],
	],
	"medal/12": [
		[0, "", "根据你访问过的不同星系的数量授予。隐藏星系在你抵达后也会计入。", false],
	],
	"medal/13": [
		[0, "", "根据你拥有的蓝图数量授予。蓝图从太空酒吧中的代理人处购买；见 [[guide/blueprints]]。", false],
	],
	"medal/14": [
		[0, "", "根据你至少完成过一次的不同蓝图的数量授予。重复制造同一件物品不会增加计数。", false],
	],
	"medal/15": [
		[0, "", "根据你的游戏时间（以小时计）授予。游戏计算的是飞行所用的时间。", false],
	],
	"medal/16": [
		[0, "", "根据完成的自由委托数量授予。失败和放弃的委托不计入。", false],
	],
	"medal/17": [
		[0, "", "根据你穿过跃迁门的次数授予。使用跃迁引擎的跃迁不计入。", false],
	],
	"medal/18": [
		[0, "", "根据 [[job/11]] 委托中送达的乘客人数授予。客舱空间越大，一次能运送的人就越多。", false],
	],
	"medal/19": [
		[0, "", "根据隐形状态下累计的分钟数授予。装上隐形装置，并在每次充能完毕时使用。", false],
	],
	"medal/2": [
		[0, "", "开采不同种类的矿石时授予。每种矿石只计一次，无论你开采了多少。由于小行星区中的矿石取决于附近的原产地，你需要在银河的多个地区采矿。", false],
	],
	"medal/20": [
		[0, "", "根据发射的 EMP 炸弹和核弹数量授予。", false],
	],
	"medal/21": [
		[0, "", "根据用牵引光束从残骸和瘫痪飞船上收集的 [[item/131]] 吨数授予。", false],
	],
	"medal/22": [
		[0, "", "单一等级的勋章，授予完全不装任何武器、或完全不装任何装备飞行的飞行员，在下次停靠时检查。剧情前期无法获得：在 [[step/8]] 之前，飞船始终被视为已武装。", false],
	],
	"medal/23": [
		[0, "", "根据同时安装的主武器数量授予，在停靠时检查。较高的等级需要拥有许多主武器槽位的船体。与 [[medal/22]] 一样，只从 [[step/8]] 起计算。", false],
	],
	"medal/24": [
		[0, "", "根据用牵引光束从残骸和瘫痪飞船上获取的货物吨数授予。", false],
	],
	"medal/25": [
		[0, "", "根据你同一时间持有的最高信用点数授予。之后花掉的钱不会使其失效。", false],
	],
	"medal/26": [
		[0, "", "与太空酒吧中有东西可提供的客人交谈时授予。每位客人只在你第一次与其交谈时计一次。", false],
	],
	"medal/27": [
		[0, "", "根据你在太空酒吧雇用的僚机数量授予，每组中的每位飞行员都算在内。", false],
	],
	"medal/28": [
		[0, "", "单一等级的勋章，授予使四大种族之一与你为敌的飞行员，即把两条声望标尺之一向任一方向推过 60。见 [[guide/combat]]。", false],
	],
	"medal/29": [
		[0, "", "根据你用武器摧毁的小行星数量授予。因采矿而碎裂的小行星不计入。", false],
	],
	"medal/3": [
		[0, "", "开采不同种类的矿核时授予。矿核只能通过钻穿 A 级小行星的全部七层获得，因此除了四处奔波，还需要耐心和一台好的采矿激光。", false],
	],
	"medal/30": [
		[0, "", "完成剧情后授予的单一等级勋章。", false],
	],
	"medal/31": [
		[0, "", "根据你同一时间拥有的最大空余货舱空间授予。装有货物压缩装置且货舱空空的大型船体可获得较高等级。", false],
	],
	"medal/32": [
		[0, "", "根据你在太空酒吧中以“No, thanks”拒绝报价的次数授予。", false],
	],
	"medal/33": [
		[0, "", "根据你在太空酒吧中以“How was that again?”请客人重复报价的次数授予。", false],
	],
	"medal/34": [
		[0, "", "在未先询问委托人难度的情况下接受其他空间站的委托时授予。", false],
	],
	"medal/35": [
		[0, "", "在未先请委托人在地图上指出目的地的情况下接受其他空间站的委托时授予。", false],
	],
	"medal/36": [
		[0, "", "拥有其他所有勋章（任意等级）后自动授予。集齐所有勋章还有其他奖励；见 [[guide/medals]]。", false],
	],
	"medal/4": [
		[0, "", "根据你在整个游戏中摧毁的飞船数量授予。海盗、敌人和委托目标都算在内。", false],
	],
	"medal/5": [
		[0, "", "根据 [[job/0]] 委托中送达的货物吨数授予。大批快递货物计数更多，因此大货舱很有帮助。", false],
	],
	"medal/6": [
		[0, "", "根据整个游戏中开采的矿石总吨数授予。", false],
	],
	"medal/7": [
		[0, "", "根据整个游戏中开采的矿核数量授予。每颗被钻穿到底的 A 级小行星会产出一个。", false],
	],
	"medal/8": [
		[0, "", "根据从空间站商店购买的酒类吨数授予。每个星系的本地酒都算在内。", false],
	],
	"medal/9": [
		[0, "", "拥有不同种类的酒时授予。从太空酒吧的商人处购买，或用牵引光束从残骸中收集时，都会计入种类。", false],
	],
	"ship/0": [
		[0, "", "[[ship/0]] 是飞船表中最弱的船体：95 装甲、25 吨货舱、一个主武器槽位和一个副武器槽位，以及三个装备槽位。作为入门飞船，它 140 的操控性还算可以，但最便宜的在售船体 [[ship/32]] 拥有同样的槽位，而装甲、货舱空间和灵活性都更好。没有经销商出售 [[ship/0]]；玩家只能通过剧情获得它。", false],
		[2, "", "这艘修修补补的前 [[faction/8|海盗]]船归 [[character/2]] 所有，他在 [[station/78]] 让 [[character/0]] 驾驶它。飞船涂着海盗配色，装有采矿激光和一台 [[item/81]]，但没有枪炮。那台激光是他自己的原型，也就是他后来作为 [[item/90]] 出售的设计。", false],
		[10, "", "突袭海盗巢穴之后，[[character/2]] 把这艘飞船永久送给了 [[character/0]]，并换装了更强的引擎以便在星系内的行星之间航行，但留下了那台原型激光。到达 [[faction/0|Terran]] 领域后，他仍继续驾驶这艘飞船。", false],
		[18, "", "在 [[station/98]]，[[character/1]] 让人把船体重新涂成 [[faction/0|Terran]] 配色，以免巡逻队再把它当成海盗船。", false],
	],
	"ship/1": [
		[0, "", "[[ship/1]] 是拥有四个副武器槽位的最便宜船体，还配有一个炮塔槽位、两门主炮和七个装备槽位。装甲（192）和货舱（65 吨）都很扎实。106 的操控性较慢，因此它最适合用鱼雷和炮塔作战。多花一点钱，[[ship/9]] 就能提供多得多的装甲和灵活性，但没有炮塔，副武器槽位也只有两个。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/10": [
		[0, "", "[[ship/10]] 是 [[character/0]] 在开场时自己的飞船，装备两门 [[item/3]] 激光。它兼具坚实的装甲（200）和 100 吨的货舱，还有四个副武器槽位和 150 的操控性，比标价最接近的 [[ship/11]] 灵活得多。它的弱点是装备槽位少：只有五个。普通经销商从不出售它。", false],
		[2, "", "一次超空间引擎故障把 [[character/0]] 带到了 [[station/78]]，[[character/2]] 在那里回收了残骸，并把它拆成了零件。这艘飞船再也没有回到他手中。", false],
	],
	"ship/11": [
		[0, "", "[[ship/11]] 是一艘装备齐全的重型货船：180 吨货舱、210 装甲、一个炮塔槽位、两个主武器槽位和两个副武器槽位，以及八个装备槽位。75 的操控性很差。与更便宜的 [[ship/7]] 相比，它放弃了 60 吨货舱空间，换来了一个额外的副武器槽位和一个额外的装备槽位。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/12": [
		[0, "", "[[ship/12]] 是一款以副武器为核心的战斗机：三个副武器槽位、两门主炮、六个装备槽位、175 装甲以及 132 的操控性。它的货舱只有 30 吨，非常小，因此不太适合贸易或采矿。[[ship/30]] 更贵，装甲却更少，副武器槽位也少一个。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/16": [
		[0, "", "[[ship/16]] 是一款侧重导弹的战斗机，拥有四个副武器槽位、两门主炮、十个装备槽位、180 装甲和 120 的操控性。45 吨的货舱偏小。更贵的 [[ship/21]] 多出两门主炮和一个装备槽位。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/17": [
		[0, "", "[[ship/17]] 装有四门主炮、两个副武器槽位和十个装备槽位。对于这个价位的飞船来说，它的装甲（145）、货舱（65 吨）和操控性（95）都偏弱，因此它依赖装备，尤其是护盾和装甲板。更便宜的 [[ship/19]] 装甲和货舱空间更多，装备槽位少一个。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/18": [
		[0, "", "[[ship/18]] 是一艘小巧灵活的飞船（操控性 145），拥有八个装备槽位；没有比它更便宜的船体能有这么多。它 115 的装甲和 28 吨的货舱都很差，而且只有两个主武器槽位和两个副武器槽位。它适合依靠护盾、隐形装置等装备而非装甲的飞行员。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/19": [
		[0, "", "[[ship/19]] 是一艘重型炮艇，拥有四个主武器槽位、两个副武器槽位、九个装备槽位、225 装甲和 105 吨货舱。90 的操控性较慢。它是唯一一艘同时拥有四门前射枪炮和超过 100 吨货舱的飞船。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/2": [
		[0, "", "[[ship/2]] 是廉价船体中一款灵活的全能型飞船：155 装甲、52 吨货舱、一个主武器槽位和两个副武器槽位、四个装备槽位以及 150 的操控性。除了货舱空间外，它与 [[ship/35]] 不相上下，货舱则多出 12 吨。想要第二门枪炮的飞行员会转而考虑 [[ship/5]] 或 [[ship/6]]。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/20": [
		[0, "", "[[ship/20]] 是一款轻型战斗机，在小巧灵活的船体（操控性 155）中塞进了六个装备槽位。它装有两门主炮，但只有一个副武器槽位、125 装甲和 25 吨货舱，货舱与 [[ship/0]] 并列表中最小。它适合想早早装上护盾、加速器等装备、又不打算运货的飞行员。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/21": [
		[0, "", "[[ship/21]] 是拥有四个主武器槽位和四个副武器槽位的最便宜船体。它还有十一个装备槽位、195 装甲和 70 吨货舱。100 的操控性属于中等。它是一艘完整的战斗舰，仅比 [[ship/29]] 低一档。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/22": [
		[0, "", "在所有售价超过一百万信用点的飞船中，[[ship/22]] 的货舱最大（130 吨），此外还有三个主武器槽位和三个副武器槽位、九个装备槽位以及 118 的操控性。就其价格而言，160 的装甲偏低。它适合用同一艘飞船既做贸易又打仗的飞行员。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/23": [
		[0, "", "[[ship/23]] 是拥有炮塔槽位的最便宜船体，205 的装甲在所有 100,000 信用点以下的飞船中最高。它还有两个主武器槽位和两个副武器槽位、五个装备槽位、55 吨货舱以及 128 的操控性，是一艘坚固的中档全能型飞船。它的主要局限是装备槽位较少。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/24": [
		[0, "", "[[ship/24]] 是一艘武装商船：三门主炮、两个副武器槽位、一座炮塔、八个装备槽位和 95 吨货舱。170 的装甲属于中等水平，而对于一艘载重如此之大的飞船来说，125 的操控性相当不错。它在贸易、采矿和战斗方面都同样出色。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/25": [
		[0, "", "[[ship/25]] 是一艘导弹载舰：四个副武器槽位、八个装备槽位和 130 的操控性，但只有一门主炮。就其价格而言，124 的装甲和 52 吨的货舱都偏弱，因此它依赖鱼雷和护盾。[[ship/1]] 以三分之一的价格提供了同样数量的副武器槽位外加一座炮塔，只是装备槽位较少。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/26": [
		[0, "", "[[ship/26]] 是拥有七个装备槽位的最便宜船体。除此之外，它是一艘普通的全能型飞船：152 装甲、64 吨货舱、两个主武器槽位和两个副武器槽位，以及 108 的操控性。它适合想在买得起更重型飞船之前就配齐装备的飞行员。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/27": [
		[0, "", "[[ship/27]] 是拥有三个主武器槽位的最便宜船体。此外它还有 176 装甲、两个副武器槽位、六个装备槽位和 50 吨货舱。113 的操控性偏慢，因此它靠硬碰硬取胜，而不是靠转向甩开敌人。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/28": [
		[0, "", "[[ship/28]] 是在售飞船中最全面的全能型飞船：三个主武器槽位和四个副武器槽位、一座炮塔、十二个装备槽位和 110 吨货舱。没有其他可购买的飞船能同时拥有炮塔和这么多装备槽位。195 的装甲不错，92 的操控性则较慢。[[ship/29]] 更能打，但载货量少得多。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/29": [
		[0, "", "[[ship/29]] 是普通经销商出售的最昂贵飞船，也是他们最好的战斗机：四个主武器槽位和四个副武器槽位、十二个装备槽位、240 装甲以及 118 的操控性。75 吨的货舱一般，而且没有炮塔。在战斗中只有 [[ship/8]] 胜过它。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/3": [
		[0, "", "[[ship/3]] 是一款均衡的早期全能型飞船：两个主武器槽位和两个副武器槽位、五个装备槽位、135 装甲和 55 吨货舱。对于小型飞船来说，112 的操控性偏慢。它与 [[ship/6]] 价格相当，后者转向快得多，但装甲更少、货舱更小，副武器槽位也少一个。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/30": [
		[0, "", "[[ship/30]] 是一款中规中矩的战斗机：165 装甲、45 吨货舱、两个主武器槽位和两个副武器槽位、六个装备槽位以及 128 的操控性。就其价格而言，它没有什么特别的长处；更便宜的 [[ship/12]] 装甲更多，还多一个副武器槽位，而 [[ship/23]] 则多一个炮塔。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/31": [
		[0, "", "[[ship/31]] 是一艘轻型货船，拥有 110 吨货舱、一个炮塔槽位、两门主炮和六个装备槽位。它的装甲（156）、单个副武器槽位和 102 的操控性都很一般。它的竞争对手是更便宜的 [[ship/33]]，后者货舱稍小、少一门枪炮，但装甲更多、操控更好。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/32": [
		[0, "", "[[ship/32]] 是所有经销商出售的最便宜船体，通常是第一次购买的飞船。它体型小、防护薄弱（100 装甲、30 吨货舱、一个主武器槽位和一个副武器槽位、三个装备槽位），但操控性达到 160，只有 [[ship/4]] 转向比它更快。与 [[ship/0]] 相比，它的装甲和货舱空间略多，操控也更好。[[ship/35]] 贵约 8,000 信用点，但装甲好得多，还多一个副武器槽位和第四个装备槽位。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/33": [
		[0, "", "[[ship/33]] 是货舱空间超过 100 吨（108 吨）的最便宜船体，还配有炮塔槽位、176 装甲和六个装备槽位。它只有一门主炮，操控性为 112，与其说是战斗机，不如说是一艘能够自卫的商船。[[ship/31]] 是它的有力竞争者，多一门枪炮，货舱也稍大，但更弱也更慢。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/34": [
		[0, "", "[[ship/34]] 是一艘炮艇，拥有四个主武器槽位、一个副武器槽位、六个装备槽位、60 吨货舱以及 130 的操控性。与更便宜的 [[ship/4]] 相比，它牺牲了装甲（135 对 170）和灵活性，换来了更多的货舱空间和一个额外的装备槽位。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/35": [
		[0, "", "[[ship/35]] 是价目表底部的一款轻型战斗机。就价格而言，它提供了不错的装甲（155）、一个主武器槽位和两个副武器槽位、四个装备槽位以及 150 的灵敏操控性，但货舱只有 40 吨。[[ship/2]] 几乎是同一艘飞船，多花几千信用点就能多出 12 吨货舱空间；而 [[ship/5]] 则以灵活性换取了更多的装甲、货舱和第二门枪炮。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/36": [
		[0, "", "[[ship/36]] 是游戏中最大的货船，拥有 350 吨货舱。它完全没有主武器槽位，只能依靠四个副武器槽位和一座炮塔自卫。七个装备槽位和 200 装甲都不错，但 45 的操控性是表中最低的。[[ship/7]] 运量较小，但保留了两门前射枪炮，转向也更好。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/4": [
		[0, "", "[[ship/4]] 是拥有四个主武器槽位的最便宜船体，操控性高达 162，是游戏中最灵活的飞船。170 的装甲在同价位中表现不错。代价是 38 吨的货舱、只有一个副武器槽位和五个装备槽位，因此它是一艘纯粹的格斗机。[[ship/34]] 同样装有四门枪炮，货舱空间和装备槽位更多，但装甲和灵活性较差。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/5": [
		[0, "", "[[ship/5]] 是拥有两个主武器槽位的最便宜船体，170 的装甲在同价位中很高。60 吨的货舱也让它适合早期的贸易和采矿。缺点是只有一个副武器槽位、四个装备槽位，以及 115 的迟钝操控性。看重灵活性胜过装甲的飞行员会选择价格相近的 [[ship/2]] 或 [[ship/35]]。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/6": [
		[0, "", "[[ship/6]] 是一款轻快的战斗机，拥有两个主武器槽位、一个副武器槽位、五个装备槽位和 148 的操控性。它 105 的装甲非常薄弱，只有 [[ship/0]] 和 [[ship/32]] 比它更少，因此它依靠的是速度而不是坚固。价格几乎相同的 [[ship/3]] 以操控性为代价，提供了更多的装甲、更大的货舱和第二个副武器槽位。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/7": [
		[0, "", "[[ship/7]] 是一艘重型货船，拥有 240 吨货舱、220 装甲、一个炮塔槽位、两门主炮、一个副武器槽位和七个装备槽位。操控性只有 65，转向迟缓。与 [[ship/36]] 相比，它放弃了 110 吨货舱空间，换来了前射枪炮和更好的操控；更贵的 [[ship/11]] 则多一个装备槽位和第二个副武器槽位。", false],
		[0, "", "[[faction/1|Vossk]] 星系以外的任何经销商都可能出售它。", false],
	],
	"ship/8": [
		[0, "", "[[ship/8]] 是一艘修复后的 [[faction/9|Void]] 战机，也是游戏中最强的飞船。它 450 的装甲几乎是其他任何船体的两倍，拥有四个主武器槽位和四个副武器槽位以及十五个装备槽位，155 的操控性也名列前茅。唯一的弱点是 30 吨的货舱。它超过八百万信用点的标价几乎是 [[ship/29]] 的两倍。", false],
		[0, "", "普通经销商不出售它。只有当玩家所有勋章都获得金牌后，[[station/10]] 才会将其作为原型机出售（见 [[guide/medals]]）。", false],
	],
	"ship/9": [
		[0, "", "[[ship/9]] 是 [[faction/1|Vossk]] 经销商出售的唯一飞船，他们也不出售别的飞船。它 250 的装甲在所有船体中仅次于 [[ship/8]]，同时还具备 152 的灵敏操控性、两个主武器槽位和两个副武器槽位、七个装备槽位以及 65 吨货舱。在这个价位上，它是最坚固的战斗机，但缺少 [[ship/1]] 的炮塔和额外槽位。", false],
		[36, "", "[[character/7]] 解释说，[[faction/1|Vossk]] 飞船通常只由本族驾驶；这艘飞船是个例外，它经过改装设计，可以出售给其他种族。", false],
	],
	"station/0": [
		[0, "", "[[station/0]] 设有 [[system/0]] 的跃迁门。[[step/13]] 的等待阶段被归在这座空间站名下，但该步骤只需在任何地方完成酒吧委托即可完成，这里并不会发生什么。", false],
	],
	"station/10": [
		[0, "", "[[station/10]] 是 [[system/6]] 唯一的空间站，并设有该星系的跃迁门。自由委托从不会派你来这里。代理人 [[agent/3]] 在它的酒吧中出售一份蓝图；当所有勋章都达到金牌后，这座空间站还会提供一艘原型 [[ship/8]]。", false],
		[23, "", "这座空间站是由 [[character/6]] 领导的 Deep Science 秘密研究基地。[[character/0]] 在 [[step/23]] 中与 [[character/5]] 一同抵达这里，之后又多次返回：策划前往 Void 的远征、会见 [[character/20]]，以及交付他收集的水晶。", false],
	],
	"station/18": [
		[0, "", "[[station/18]] 是 [[system/3]] 中一座普通的 Vossk 空间站。代理人 [[agent/12]] 在它的酒吧中出售 [[system/0]] 的坐标。", false],
	],
	"station/20": [
		[0, "", "[[station/20]] 设有 [[system/4]] 的跃迁门。Mido 代理人 [[agent/2]] 在它的酒吧中出售一份武器蓝图。", false],
	],
	"station/22": [
		[0, "", "[[station/22]] 是 [[system/4]] 中最先进的空间站。", false],
		[38, "", "在 [[step/38]] 中，有人在这座空间站附近发现了运送 Nivelian 炸药的船队，由 Mido 战机护送。[[character/0]] 必须赶走护卫，同时不能摧毁船队。", false],
	],
	"station/26": [
		[0, "", "[[station/26]] 是 [[system/5]] 中一座顶尖科技的 Vossk 空间站。Bobolian 代理人 [[agent/13]] 在它的酒吧中出售 [[system/1]] 的坐标。", false],
	],
	"station/27": [
		[36, "", "在 [[step/36]] 中，[[character/7]] 和 [[character/0]] 在 [[station/27]] 附近突袭一处海盗巢穴；谁摧毁的海盗多，谁就获胜。", false],
		[37, "", "[[character/0]] 获胜，赢得了为 Vossk 货船护航的资格。他从这里向 [[character/1]] 汇报。", false],
	],
	"station/29": [
		[35, "", "[[station/29]] 是 Vossk 指挥官 [[character/7]] 的空间站，他已同意为攻击 Void 提供一艘 K'Sarr 货船。[[character/0]] 在 [[step/35]] 中于此与他会面。", false],
		[36, "", "[[character/7]] 拒绝让 Vossk 人以外的任何人驾驶货船，并向 [[character/0]] 发起挑战，要他证明自己能够胜任护航飞行员。", false],
	],
	"station/3": [
		[0, "", "[[station/3]] 是隐藏星系 [[system/0]] 中的一座高科技 Nivelian 空间站。代理人 [[agent/0]] 就在它的酒吧中，出售一份武器蓝图。", false],
	],
	"station/30": [
		[34, "", "在 [[step/34]] 中，[[character/1]] 带着对付 Void 母舰的计划在 [[station/30]] 等候。", false],
		[35, "", "计划是让一艘满载 Nivelian 核炸药的重型货船冲进母舰。", false],
		[39, "", "夺回的炸药运抵这里，装上了 Vossk 货船。在 [[step/39]] 中，[[character/1]] 讲解了最后的行动。", false],
	],
	"station/43": [
		[0, "", "[[station/43]] 是 [[system/8]] 中一座小型 Terran 空间站。代理人 [[agent/4]] 在它的酒吧中出售一份便宜的火箭弹蓝图。", false],
	],
	"station/48": [
		[24, "", "有人在 [[station/48]] 附近目击到 Void 飞船。在 [[step/24]] 中，[[character/0]] 带 [[character/6]] 来这里观察它们，并用牵引光束收集残骸。", false],
		[25, "", "打捞结束时，一个虫洞吞没了载着 [[character/6]] 的 [[character/0]] 的飞船。", false],
		[27, "", "他们穿过另一个虫洞返回时，Void 战机尾随而来，[[character/0]] 必须先在这里将它们消灭，再返回 [[station/10]]。", false],
	],
	"station/54": [
		[0, "", "[[station/54]] 是 [[system/10]] 中一座顶尖科技的 Vossk 空间站，该星系只能借助跃迁引擎到达。Vossk 代理人 [[agent/5]] 在它的酒吧中出售一份导弹蓝图。", false],
	],
	"station/55": [
		[0, "", "[[station/55]] 设有 [[system/11]] 的跃迁门。", false],
		[19, "", "在这座空间站附近发现了扣押 [[character/5]] 索要赎金的海盗。Deep Science 在它的机库中为 [[character/0]] 留下了 EMP 炸弹。", false],
		[22, "", "营救成功后，[[character/0]] 在这座空间站与获释的军官会面，并得到了 [[system/6]] 的坐标。", false],
	],
	"station/56": [
		[18, "", "[[station/56]] 是 [[step/18]] 中 [[character/0]] 本应接上一名 Deep Science 军官的会合点。", false],
		[19, "", "这名军官始终没有出现。取而代之的是 [[character/1]] 发来的一条消息，报告说他已被海盗绑架。", false],
	],
	"station/59": [
		[0, "", "[[station/59]] 是 Vossk 星系 [[system/20]] 中的一座小型空间站。它的酒吧里有一位 Terran 代理人 [[agent/10]]，出售一份隐形装置蓝图。", false],
	],
	"station/61": [
		[0, "", "[[station/61]] 是 [[system/12]] 仅有的两座空间站之一。Multipod 代理人 [[agent/6]] 在它的酒吧中出售一份核武器蓝图。", false],
	],
	"station/65": [
		[0, "", "[[station/65]] 设有 [[system/13]] 的跃迁门。Cyborg 代理人 [[agent/14]] 在它的酒吧中出售 [[system/10]] 的坐标。", false],
	],
	"station/72": [
		[0, "", "[[station/72]] 是安全星系 [[system/14]] 中的一座小型 Terran 空间站。代理人 [[agent/7]] 在它的酒吧中出售一份护盾蓝图。", false],
	],
	"station/76": [
		[11, "", "[[station/76]] 是 [[system/15]] 中一座不再回应呼叫的空间站。在 [[step/11]] 中，[[character/3]] 派 [[character/0]] 去查明原因。", false],
		[12, "", "空间站毫发无损。只是站上人员完全无法工作，原因是 [[character/0]] 的老相识、毒贩 [[character/4]] 运来了一批神经藻。", false],
	],
	"station/78": [
		[0, "", "[[station/78]] 是 Nivelian 矿石商人 [[character/2]] 在 [[system/15]] 中的小型采矿站。剧情就从它的轨道上开始。", false],
		[1, "", "[[character/0]] 受损的飞船在自动驾驶下漂流到这里，[[character/2]] 把飞船连同驾驶员一并收留。", false],
		[2, "", "[[character/2]] 拆解了残骸，并让 [[character/0]] 驾驶 [[ship/0]] 在附近的小行星上采矿。", false],
		[8, "", "逃过一次海盗袭击后，[[character/0]] 装上了他的第一件武器，并帮助 [[character/2]] 摧毁了空间站附近的海盗巢穴。", false],
		[10, "", "随后 [[character/2]] 把飞船送给了他，并让他前往 [[station/79]]。", false],
		[0, "", "在游戏后期，[[character/2]] 会在这座空间站的酒吧中出售他的采矿钻头蓝图。", false],
	],
	"station/79": [
		[0, "", "[[station/79]] 是 [[system/15]] 中的一座空间站，也是该星系指挥官 [[character/3]] 的驻地。", false],
		[10, "", "在 [[step/9]] 中，[[character/2]] 派 [[character/0]] 来这里会见 [[character/3]]，此人是一名人类，或许能帮他回到 Terran 领域。", false],
		[11, "", "[[character/3]] 向他介绍了 [[faction/3|Mido 邦联]]，并请他去查看 [[station/76]] 的情况，作为帮忙的交换条件。", false],
		[13, "", "听取了关于 [[station/76]] 的汇报后，[[character/3]] 承诺帮他联系一支即将抵达这座空间站的 Terran 船队。", false],
		[15, "", "船队在 [[step/14]] 中抵达时，把 [[character/0]] 误认作海盗，瘫痪了他的飞船，并把他带上了船。", false],
	],
	"station/8": [
		[0, "", "[[station/8]] 是隐藏星系 [[system/1]] 中的一座 Terran 空间站。Nivelian 代理人 [[agent/1]] 在它的酒吧中出售一份蓝图。", false],
	],
	"station/84": [
		[0, "", "[[station/84]] 是 [[system/16]] 中的一座 Terran 空间站。Vossk 代理人 [[agent/8]] 在它的酒吧中出售一份 Vossk 装甲蓝图。", false],
	],
	"station/88": [
		[0, "", "[[station/88]] 是 [[system/17]] 中的一座小型 Nivelian 空间站。Vossk 代理人 [[agent/15]] 在它的酒吧中出售 [[system/21]] 的坐标。", false],
	],
	"station/90": [
		[0, "", "[[station/90]] 设有 [[system/18]] 的跃迁门。代理人 [[agent/9]] 在它的酒吧中出售一份货物压缩器蓝图。", false],
	],
	"station/91": [
		[28, "", "在 [[step/28]] 中，有报告称 [[station/91]] 附近出现了 Void 活动。[[character/0]] 在这里杀出一条血路冲进虫洞，把探测器带往 Void 母舰。", false],
		[31, "", "从 Void 星区返回后，[[character/0]] 在这里接到 [[character/1]] 的电话，邀请他前往 [[station/98]]。", false],
	],
	"station/98": [
		[15, "", "[[station/98]] 是 [[system/19]] 中的一座 Terran 空间站。逮捕 [[character/0]] 的巡洋舰把他带到这里，他发现负责此地的正是老朋友 [[character/1]]。", false],
		[16, "", "两人交谈期间，Void 战机袭击了空间站，[[character/0]] 帮忙击退了它们。", false],
		[18, "", "[[character/1]] 向他介绍了 Void 的情况，并招募他为 Deep Science 效力。", false],
		[32, "", "在 [[step/31]] 中，[[character/1]] 为 [[character/0]] 的飞船装上了预警系统，并向他提起了 [[character/20]]。", false],
		[44, "", "胜利之后，[[character/0]] 和 [[character/1]] 在这座空间站庆祝，[[character/6]] 也加入了他们。", false],
		[45, "", "第二天早上，[[character/6]] 已经离开，只留下一张字条和 Deep Science 的最后一笔报酬。", false],
	],
	"step/0": [
		[0, "", "[[character/0]] 在一片小行星带中追击一伙 [[faction/8|海盗]]，要领取悬赏他们人头的赏金。你必须找到并摧毁每一艘海盗飞船。", false],
		[1, "", "解决海盗之后，Keith 设定航向前往 Eden Prime，Smith 上将要在那里与他商谈一项特殊任务。超空间引擎启动之际，临别的一发炮弹击伤了他的飞船。引擎失灵，生命维持系统严重受损，自动驾驶载着昏迷的驾驶员飞向最近的空间站 [[station/78]]。", false],
	],
	"step/1": [
		[1, "", "自动驾驶已将 Keith 受损的飞船带入 [[station/78]] 周围的轨道，驾驶员仍昏迷在船上。", false],
		[2, "", "Keith 在一座小型采矿站中醒来，空间站的主人是 [[faction/2]] 矿石商人 [[character/2]]。Gunant 已把飞船拆开，并以打捞权为由将其据为己有。听说 Keith 想去远在银河另一端的 Eden Prime，他哈哈大笑；而 Keith 竟从未听说过 Void，更让他吃惊。这种怀有敌意的生物如今连 [[system/15]] 星系都会出现。", false],
		[2, "", "Keith 身无分文，也没有飞船，只好替 Gunant 打工，驾驶一艘没有武装的飞船去采矿。", false],
	],
	"step/10": [
		[10, "", "Keith 飞往 [[station/79]] 去见 [[character/3]]。", false],
		[11, "", "Norris 解释说，[[system/15]] 位于一个最近才被发现的星区。Nivelian 内战期间，流亡的 Terran 人和 Nivelian 人在此定居，建立了一个独立的邦联。Terran 人接受了它，但 Nivelian 人仍然声称拥有该星系，因此星系边缘战事不断。", false],
		[11, "", "Norris 提出可以帮 Keith 联系 Terran 太空舰队，条件是帮他一个忙：与 [[station/76]] 空间站的联络已经中断，需要一名经验丰富的飞行员查明原因。", false],
	],
	"step/11": [
		[11, "", "Keith 飞往 [[station/76]]，调查其沉默的原因。空间站看起来完好无损，没有交战的迹象，于是他停靠了上去。", false],
		[12, "", "在站内，Keith 撞见了 [[character/4]]，一个他多年前就认识的臭名昭著的毒贩。Mkkt 运来了一批神经藻，全体船员都已醉得无法操作通信设备。Keith 尽快离开了那里。", false],
	],
	"step/12": [
		[12, "", "Keith 返回 [[station/79]] 汇报。", false],
		[13, "", "Norris 大为震惊，承诺会处置那个毒贩。一支 Terran 军事船队正前往 Kernstal，Keith 可以借此机会联系舰队。在船队抵达之前，Norris 建议 Keith 去太空酒吧接些有偿工作（见 [[guide/lounge]]）。", false],
	],
	"step/13": [
		[13, "", "在等待船队期间，Keith 必须完成太空酒吧中的两项自由委托（见 [[guide/jobs]]）。", false],
		[14, "", "Norris 报告说，Terran 船队已进入星系，正驶向 [[station/79]]。Keith 出发前去迎接。", false],
	],
	"step/14": [
		[14, "", "Keith 在 [[station/79]] 附近发现了 Terran 船队和几名海盗。他上前驱赶海盗。", false],
		[15, "", "由于驾驶的是一艘旧海盗船，Keith 被当成了袭击者之一。船队用 EMP 武器瘫痪了他的飞船，并将他逮捕。他被押上一艘 Terran 巡洋舰，送往 Terran 领域内的 [[station/98]]。", false],
	],
	"step/15": [
		[15, "", "Keith 作为船队的囚犯抵达 [[station/98]]。", false],
		[16, "", "负责此事的军官是 Keith 的老朋友 [[character/1]]，他如今是星际安全局的局长。他为这次误会道了歉。两人的重逢被打断：Void 战机出现在轨道上，空间站拉响了警报。", false],
	],
	"step/16": [
		[16, "", "Brent 请 Keith 帮忙击退正在攻击 [[station/98]] 的 [[faction/9|Void]] 飞船（见 [[world/voids]]）。", false],
		[17, "", "Void 广播了一条消息，声称他们心怀和平，却照样发动攻击。Keith 击退了他们，Brent 答应边喝葡萄酒边把他所知道的一切都告诉 Keith。", false],
	],
	"step/17": [
		[17, "", "Keith 停靠 [[station/98]]，听 Brent 讲述他所知道的 Void 情况。", false],
		[18, "", "Void 是在过去几周里出现的。他们经由某种虫洞到来，攻击遇到的一切，似乎是在搜寻矿石；就连 [[faction/1]] 的星系也遭到袭击。Brent 主持着一个危机小组，小组的科学家正聚集在 Deep Science 运营的一座秘密研究站。他请 Keith 为他们飞行。", false],
		[18, "", "标准星图上没有这座空间站所在的星系，因此 Keith 必须前往 [[system/11]] 星系的 [[station/56]]，与 Thomas Boyle 中尉（[[character/5]]）会面，以获取坐标。Brent 还坦白，Keith 的飞船并不是新的，只是重新涂装了一遍，以免再被误认。", false],
	],
	"step/18": [
		[18, "", "Keith 飞往 [[station/56]] 与 Boyle 会面。", false],
		[19, "", "Boyle 始终没有出现。Brent 报告说，海盗在 [[station/55]] 附近绑架了他，索要五百万信用点的赎金。Brent 准备付钱，但 Keith 料定绑匪拿到钱后会杀掉 Boyle，于是转而前往 Kappa。", false],
	],
	"step/19": [
		[19, "", "Keith 飞往 [[station/55]] 寻找绑匪。", false],
		[20, "", "Kappa 的扫描仪找到了绑匪的飞船。Brent 已让人在空间站机库中留下了 EMP 炸弹，这样 Keith 就可以趁绑匪以为他是来送赎金时瘫痪那艘飞船。", false],
	],
	"step/2": [
		[2, "", "Gunant 交给 Keith 一艘修修补补的旧飞船 [[ship/0]]。它原是一艘海盗船，装有采矿激光，但没有任何武器。Keith 必须从 [[station/78]] 附近的小行星上开采至少十吨矿石（见 [[guide/mining]]）。", false],
		[3, "", "矿石装船后，Gunant 让他停靠空间站，以便检查货物。没有武器的 Keith 别无选择，只能照办。", false],
	],
	"step/20": [
		[20, "", "Keith 必须停靠 [[station/55]]，并为飞船装上 EMP 炸弹。", false],
		[21, "", "炸弹装好后，Keith 立即出发。", false],
	],
	"step/21": [
		[21, "", "一个航点标出了绑匪的飞船，它可能并非孤身一船。Keith 必须用 EMP 炸弹将其瘫痪而不是摧毁，并对付可能出现的护卫。", false],
		[22, "", "绑匪以为赎金到了，直到炸弹让他们的系统全部失灵。Brent 派出一支小队去营救 Boyle。", false],
	],
	"step/22": [
		[22, "", "Keith 停靠 [[station/55]]，与获救的科学家会面。", false],
		[23, "", "Boyle 向他道谢。他自己的飞船已经损失，于是 Keith 提出捎他一程。Boyle 把研究站所在的 [[system/6]] 星系的坐标传到了 Keith 的导航计算机里。", false],
	],
	"step/23": [
		[23, "", "Keith 把 Boyle 送到 [[system/6]] 星系的 [[station/10]]，Paolini 博士正在那里等候他们。", false],
		[24, "", "Keith 见到了 Deep Science 项目的负责人 Carla Paolini 博士（[[character/6]]）。她想研究 Void 的技术，首先从 Void 飞船的残骸入手。Deep Science 支付 Keith 20,000 信用点用于装备飞船，而牵引光束必不可少。", false],
		[24, "", "Carla 坚持要和他一起飞往 [[system/9]] 星系的 [[station/48]]，最近有人在那里目击到 Void。Keith 表示反对，但最终还是让步了。", false],
	],
	"step/24": [
		[24, "", "在 [[station/48]]，Carla 想尽可能近距离地观察 Void。Void 宣称他们来自未来，是银河各文明仅存的遗民。Keith 必须与他们交战，并用牵引光束收集其飞船的残骸。", false],
		[25, "", "收集到足够的残骸后，Carla 要求返航，但飞船突然被什么东西抓住了。", false],
	],
	"step/25": [
		[25, "", "Keith 和 Carla 醒来时，已远离 [[station/48]]，身处一片两人都不认识的空间。", false],
		[26, "", "附近停着一艘巨大的 Void 母舰，正不断放出战机。Keith 断定他们穿过虫洞进入了 Void 的母星区。那个虫洞已经消失，但这类通道似乎会坍塌后在别处重新出现，因此他必须找到另一个虫洞才能回家。", false],
	],
	"step/26": [
		[26, "", "虫洞把他们带回了 [[station/48]]，但 Void 战机也跟了过来。Keith 必须摧毁它们，以免它们尾随飞船找到 [[station/10]]。", false],
		[27, "", "甩掉追兵后，两人返回 Thynome，他们实在太需要休息了。", false],
	],
	"step/27": [
		[27, "", "Keith 停靠 [[station/10]]。", false],
		[28, "", "两天后，Carla 请他再去一趟。她的团队造出了一枚探测器，向母舰发射后可以对其进行分析，并把结果传回 Keith 的飞船。她留下来研究残骸，派他前往刚有 Void 出没报告的 [[system/18]] 星系，去寻找另一个虫洞。", false],
		[28, "", "Keith 答应了，但有一个条件：如果他活着回来，Carla 要和他约会一次。她同意了。", false],
	],
	"step/28": [
		[28, "", "Void 战机在 [[station/91]] 附近出现，Keith 必须在虫洞坍塌前抵达那里。Void 警告说，消灭他们就会毁掉他自己的未来。", false],
		[29, "", "Keith 抵达虫洞，穿过它进入了虚空领域。", false],
	],
	"step/29": [
		[29, "", "在母舰附近，Keith 必须锁定它，以此发射探测器，然后坚守阵地，直到探测器完成分析。", false],
		[30, "", "等待期间，Void 再次发出广播，说必须在人类消灭他们、连同人类自己的未来一起毁掉之前找到对话的方法。Keith 一直坚持到数据传输完成，然后撤离。", false],
	],
	"step/3": [
		[3, "", "Keith 停靠 [[station/78]]，交付第一批矿石。", false],
		[4, "", "Gunant 还算满意，但又派 Keith 出去，这次要把整个货舱装满。他开玩笑说，只要 Keith 表现好，说不定哪天这艘飞船就归他了。", false],
	],
	"step/30": [
		[30, "", "穿过虫洞返回后，Keith 在 [[station/91]] 附近等候。", false],
		[31, "", "Brent 来电，请他在返回 Thynome 之前先到 [[system/19]] 星系的 [[station/98]] 一趟，并许诺给他一个惊喜。探测器数据可以从那里发送给 Carla。", false],
	],
	"step/31": [
		[31, "", "Keith 停靠 [[station/98]] 去见 Brent。", false],
		[32, "", "Brent 的团队为星图开发了一套预警系统。它能显示 Void 即将在何处开启虫洞，Keith 的导航计算机也经过改装，可以接收这些信息。Brent 希望他飞往这些地点支援当地部队，并付给他 30,000 信用点。", false],
		[32, "", "Brent 还说，一位为 Deep Science 工作、名叫 [[character/20]] 的 [[faction/7|Grey]] 想见 Keith。", false],
	],
	"step/32": [
		[32, "", "Keith 返回 [[station/10]] 去见 [[character/20]]。", false],
		[33, "", "Khador 研究了 Void 的残骸。他认为 Void 虫洞的秘密在于某种只有 Void 星区才有的水晶的结构。他正在研制一种能把飞船瞬间送到太空中任意地点的引擎，请 Keith 为他带回至少 50 块这种水晶。", false],
		[33, "", "Keith 必须再次进入虫洞，这一次要借助 Brent 的预警系统来寻找。", false],
	],
	"step/33": [
		[33, "", "Keith 必须在 Void 星区收集 50 个 [[item/164]]，并送到 [[station/10]]。", false],
		[34, "", "Khador 非常高兴，送给 Keith 一份 [[item/85]] 的蓝图副本，让 Keith 可以自己造一台（见 [[guide/blueprints]]）。这种引擎甚至可以抵达 Void 的母星区。", false],
		[34, "", "Carla 来了，却忙得没空赴约。她告诉 Keith，她和 Brent 已经想出了一个计划，并让他去 [[system/2]] 星系的 [[station/30]] 找 Brent。", false],
	],
	"step/34": [
		[34, "", "Keith 飞往 [[station/30]]，听取 Brent 的计划。", false],
		[35, "", "探测器数据表明，母舰就是虫洞的来源。迄今为止没有任何武器能伤到它，因此计划是让一艘坚固的货船满载 Nivelian 核炸药，直接冲进它的心脏。", false],
		[35, "", "Vossk 的 K'Sarr 货船最适合这项任务。作为一次秘密换俘交易的一部分，Brent 已安排从 [[system/5]] 星系 [[station/29]] 的指挥官 [[character/7]] 那里弄到一艘。Errkt 坚持要亲自见一见驾驶员。", false],
	],
	"step/35": [
		[35, "", "Keith 飞入 [[faction/1]] 领地，前往 [[station/29]] 会见 [[character/7]]。", false],
		[36, "", "Errkt 查阅过 Keith 的履历，他认为只有 Vossk 人才能真正驾驭 Vossk 飞船。由于任务不容有失，他要亲自驾驶货船。不过，Keith 首先必须在行星 [[station/27]] 附近证明自己作为战斗机飞行员的本领。", false],
	],
	"step/36": [
		[36, "", "Errkt 提议在 [[station/27]] 附近的一处海盗巢穴比试一番：谁击落的海盗多，谁就获胜。", false],
		[37, "", "Keith 赢了。Errkt 承认他是一名称职的飞行员，并授予他为货船护航的荣誉；Errkt 将把货船开到约定的会合点。Keith 致电 Brent 汇报情况。", false],
	],
	"step/37": [
		[37, "", "Keith 从 [[station/27]] 联系 Brent，汇报与 Errkt 会谈的结果。", false],
		[38, "", "Vossk 帝国已确认会提供支持，Brent 也接受由 Errkt 担任驾驶员。但新的问题出现了：与 Nivelian 人交战的 [[faction/3|Mido 邦联]]飞船劫走了运送 Nivelian 炸药的船队。有人在 [[system/4]] 星系的 [[station/22]] 附近发现了它，Keith 同意前去拦截。", false],
	],
	"step/38": [
		[38, "", "Keith 在 [[station/22]] 附近找到了被劫的船队，由 Mido 战机护送。他必须摧毁护卫，同时不能损伤船队的飞船。", false],
		[39, "", "船队重新得到控制后，Brent 把它交给当地安全部队护送到 [[station/30]]，并请 Keith 也返回那里。", false],
	],
	"step/39": [
		[39, "", "Keith 停靠 [[station/30]]，听取最后的任务简报。", false],
		[40, "", "炸药已装上 Vossk 货船，仍由 Errkt 驾驶。Void 下一次出现时，Keith 和 Errkt 就飞往那里。Errkt 将驶向第一个虫洞，Keith 负责掩护并随后跟进。Brent 会请求最近的空间站派出援军。", false],
		[40, "", "Errkt 将在撞击前不久乘逃生舱弹射。Keith 必须在母舰被摧毁之前穿过虫洞返回，否则就再也回不了家。", false],
	],
	"step/4": [
		[4, "", "Keith 回到小行星区采矿，直到货舱装满。", false],
		[5, "", "采矿时，一艘海盗飞船逼近。Keith 手无寸铁，只能逃回空间站，同时躲避对方的火力。", false],
	],
	"step/40": [
		[40, "", "借助预警系统，Keith 飞到一处正遭受 Void 攻击的轨道。Errkt 驾驶货船赶到，驶向第一个虫洞，[[character/8]] 中尉也率领他的小队加入。Keith 必须保护货船，直到它穿过虫洞。", false],
		[41, "", "货船的装甲严重受损，但 Errkt 还是抵达了虫洞，Keith 紧随其后穿了过去。", false],
	],
	"step/41": [
		[41, "", "Baffour 的小队没能及时穿过虫洞，只剩下 Keith 和 Errkt 孤军奋战。货船正沿着撞击航线冲向母舰，Keith 必须清除挡在前方的 Void 战机。", false],
		[42, "", "货船逼近时，Errkt 报告说他的逃生舱被击中了。他选择留在货船上，并命令 Keith 趁还来得及赶紧离开。Keith 与他道别，掉头返航。", false],
	],
	"step/42": [
		[42, "", "Errkt 的货船冲向目标时，Keith 必须迅速脱离。", false],
		[43, "", "Brent 报告说，整个星区的虫洞都已坍塌：计划成功了。Keith 告诉他 Errkt 没能生还，Brent 承诺会在给 Vossk 帝国的报告中表彰他。两人约好在 [[station/98]] 喝一杯。", false],
	],
	"step/43": [
		[43, "", "Keith 来到 [[station/98]] 与 Brent 一同庆祝。", false],
		[44, "", "几杯酒下肚后，Carla 身着晚礼服到来，要兑现她欠 Keith 的那次约会。Brent 识趣地让两人独处。", false],
	],
	"step/44": [
		[44, "", "与 Carla 共度一夜后，Keith 在 [[station/98]] 醒来，宿醉未消。", false],
		[45, "", "Carla 已经走了。她在留言中解释说，她已转去另一个地点不明的秘密项目，Deep Science 将支付 Keith 最后一笔 40,000 信用点。Keith 怀疑自己从头到尾都被利用了，于是又回到了酒吧。", false],
	],
	"step/45": [
		[45, "", "剧情已完结。Void 母舰被摧毁，虫洞已经关闭，[[character/0]] 可以随心所欲地去任何地方。你可以继续在银河各处飞行、贸易、采矿和承接委托；整个剧情的概要见 [[world/history]]。", false],
	],
	"step/5": [
		[5, "", "Keith 必须甩开海盗，安全停靠 [[station/78]]。", false],
		[6, "", "Gunant 承认，海盗对他空间站的袭击越来越严重。Keith 表示，只要有武器，他就能对付这些海盗。Gunant 决定对空间站附近的海盗巢穴发起一次突袭，并开放了他的小机库，让 Keith 安装武器和装甲。", false],
	],
	"step/6": [
		[6, "", "Keith 必须在空间站机库中为 [[ship/0]] 安装一件武器和一块装甲板（见 [[guide/fitting]]）。", false],
		[7, "", "Gunant 认可了这一选择。出于谨慎，他已对 Keith 的武器做了设置，使其无法击穿他自己的护盾。两人约定在外面会合。", false],
	],
	"step/7": [
		[7, "", "Gunant 将前往巢穴的航线以航点形式传给 Keith。Keith 必须沿航线飞行，并在 Gunant 的伴飞下摧毁那里的海盗飞船（见 [[guide/combat]]）。", false],
		[8, "", "巢穴里的海盗远比预想的多。Gunant 想要撤退，但 Keith 坚持战斗并取得了胜利。被问到在哪里学的这身本领时，Keith 说他曾在 Smith 上将麾下的太空舰队服役。Gunant 觉得奇怪，因为 Keith 看上去实在太年轻了。", false],
	],
	"step/8": [
		[8, "", "赢得战斗后，Keith 和 Gunant 返回 [[station/78]]。", false],
		[9, "", "Gunant 感谢 Keith 救了他的命，并提到 Smith 上将的墓就在 [[station/5]]。Keith 大吃一惊：这位海军上将大约在 3612 年就已寿终正寝。Gunant 接着告诉他，现在是 3624 年，他认为这一年将因 Void 而被人铭记。", false],
	],
	"step/9": [
		[9, "", "这个消息让 Keith 震惊不已。他再次停靠 [[station/78]]，与 Gunant 了结此事。", false],
		[10, "", "Keith 意识到，自从他在小行星带中弹以来，大约已经过去了 35 年。Gunant 怀疑是超空间引擎出了故障，因为多年来这种引擎一直与类似事件有关。", false],
		[10, "", "为感谢他战胜海盗，Gunant 把 [[ship/0]] 送给了 Keith，并为它换上了更强的引擎，可以在星系内的行星之间航行。采矿激光他自己留下了，那是他亲手打造的原型。Keith 终于报上了自己的名字，随后出发去见 [[station/79]] 的人类指挥官 [[character/3]] 上尉，此人能帮他前往 [[faction/0]] 领域。从现在起，可以通过 [[chart]] 在星系内航行。", false],
	],
	"system/0": [
		[0, "", "[[system/0]] 是位于星图左边缘的 Nivelian 星系。在你从 [[station/18]] 的 [[agent/12]] 那里购买其坐标之前，它在星图上是隐藏的。其位于 [[station/0]] 的跃迁门连接着 [[system/2]] 和 [[system/8]]。", false],
		[0, "", "Suteo 的空间站是 Nivelian 领域中最先进的一批，[[station/2]] 和 [[station/4]] 拥有最高科技等级。代理人 [[agent/0]] 在 [[station/3]] 出售一份蓝图。", false],
	],
	"system/1": [
		[0, "", "[[system/1]] 是位于星图左下角的 Terran 星系。在你从 [[station/26]] 的 [[agent/13]] 那里购买其坐标之前，它是隐藏的。其位于 [[station/5]] 的跃迁门连接着 [[system/8]] 和 [[system/18]]。", false],
		[0, "", "这里的空间站发达，[[station/7]] 拥有最高科技等级。代理人 [[agent/1]] 在 [[station/8]] 出售一份蓝图。", false],
		[9, "", "据 [[character/2]] 说，[[character/0]] 的老上司 Smith 上将就安葬在 [[station/5]]。", false],
	],
	"system/10": [
		[0, "", "[[system/10]] 是位于星图右侧的 Vossk 星系，安全等级为“危险”。在你从 [[agent/14]] 那里购买其坐标之前，它是隐藏的，而且完全没有跃迁门连接：只有装备了跃迁引擎的飞船才能到达。星系内的五座空间站全都处于最高的科技等级。", false],
		[0, "", "代理人 [[agent/5]] 在 [[station/54]] 出售一份蓝图。", false],
	],
	"system/11": [
		[0, "", "[[system/11]] 是位于星图中上方的 Terran 星系，安全等级为“一般”。这里只有三座空间站。其位于 [[station/55]] 的跃迁门连接着 [[system/7]]、[[system/9]]、[[system/14]] 和 [[system/16]]。", false],
		[18, "", "[[character/0]] 被派往 [[station/56]]，与一名 Deep Science 军官会面。", false],
		[19, "", "这名军官 [[character/5]] 已在 [[station/55]] 附近被海盗绑架。", false],
		[22, "", "[[character/0]] 在 [[step/21]] 中用 EMP 炸弹救出了他。", false],
	],
	"system/12": [
		[0, "", "[[system/12]] 是一个只有两座空间站的小型 Vossk 星系，位于星图右侧，安全等级为“一般”。其位于 [[station/60]] 的跃迁门连接着 [[system/3]]、[[system/5]]、[[system/13]] 和 [[system/14]]，将 Vossk 领域与东部的 Terran 领域连在一起。", false],
		[0, "", "Multipod 代理人 [[agent/6]] 在 [[station/61]] 出售一份蓝图。", false],
	],
	"system/13": [
		[0, "", "[[system/13]] 是位于星图右边缘的 Terran 星系，安全等级为“有风险”。其位于 [[station/65]] 的跃迁门连接着 [[system/12]] 和 [[system/16]]。", false],
		[0, "", "Cyborg 代理人 [[agent/14]] 在 [[station/65]] 出售坐标。", false],
	],
	"system/14": [
		[0, "", "[[system/14]] 是靠近星图中心的 Terran 星系，也是银河中仅有的两个“安全”星系之一。其位于 [[station/70]] 的跃迁门连接着 [[system/3]]、[[system/11]]、[[system/12]] 和 [[system/19]]。这里的空间站大多科技水平较低。", false],
		[0, "", "代理人 [[agent/7]] 在 [[station/72]] 出售一份蓝图。", false],
	],
	"system/15": [
		[0, "", "[[system/15]] 是位于星图顶部的 Mido 星系，安全等级为“危险”。它没有跃迁门连接，因此飞船只有借助跃迁引擎才能进出。星系内的五座空间站都规模小、科技水平低。在 [[step/16]] 之前，这里的飞船经销商一直不营业，往来的飞船也很少。", false],
		[0, "", "剧情就从这里的 [[station/78]] 开始。", false],
		[11, "", "该星系是 [[faction/3|Mido 邦联]]的领土，邦联由 Nivelian 内战期间流亡的 Terran 人和 Nivelian 人建立。Nivelian 人仍声称拥有该星系，因此其边缘地带战事不断。", false],
		[15, "", "[[step/14]] 之后，[[character/0]] 作为囚犯搭乘一艘 Terran 巡洋舰离开了这个星系。日后若要返回，需要跃迁引擎。", false],
		[0, "", "[[character/2]] 在 [[station/78]] 的酒吧中出售一份蓝图。", false],
	],
	"system/16": [
		[0, "", "[[system/16]] 是位于星图右侧的 Terran 星系，安全等级为“有风险”。其位于 [[station/80]] 的跃迁门连接着 [[system/11]] 和 [[system/13]]。", false],
		[0, "", "Vossk 代理人 [[agent/8]] 在 [[station/84]] 出售一份蓝图。", false],
	],
	"system/17": [
		[0, "", "[[system/17]] 是位于星图左上方的 Nivelian 星系，安全等级为“有风险”，也是离 [[system/15]] 最近的星系。其位于 [[station/85]] 的跃迁门连接着 [[system/2]]、[[system/9]] 和 [[system/4]]；这是通往 [[system/4]] 的唯一跃迁门航线。", false],
		[0, "", "Vossk 代理人 [[agent/15]] 在 [[station/88]] 出售坐标。", false],
	],
	"system/18": [
		[0, "", "[[system/18]] 是位于星图底部的 Terran 星系，安全等级为“有风险”。其位于 [[station/90]] 的跃迁门连接着 [[system/1]] 和 [[system/8]]。", false],
		[0, "", "代理人 [[agent/9]] 在 [[station/90]] 出售一份蓝图。", false],
		[28, "", "在 [[step/28]] 中，有报告称 [[station/91]] 附近出现了 Void 活动，[[character/0]] 随即来到这里，准备潜入虫洞。", false],
	],
	"system/19": [
		[0, "", "[[system/19]] 是位于星图中心的 Terran 星系，安全等级为“安全”。其位于 [[station/95]] 的跃迁门连接着 [[system/3]]、[[system/8]]、[[system/9]] 和 [[system/14]]。", false],
		[15, "", "[[character/0]] 被捕后，Terran 巡洋舰就把他带到了 [[station/98]]，他在那里与老朋友 [[character/1]] 重逢。", false],
		[16, "", "即便是这个安全的星系也未能幸免：在 [[step/16]] 中，一支 Void 中队袭击了 [[station/98]]。[[character/1]] 的总部就设在那里。", false],
	],
	"system/2": [
		[0, "", "[[system/2]] 是位于星图左侧的 Nivelian 星系，也是 Nivelian 领域的交通枢纽。其位于 [[station/30]] 的跃迁门连接着 [[system/0]]、[[system/8]]、[[system/9]] 和 [[system/17]]。星系内有四座中等科技等级的空间站。", false],
		[34, "", "在 [[step/33]] 中，[[character/6]] 让 [[character/0]] 前往 [[station/30]]，[[character/1]] 正带着一个新计划在那里等候。对抗 Void 的最后准备也在那里进行。", false],
	],
	"system/20": [
		[0, "", "[[system/20]] 是位于星图右下方的 Vossk 星系，安全等级为“危险”。其位于 [[station/62]] 的跃迁门连接着 [[system/5]] 和 [[system/21]]，是通往 [[system/21]] 的唯一跃迁门航线。", false],
		[0, "", "Terran 代理人 [[agent/10]] 在小型空间站 [[station/59]] 出售一份蓝图。", false],
	],
	"system/21": [
		[0, "", "[[system/21]] 是位于星图右下远角的 Vossk 星系，安全等级为“危险”。在你从 [[agent/15]] 那里购买其坐标之前，它是隐藏的。其位于 [[station/12]] 的跃迁门只连接 [[system/20]]。星系内的空间站都很简陋，科技等级不超过 3。", false],
	],
	"system/3": [
		[0, "", "[[system/3]] 是最靠近星图中心的 Vossk 星系，也是进入 Vossk 领域的主要门户。其位于 [[station/15]] 的跃迁门连接着 [[system/5]]、[[system/12]]、[[system/8]]、[[system/14]] 和 [[system/19]]。安全等级为“一般”。", false],
		[0, "", "[[station/18]] 的代理人 [[agent/12]] 出售隐藏星系 [[system/0]] 的坐标。", false],
	],
	"system/4": [
		[0, "", "[[system/4]] 是位于星图左上角的 Mido 星系，安全等级为“危险”。这是一条死胡同：其位于 [[station/20]] 的跃迁门只能到达 [[system/17]]。星系内的空间站从简陋的 [[station/21]] 到装备精良的 [[station/22]] 不等。", false],
		[0, "", "代理人 [[agent/2]] 在 [[station/20]] 的酒吧中出售一份蓝图。", false],
		[38, "", "在 [[step/38]] 中，一支运送 Nivelian 炸药的被劫船队被追踪到这个星系的 [[station/22]] 附近。", false],
	],
	"system/5": [
		[0, "", "[[system/5]] 是位于星图右下方的 Vossk 星系，安全等级为“有风险”。其位于 [[station/25]] 的跃迁门连接着 [[system/3]]、[[system/12]] 和 [[system/20]]。代理人 [[agent/13]] 在 [[station/26]] 出售坐标。", false],
		[35, "", "该星系是 Vossk 指挥官 [[character/7]] 的大本营，他驻守在 [[station/29]]，[[character/0]] 在 [[step/35]] 中于此与他会面。", false],
		[36, "", "他们的比试在 [[station/27]] 附近进行。", false],
	],
	"system/6": [
		[0, "", "[[system/6]] 是位于星图右上方的 Terran 星系，安全等级为“危险”。它不在标准星图上，只有剧情才会揭示其坐标。星系内只有一座空间站 [[station/10]]，其跃迁门只连接 [[system/7]]。", false],
		[23, "", "这个星系隐藏着 Deep Science 的秘密研究站。[[character/5]] 在 [[step/22]] 中把它的坐标交给 [[character/0]]，对抗 Void 的许多行动都是在这里策划的。", false],
	],
	"system/7": [
		[0, "", "[[system/7]] 是位于星图右上方的 Terran 星系，安全等级为“有风险”。其位于 [[station/35]] 的跃迁门连接着 [[system/11]] 和隐藏的 [[system/6]]，是通往这个隐藏星系的唯一跃迁门航线。[[station/37]] 是这里最先进的空间站。", false],
	],
	"system/8": [
		[0, "", "[[system/8]] 是位于星图左下四分之一区域的 Terran 星系，也是银河中连接最多的星系。其位于 [[station/40]] 的跃迁门连接着六个星系：[[system/0]]、[[system/1]]、[[system/2]]、[[system/3]]、[[system/18]] 和 [[system/19]]。安全等级为“一般”。", false],
		[0, "", "代理人 [[agent/4]] 在 [[station/43]] 出售一份蓝图。", false],
	],
	"system/9": [
		[0, "", "[[system/9]] 是位于星图中上方的 Nivelian 星系，安全等级为“一般”。其位于 [[station/45]] 的跃迁门连接着 [[system/2]]、[[system/11]]、[[system/17]] 和 [[system/19]]。", false],
		[24, "", "有报告称 [[station/48]] 附近出现了 Void 活动，[[character/0]] 和 [[character/6]] 在 [[step/24]] 中前往那里收集残骸。", false],
	],
	"world/galaxy": [
		[0, "概述", "游戏发生在一个由 22 个星系组成的银河中。每个星系隶属于一个势力，有一个安全等级，并拥有一到五座空间站。每座空间站都环绕一颗行星运行，各有自己的商店、机库和太空酒吧。星系分布在一张平面星图上，星系之间的航行依靠跃迁门网络。", false],
		[0, "", "已知星系由四个种族占据。[[faction/0|Terran 人]]拥有十个，[[faction/1]] 六个，[[faction/2|Nivelian 人]]四个，[[faction/3|Mido 人]]两个。较小的种族，如 [[faction/4|Multipod]]、[[faction/5|Cyborg]]、[[faction/6|Bobolian]] 和 [[faction/7]]，生活在他们之中，没有自己的领土。[[faction/8|海盗]]在每个星系游荡，而且从一开始就有传言说存在一股名为 [[faction/9|Void]] 的敌对势力。", false],
		[0, "布局", "Nivelian 和 Mido 星系位于星图左上方，围绕着 [[system/15]]、[[system/4]]、[[system/17]] 和 [[system/2]]。Terran 领域横跨星图的中部、右侧和底部，核心是 [[system/19]] 和 [[system/14]]。Vossk 星系在右下方自成一片，从 [[system/3]] 开始，一直延伸到远角的 [[system/21]]。", false],
		[0, "", "跃迁门航线向中心集中。[[system/8]] 拥有六条跃迁门连接，多于其他任何星系；[[system/19]]、[[system/14]]、[[system/3]] 和 [[system/11]] 各连接四到五个星系。位于边缘的星系，如 [[system/4]]、[[system/6]] 和 [[system/21]]，则是只有一条连接的死胡同。", false],
		[0, "航行", "在星系内部，飞船的普通引擎即可将它从一座空间站的轨道送到另一座。要离开星系，飞船需要飞入跃迁门；跃迁门设在星系中的某一座空间站旁，只能到达与之相连的星系。较远的旅程由一连串跃迁门跳跃组成。跃迁引擎是绕过跃迁门网络、直接到达任何已知星系的唯一方法；见 [[guide/navigation]]。", false],
		[33, "", "游戏中唯一的跃迁引擎是 [[item/85]]，由 [[character/20]] 在剧情中设计。它需要按蓝图制造，所需材料之一是 [[item/164]]。", false],
		[0, "安全度", "每个星系的安全等级分为“安全”、“一般”、“有风险”和“危险”。等级决定了你抵达时袭击者在空间站附近埋伏的频率。在“危险”星系，大多数时候都会遇到他们；在“安全”星系则很少见。袭击者通常是海盗，但有时也会是该势力敌对种族的飞船。反过来，越安全的星系，空间站周围的本地巡逻舰也越多。", false],
		[0, "势力与声望", "你的声望记录在两条标尺上：一条在 Terran 人与 Vossk 人之间，另一条在 Nivelian 人与 Mido 人之间。博得其中一方的好感，就会失去另一方的好感。如果你在某个势力中的声望过低，它的飞船会一见到你就发动攻击，它的空间站也会拒绝你。海盗和 Void 始终怀有敌意。太空酒吧中的外交官可以收费帮你修复声望。", false],
		[0, "隐藏星系", "并非所有星系一开始都会出现在星图上。[[system/0]]、[[system/1]]、[[system/10]] 和 [[system/21]] 会一直隐藏，直到你从太空酒吧的代理人那里购买它们的坐标；见 [[guide/lounge]]。另有一个星系 [[system/6]] 不在标准星图上，只有剧情才会揭示它。", false],
		[23, "", "[[system/6]] 的坐标是在 [[step/22]] 中由 [[character/5]] 交给你的。该星系只有一座空间站 [[station/10]]，那是 Deep Science 组织的秘密研究基地。", false],
		[0, "", "有两个星系完全没有跃迁门连接：[[system/15]] 和 [[system/10]]。飞船只有借助跃迁引擎才能进出这两个星系。", false],
		[0, "孤立的起点", "剧情从 [[system/15]] 开始，这是位于星图顶部的一个偏远星系，与银河其他地方没有跃迁门连接。这里贸易贫乏，空间站科技水平低，飞船经销商在剧情前期也不营业。早期离开这个星系的唯一途径，就是剧情提供的那一条。", false],
		[11, "", "[[system/15]] 是 [[faction/3|Mido 邦联]]的大本营。邦联由一群 Terran 和 Nivelian 难民及亡命之徒组成，他们在 Nivelian 内战期间定居于这个新发现的星区。邦联宣布独立。Terran 人接受了这一点；Nivelian 人则仍声称拥有该星系，因此其边缘地带战火不断。", false],
		[15, "", "在 [[step/14]] 中，[[station/79]] 附近的船队瘫痪并逮捕了 [[character/0]]，他随后搭乘一艘 Terran 巡洋舰离开 [[system/15]]，来到位于 Terran 领域深处的 [[system/19]] 星系的 [[station/98]]。", false],
		[9, "时间断层", "[[character/0]] 在 [[system/15]] 醒来时，以为只过去了很短的时间。实际上，受损的超空间引擎把他抛到了银河的另一端，并将他送到了大约 35 年后的未来。他所熟悉的银河已经变了：老朋友们或已衰老，或已离世；与此同时，包括他所在之处在内的一些新星区也已有人定居。", false],
		[10, "", "与他同型的超空间引擎此前就曾因故障引发过类似的时空跳跃。", false],
		[18, "星图之外", "Void 经由某种虫洞进入已知星系。他们对 Terran、Nivelian 和 Vossk 领域一视同仁地发动袭击，目标似乎是矿石。见 [[world/voids]]。", false],
		[25, "", "虫洞通向已知银河之外 Void 自己的星区，那里在星图上没有位置。虫洞会在某座空间站附近开启一段时间，随后坍塌，又在别处出现。", false],
		[34, "", "装上 [[item/85]] 后，飞船也可以直接跃迁进入 Void 星区。", false],
		[32, "", "从 [[step/31]] 起，预警系统会在星图上显示下一个虫洞将在何处开启。", false],
		[42, "", "在 [[step/41]] 中 Void 母舰被摧毁后，整个星区的虫洞纷纷坍塌，袭击随之停止。", false],
	],
	"world/history": [
		[0, "", "银河中生活着多个种族，其中包括 [[faction/0|Terran 人]]、[[faction/2|Nivelian 人]]和 [[faction/1|Vossk 人]]。各空间站之间的宇宙饱受 [[faction/8|海盗]]侵扰。本页概述剧情；每一部分会在你的存档进行到相应位置后显示。", false],
		[0, "第一幕：流落异乡", "Terran 赏金猎人 [[character/0]] 在一片小行星带中消灭了一伙海盗（[[step/0]]）。", false],
		[1, "", "就在他跃迁离开、准备去见老上司 Smith 上将时，最后一发炮弹击伤了他的超空间引擎。飞船载着昏迷的驾驶员漂流到了 [[station/78]]。", false],
		[2, "", "Nivelian 矿石商人 [[character/2]] 打捞起这艘残骸，将飞船据为己有，并让 Keith 替他采矿。", false],
		[8, "", "Keith 帮助 Gunant 摧毁了附近的一处海盗巢穴（[[step/7]]）。", false],
		[9, "", "之后 Keith 得知现在已是 3624 年，而 Smith 上将早已去世。", false],
		[10, "", "超空间引擎故障把 Keith 带到了 35 年后的未来，以及银河的一个偏远角落。Gunant 把飞船 [[ship/0]] 送给他，并让他去 [[station/79]] 找 [[character/3]]。", false],
		[11, "", "[[system/15]] 星系属于 [[faction/3|Mido 邦联]]，它由 Nivelian 内战期间流亡的 Terran 人和 Nivelian 人建立。", false],
		[12, "", "Keith 发现，沉默的空间站 [[station/76]] 全体人员都被毒贩 [[character/4]] 的毒品弄得神志不清（[[step/11]]）。", false],
		[15, "", "一支途经此地的 Terran 船队把 Keith 误认作海盗，瘫痪了他的飞船，并把他押往 [[station/98]]（[[step/14]]）。", false],
		[16, "第二幕：Void 的威胁", "他在那里遇到了老朋友 [[character/1]]，此人如今是安全部门的负责人。恰在此时，[[faction/9|Void]] 袭击了空间站。", false],
		[18, "", "Void 通过虫洞袭击各个星系，以搜寻矿石。Brent 招募 Keith 为 Deep Science 效力，这是一个研究 Void 的秘密科研组织（[[step/17]]）。", false],
		[19, "", "本应带领 Keith 前往研究站的科学家 [[character/5]] 被海盗绑架了。", false],
		[23, "", "Keith 用 EMP 炸弹瘫痪了绑匪的飞船，救出了他，并得到了 [[system/6]] 星系的坐标（[[step/21]]、[[step/22]]）。", false],
		[24, "第三幕：Deep Science", "Keith 在 [[station/10]] 见到了项目负责人 [[character/6]]，开始为 Deep Science 工作。", false],
		[25, "", "Keith 和 Carla 在 [[station/48]] 打捞 Void 残骸，但一个虫洞吞没了他们的飞船（[[step/24]]）。", false],
		[26, "", "他们发现自己身处 Void 的母星区，旁边是一艘巨大的母舰。他们穿过另一个虫洞逃了出来。", false],
		[30, "", "Keith 经由 [[station/91]] 附近的一个虫洞重返 Void 星区，向母舰发射了一枚探测器（[[step/29]]）。", false],
		[32, "", "Brent 交给 Keith 一套预警系统，可以显示 Void 下一次将在何处出击。", false],
		[34, "", "Grey 科学家 [[character/20]] 让 Keith 收集 Void 水晶，用于制造一种新型瞬移引擎，并把它的蓝图交给了他（[[step/33]]）。", false],
		[35, "第四幕：突袭", "探测器显示，虫洞正是由母舰制造的。Brent 和 Carla 计划用一艘满载 Nivelian 炸药的货船摧毁母舰，炸药由 Vossk 指挥官 [[character/7]] 提供。", false],
		[37, "", "Errkt 坚持亲自驾驶货船，而 Keith 赢得了为他护航的资格（[[step/36]]）。", false],
		[39, "", "运送炸药的船队被 Mido 飞船劫走后，Keith 将其夺了回来（[[step/38]]）。", false],
		[42, "", "在 [[character/8]] 率领的援军支持下，Keith 护送 Errkt 穿过虫洞。Errkt 驾驶货船撞向母舰，在这次攻击中牺牲（[[step/41]]）。", false],
		[43, "", "所有虫洞随之坍塌，Void 的袭击就此终结。", false],
		[45, "尾声", "Keith 与 Brent 一同庆祝，终于和 Carla 共度了一夜。第二天早上她便离开，去参加另一个秘密项目，而 Keith 则可以自由地遨游银河。", false],
	],
	"world/khador": [
		[32, "", "Khador 是一位为 Deep Science 工作的 Grey 科学家，他有自己的专页：见 [[character/20]]。", false],
	],
	"world/voids": [
		[0, "", "[[faction/9|Void]] 是剧情中的核心威胁。本页汇集了关于他们的已知信息；随着存档推进，会显示更多内容。", false],
		[2, "最初的传闻", "Keith 最早是从 [[character/2]] 口中听说 Void 的：一种怀有敌意的生物，就连在偏远的 [[system/15]] 星系也时有出没。", false],
		[9, "", "Mido 星系的人们预计，3624 年将作为 Void 之年被载入史册。", false],
		[16, "", "Void 战机袭击了 Terran 领域内的 [[station/98]]（[[step/15]]）。", false],
		[17, "", "袭击期间，Void 广播了一条消息，声称他们是为和平而来，却一刻也没有停火。", false],
		[18, "已知情况", "Void 是在几周前开始出现的。他们经由虫洞进入有人居住的星系，攻击遇到的一切，目标似乎是矿石。就连 [[faction/1]] 的星系也遭到袭击。没有人知道他们从何而来，想要什么。", false],
		[24, "", "在 [[station/48]]，他们宣称自己来自未来，是银河各文明仅存的遗民。", false],
		[26, "母星区", "他们的虫洞通往一个遥远的母星区，那里有一艘巨大的母舰不断放出战机。虫洞只会开启很短的时间，随后坍塌，又在别处重新出现。", false],
		[28, "", "Void 警告说，消灭他们就等于毁掉人类的未来。", false],
		[30, "", "他们一再表示，必须在人类消灭他们、连同人类自己的未来一起毁掉之前，找到沟通的方法。这一说法是否属实，始终没有定论。", false],
		[32, "", "[[character/1]] 的团队研发了一套预警系统，可以预测 Void 将在何处开启下一个虫洞。", false],
		[33, "", "Grey 科学家 [[character/20]] 认为，只有 Void 星区才有的水晶 [[item/164]] 蕴藏着他们虫洞的秘密。", false],
		[35, "袭击的终结", "向母舰发射的探测器表明，母舰就是虫洞的来源。已知的任何武器都无法对它造成损伤。", false],
		[42, "", "一艘由 [[character/7]] 驾驶、满载 Nivelian 核炸药的 Vossk 货船摧毁了母舰（[[step/41]]）。", false],
		[43, "", "此后，整个星区的虫洞纷纷坍塌，Void 的袭击停止了，至少暂时如此。", false],
	],
}
